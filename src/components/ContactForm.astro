---
import forms from '../data/forms.json'

interface Props {
  /** Nagłówek na plakietce nad formularzem */
  badge?: string
}

const { badge = 'Bezpłatna konsultacja' } = Astro.props

const F = forms as Record<string, string | boolean>

/* Endpoint budowany z ustawień CMS (Panel → Ustawienia → Formularz).
   formsubmit  — bez zakładania konta; kod aliasu ukrywa e-mail w HTML
   web3forms   — wymaga access key
   custom      — dowolny URL (Formspree, własny backend) */
function buildEndpoint(): string {
  const provider = String(F.provider || 'formsubmit')
  if (provider === 'custom')    return String(F.customEndpoint || '')
  if (provider === 'web3forms') return 'https://api.web3forms.com/submit'
  const target = String(F.formsubmitCode || F.recipientEmail || '')
  return target ? `https://formsubmit.co/ajax/${target}` : ''
}

const endpoint = buildEndpoint()
const clientCfg = {
  endpoint,
  provider:      String(F.provider || 'formsubmit'),
  web3formsKey:  String(F.web3formsKey || ''),
  subject:       String(F.subject || 'Nowa wiadomość z formularza'),
  buttonLabel:   String(F.buttonLabel || 'Wyślij wiadomość'),
  sendingLabel:  String(F.sendingLabel || 'Wysyłam…'),
  errorMessage:  String(F.errorMessage || 'Nie udało się wysłać wiadomości.'),
}
---

<div class="bento-card p-lg relative">
  <div class="absolute -top-3 -left-3 bg-neon text-on-primary px-3 py-1 text-label-sm font-bold uppercase tracking-widest">
    {badge}
  </div>

  {!endpoint && (
    <p class="mt-md text-label-sm text-on-surface-variant border border-neon/30 bg-neon/5 p-md">
      Formularz nie jest jeszcze skonfigurowany. Ustaw adres e-mail w panelu CMS → Ustawienia → Formularz kontaktowy.
    </p>
  )}

  <!-- ── FORMULARZ ── -->
  <form id="contact-form" class="space-y-md mt-md" novalidate>
    <!-- honeypot: boty wypełniają, ludzie nie widzą -->
    <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true"
           style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
      <div>
        <label class="block text-label-sm text-on-surface-variant uppercase mb-2" for="cf-name">Imię i Nazwisko</label>
        <input id="cf-name" name="name" type="text" required autocomplete="name"
          placeholder="Jan Kowalski"
          class="w-full bg-surface-container border border-outline-variant focus:border-neon text-on-surface p-md text-body-md transition-colors outline-none" />
      </div>
      <div>
        <label class="block text-label-sm text-on-surface-variant uppercase mb-2" for="cf-email">Email</label>
        <input id="cf-email" name="email" type="email" required autocomplete="email"
          placeholder="jan@firma.pl"
          class="w-full bg-surface-container border border-outline-variant focus:border-neon text-on-surface p-md text-body-md transition-colors outline-none" />
      </div>
    </div>

    <div>
      <label class="block text-label-sm text-on-surface-variant uppercase mb-2" for="cf-url">URL Strony</label>
      <input id="cf-url" name="url" type="url" autocomplete="url"
        placeholder="https://twojadomena.pl"
        class="w-full bg-surface-container border border-outline-variant focus:border-neon text-on-surface p-md text-body-md transition-colors outline-none" />
    </div>

    <div>
      <label class="block text-label-sm text-on-surface-variant uppercase mb-2" for="cf-service">Interesuje mnie</label>
      <select id="cf-service" name="service"
        class="w-full bg-surface-container border border-outline-variant focus:border-neon text-on-surface p-md text-body-md transition-colors outline-none">
        <option value="">Wybierz usługę</option>
        <option>Audyt SEO</option>
        <option>Pozycjonowanie stron</option>
        <option>Content Marketing</option>
        <option>Konsultacja strategiczna</option>
        <option>Inny temat</option>
      </select>
    </div>

    <div>
      <label class="block text-label-sm text-on-surface-variant uppercase mb-2" for="cf-message">Wiadomość</label>
      <textarea id="cf-message" name="message" rows="5" required
        placeholder="Opisz swoją sytuację — co Cię boli i czego oczekujesz..."
        class="w-full bg-surface-container border border-outline-variant focus:border-neon text-on-surface p-md text-body-md transition-colors outline-none resize-none"></textarea>
    </div>

    {F.consentEnabled && (
      <label class="flex items-start gap-3 text-label-sm text-on-surface-variant cursor-pointer">
        <input type="checkbox" name="consent" required
               class="mt-0.5 w-4 h-4 shrink-0 accent-current" style="accent-color:rgb(var(--tw-accent))" />
        <span>{F.consentText}</span>
      </label>
    )}

    <p id="cf-error" role="alert"
       class="hidden text-label-sm border border-red-500/40 bg-red-500/10 text-red-300 p-md"></p>

    <button id="cf-submit" type="submit" disabled={!endpoint}
      class="w-full flex items-center justify-center gap-2 bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest py-md hover:brightness-110 active:scale-95 transition-all shadow-neon-sm disabled:opacity-50 disabled:cursor-not-allowed">
      <span aria-hidden="true" class="material-symbols-outlined text-sm">send</span>
      <span id="cf-submit-label">{F.buttonLabel}</span>
    </button>

    <p class="text-label-sm text-center text-on-surface-variant/50 uppercase">
      Odpowiadam na każdą wiadomość w ciągu 24h roboczych
    </p>
  </form>

  <!-- ── PODZIĘKOWANIE (po wysłaniu) ── -->
  <div id="cf-success" class="hidden flex-col items-center text-center py-xl gap-md" role="status" aria-live="polite">
    <div class="w-14 h-14 flex items-center justify-center border-2 border-neon text-neon rounded-full">
      <span aria-hidden="true" class="material-symbols-outlined" style="font-size:30px">check</span>
    </div>
    <h3 class="text-headline-md text-on-surface">{F.successTitle}</h3>
    <p class="text-body-md text-on-surface-variant max-w-sm">{F.successMessage}</p>
  </div>
</div>

<script is:inline define:vars={{ CF: clientCfg }}>
  (function () {
    var form = document.getElementById('contact-form')
    if (!form || !CF.endpoint) return

    var btn     = document.getElementById('cf-submit')
    var btnLbl  = document.getElementById('cf-submit-label')
    var errBox  = document.getElementById('cf-error')
    var okBox   = document.getElementById('cf-success')

    form.addEventListener('submit', async function (e) {
      e.preventDefault()
      errBox.classList.add('hidden')

      if (!form.checkValidity()) { form.reportValidity(); return }

      var fd = new FormData(form)
      if (fd.get('_honey')) return            // bot — cicho odrzuć

      var payload = {}
      fd.forEach(function (v, k) { if (k !== '_honey') payload[k] = v })
      payload._subject = CF.subject
      payload._template = 'table'
      if (CF.provider === 'web3forms') payload.access_key = CF.web3formsKey

      btn.disabled = true
      btnLbl.textContent = CF.sendingLabel

      try {
        var res = await fetch(CF.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        })
        var data = await res.json().catch(function () { return {} })
        var ok = res.ok && (data.success === undefined || data.success === true || data.success === 'true')
        if (!ok) throw new Error(data.message || 'HTTP ' + res.status)

        form.classList.add('hidden')
        okBox.classList.remove('hidden')
        okBox.classList.add('flex')
        okBox.scrollIntoView({ behavior: 'smooth', block: 'center' })
      } catch (err) {
        errBox.textContent = CF.errorMessage
        errBox.classList.remove('hidden')
        btn.disabled = false
        btnLbl.textContent = CF.buttonLabel
      }
    })
  })()
</script>
