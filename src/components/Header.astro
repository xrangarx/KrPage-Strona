---
import { SITE } from '../data/site'

const pathname = new URL(Astro.request.url).pathname

const navLinks = [
  { href: '/',            label: 'Home'         },
  { href: '/o-mnie',      label: 'O mnie'       },
  { href: '/jak-dzialm',  label: 'Jak działam'  },
  { href: '/blog',        label: 'Blog'         },
  { href: '/kontakt',     label: 'Kontakt'      },
]

const uslugiLinks = [
  { href: '/uslugi/audyt-seo',         label: 'Audyt SEO',        icon: 'troubleshoot' },
  { href: '/uslugi/pozycjonowanie',    label: 'Pozycjonowanie',   icon: 'trending_up'  },
  { href: '/uslugi/content-marketing', label: 'Content Marketing',icon: 'article'      },
]

const isUslugiActive = pathname === '/uslugi' || pathname.startsWith('/uslugi/')
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300
         bg-[#050A07]/90 backdrop-blur-md
         border-b border-neon/5
         shadow-[0_0_30px_rgba(45,255,95,0.05)]"
>
  <div class="max-w-7xl mx-auto h-20 flex items-center justify-between px-6 md:px-12">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group" aria-label={SITE.name}>
      <span class="material-symbols-outlined text-neon text-xl leading-none">terminal</span>
      <span class="text-xl font-black tracking-tighter text-neon font-sans">
        KrPage
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Nawigacja główna">

      <!-- Home, O mnie -->
      {[navLinks[0], navLinks[1]].map(link => {
        const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href))
        return (
          <a href={link.href} class:list={[
            'text-label-md uppercase tracking-widest transition-colors duration-200',
            isActive ? 'text-neon border-b-2 border-neon pb-0.5' : 'text-on-surface-variant hover:text-neon',
          ]}>
            {link.label}
          </a>
        )
      })}

      <!-- Usługi dropdown -->
      <div class="relative group/uslugi">
        <div class="flex items-center gap-0.5">
          <a
            href="/uslugi"
            class:list={[
              'text-label-md uppercase tracking-widest transition-colors duration-200',
              isUslugiActive
                ? 'text-neon border-b-2 border-neon pb-0.5'
                : 'text-on-surface-variant hover:text-neon',
            ]}
          >
            Usługi
          </a>
          <span class="material-symbols-outlined text-base leading-none transition-transform duration-200 group-hover/uslugi:rotate-180 text-on-surface-variant cursor-default select-none ml-0.5">
            expand_more
          </span>
        </div>

        <!-- Dropdown panel -->
        <div
          id="uslugi-dropdown"
          class="absolute top-full left-1/2 -translate-x-1/2 mt-3
                 min-w-[220px] bg-[#050A07] border border-neon/20
                 shadow-[0_8px_32px_rgba(45,255,95,0.1)]
                 opacity-0 invisible translate-y-2
                 group-hover/uslugi:opacity-100 group-hover/uslugi:visible group-hover/uslugi:translate-y-0
                 transition-all duration-200 ease-out"
        >
          <!-- Top accent line -->
          <div class="h-px bg-gradient-to-r from-transparent via-neon to-transparent"></div>

          <ul class="py-2">
            {uslugiLinks.map((link, i) => {
              const isActive = pathname === link.href
              return (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      'flex items-center gap-3 px-4 py-2.5 text-label-sm uppercase tracking-wider transition-colors duration-150',
                      isActive
                        ? 'text-neon bg-neon/5'
                        : 'text-on-surface-variant hover:text-neon hover:bg-neon/5',
                    ]}
                  >
                    <span class="material-symbols-outlined text-sm text-neon/60">{link.icon}</span>
                    {link.label}
                  </a>
                </li>
              )
            })}
          </ul>
        </div>
      </div>

      <!-- Jak działam, Blog, Kontakt -->
      {[navLinks[2], navLinks[3], navLinks[4]].map(link => {
        const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href))
        return (
          <a href={link.href} class:list={[
            'text-label-md uppercase tracking-widest transition-colors duration-200',
            isActive ? 'text-neon border-b-2 border-neon pb-0.5' : 'text-on-surface-variant hover:text-neon',
          ]}>
            {link.label}
          </a>
        )
      })}

    </nav>

    <!-- CTA -->
    <div class="flex items-center gap-4">
      <a
        href="/kontakt"
        class="hidden md:inline-flex items-center gap-2
               bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest
               px-6 py-2.5
               hover:brightness-110 active:scale-95 transition-all duration-200
               shadow-neon-sm"
      >
        <span class="material-symbols-outlined text-sm leading-none">troubleshoot</span>
        Bezpłatny audyt
      </a>

      <!-- Mobile hamburger -->
      <button
        id="menu-toggle"
        class="md:hidden text-neon"
        aria-label="Otwórz menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="material-symbols-outlined text-2xl">menu</span>
      </button>
    </div>

  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="md:hidden hidden flex-col gap-0 px-6 pb-6 bg-[#050A07]"
    aria-label="Nawigacja mobilna"
  >

    {[navLinks[0], navLinks[1]].map(link => {
      const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href))
      return (
        <a
          href={link.href}
          class:list={[
            'block py-3 text-label-md uppercase tracking-widest border-b border-neon/5 transition-colors',
            isActive ? 'text-neon' : 'text-on-surface-variant hover:text-neon',
          ]}
        >
          {link.label}
        </a>
      )
    })}

    <!-- Usługi accordion -->
    <div>
      <div class:list={[
        'flex items-center justify-between border-b border-neon/5',
        isUslugiActive ? 'text-neon' : 'text-on-surface-variant',
      ]}>
        <a
          href="/uslugi"
          class:list={[
            'flex-1 py-3 text-label-md uppercase tracking-widest transition-colors',
            isUslugiActive ? 'text-neon' : 'text-on-surface-variant hover:text-neon',
          ]}
        >
          Usługi
        </a>
        <button
          id="uslugi-toggle"
          class="py-3 px-1 text-on-surface-variant"
          aria-expanded={String(isUslugiActive)}
          aria-controls="uslugi-mobile"
          aria-label="Rozwiń podmenu Usługi"
        >
          <span id="uslugi-chevron" class:list={[
            'material-symbols-outlined text-base transition-transform duration-200',
            isUslugiActive ? 'rotate-180' : '',
          ]}>
            expand_more
          </span>
        </button>
      </div>

      <div
        id="uslugi-mobile"
        class:list={[
          'overflow-hidden transition-all duration-300',
          isUslugiActive ? '' : 'hidden',
        ]}
      >
        {uslugiLinks.map((link, i) => {
          const isActive = pathname === link.href
          return (
            <a
              href={link.href}
              class:list={[
                'flex items-center gap-3 pl-4 py-2.5 text-label-sm uppercase tracking-wider border-b border-neon/5 transition-colors',
                i === 0 ? 'border-t border-neon/10 mt-1' : '',
                isActive
                  ? 'text-neon'
                  : 'text-on-surface-variant hover:text-neon',
              ]}
            >
              <span class="material-symbols-outlined text-sm text-neon/50">{link.icon}</span>
              {link.label}
            </a>
          )
        })}
      </div>
    </div>

    {[navLinks[2], navLinks[3], navLinks[4]].map(link => {
      const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href))
      return (
        <a
          href={link.href}
          class:list={[
            'block py-3 text-label-md uppercase tracking-widest border-b border-neon/5 transition-colors',
            isActive ? 'text-neon' : 'text-on-surface-variant hover:text-neon',
          ]}
        >
          {link.label}
        </a>
      )
    })}

    <a
      href="/kontakt"
      class="mt-4 flex items-center justify-center gap-2
             bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest
             px-6 py-3 shadow-neon-sm"
    >
      Bezpłatny audyt
    </a>
  </nav>
</header>

<script>
  // Hamburger toggle
  const toggle = document.getElementById('menu-toggle')
  const menu   = document.getElementById('mobile-menu')
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false
    toggle.setAttribute('aria-expanded', String(open))
    const icon = toggle.querySelector('.material-symbols-outlined')
    if (icon) icon.textContent = open ? 'close' : 'menu'
  })

  // Mobile Usługi accordion
  const uslugiToggle  = document.getElementById('uslugi-toggle')
  const uslugiMobile  = document.getElementById('uslugi-mobile')
  const uslugiChevron = document.getElementById('uslugi-chevron')
  uslugiToggle?.addEventListener('click', () => {
    const open = uslugiMobile?.classList.toggle('hidden') === false
    uslugiToggle.setAttribute('aria-expanded', String(open))
    uslugiChevron?.classList.toggle('rotate-180', open)
  })
</script>
