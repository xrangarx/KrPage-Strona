---
import { SITE } from '../data/site'

interface Props {
  type: 'home' | 'webpage' | 'service' | 'blogpost'
  title?: string
  description?: string
  canonicalUrl?: string
  // service
  serviceName?: string
  // blogpost
  datePublished?: string
  dateModified?: string
  ogImage?: string
  keywords?: string[]
  articleType?: string
}

const {
  type,
  title,
  description,
  canonicalUrl,
  serviceName,
  datePublished,
  dateModified,
  ogImage,
  keywords,
  articleType,
} = Astro.props

const pageUrl = canonicalUrl ?? new URL(Astro.url.pathname, SITE.url).href

const organization = {
  '@type': 'LocalBusiness',
  name: SITE.name,
  url: SITE.url,
  telephone: SITE.phone,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
  sameAs: [SITE.social.linkedin, SITE.social.facebook],
}

const schemas: object[] = []

if (type === 'home') {
  schemas.push({ '@context': 'https://schema.org', ...organization })
}

if (type === 'webpage' || type === 'service' || type === 'blogpost') {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: pageUrl,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  })
}

if (type === 'service') {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: serviceName ?? title,
    provider: organization,
    description,
    areaServed: 'PL',
    url: pageUrl,
  })
}

if (type === 'blogpost') {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': articleType ?? 'BlogPosting',
    headline: title,
    description,
    author: { '@type': 'Person', name: SITE.author, url: SITE.url },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      logo: { '@type': 'ImageObject', url: new URL(SITE.logo, SITE.url).href },
    },
    datePublished: datePublished,
    dateModified: dateModified ?? datePublished,
    image: ogImage ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE.url).href) : undefined,
    keywords: keywords?.join(', '),
    url: pageUrl,
    inLanguage: 'pl-PL',
    isPartOf: { '@type': 'Blog', name: `${SITE.name} Blog`, url: `${SITE.url}/blog` },
  })
}
---

{schemas.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema, null, 0)} />
))}
