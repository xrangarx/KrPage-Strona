---
import SEO from '../components/SEO.astro'
import Schema from '../components/Schema.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'
import { SITE } from '../data/site'
import tracking from '../data/tracking.json'

interface Props {
  title: string
  description: string
  ogImage?: string
  ogTitle?: string
  ogDescription?: string
  noIndex?: boolean
  canonicalUrl?: string
  schemaType?: 'home' | 'webpage' | 'service' | 'blogpost'
  schemaProps?: Record<string, unknown>
}

const {
  title,
  description,
  ogImage,
  ogTitle,
  ogDescription,
  noIndex,
  canonicalUrl,
  schemaType = 'webpage',
  schemaProps = {},
} = Astro.props
---

<!doctype html>
<html lang="pl" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />

    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      noIndex={noIndex}
      canonicalUrl={canonicalUrl}
    />

    <Schema
      type={schemaType}
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      {...schemaProps}
    />

    <!-- Weryfikacja właściwości (z tracking.json) -->
    {tracking.gsc  && <meta name="google-site-verification" content={tracking.gsc} />}
    {tracking.bing && <meta name="msvalidate.01" content={tracking.bing} />}

    <!-- Google Analytics 4 -->
    {tracking.ga && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${tracking.ga}`}></script>
        <script define:vars={{ gaId: tracking.ga }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- Microsoft Clarity -->
    {tracking.clarity && (
      <script define:vars={{ clarityId: tracking.clarity }}>
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window,document,"clarity","script",clarityId);
      </script>
    )}

    <!-- dodatkowe tagi w <head> (np. JSON-LD FAQ, breadcrumbs) -->
    <slot name="head" />
  </head>

  <body class="font-sans text-on-surface min-h-dvh flex flex-col">
    <Header />
    <main class="flex-1 pt-20">
      <slot />
    </main>
    <Footer />
  </body>
</html>
