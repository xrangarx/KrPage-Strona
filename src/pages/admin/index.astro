/* ══════════════════════════════════════════
   POSTS LIST
══════════════════════════════════════════ */
async function loadPosts() {
  var grid = document.getElementById('posts-grid')
  var loading = document.getElementById('posts-loading')
  loading.style.display = 'flex'
  grid.innerHTML = ''
  try {
    var files = await ghList(BLOG)
    var mdFiles = files.filter(function(f){ return f.name.endsWith('.md') })
    if (!mdFiles.length) {
      loading.style.display='none'
      grid.innerHTML='<p style="color:var(--muted)">Brak wpisów blogowych.</p>'
      return
    }
    // Load all posts in parallel
    var posts = await Promise.all(mdFiles.map(function(f){
      return ghGet(f.path).then(function(r){ return Object.assign(r,{name:f.name}) })
    }))
    posts.sort(function(a,b){
      var da=parseMd(a.content).date||''; var db=parseMd(b.content).date||''
      return db.localeCompare(da)
    })
    loading.style.display = 'none'
    posts.forEach(function(post){
      var fm = parseMd(post.content)
      var card = document.createElement('div')
      card.className = 'post-card'
      card.innerHTML =
        '<div class="post-info">'+
          '<div class="post-title">'+(fm.title||post.name)+'</div>'+
          '<div class="post-meta">'+
            '<span class="cat-badge">'+(fm.category||'—')+'</span>'+
            '<span class="meta-text">'+(fm.date||'—')+'</span>'+
            '<span class="meta-text">'+(fm.readTime||'—')+'</span>'+
          '</div>'+
        '</div>'+
        '<button class="btn btn-secondary" style="font-size:11px;padding:6px 12px">'+
          '<span class="material-symbols-outlined" style="font-size:13px">edit</span>Edytuj'+
        '</button>'
      card.querySelector('button').addEventListener('click', function(){ editPost(post) })
      grid.appendChild(card)
    })
  } catch(e) {
    loading.innerHTML = '<span style="color:var(--danger)">Błąd: '+e.message+'</span>'
  }
}

