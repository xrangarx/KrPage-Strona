<script is:inline>
/* ══════════════════════════════════════════════════════════════════════
   ██████╗ ██████╗ ███╗   ██╗███████╗██╗ ██████╗
  ██╔════╝██╔═══██╗████╗  ██║██╔════╝██║██╔════╝
  ██║     ██║   ██║██╔██╗ ██║█████╗  ██║██║  ███╗
  ██║     ██║   ██║██║╚██╗██║██╔══╝  ██║██║   ██║
  ╚██████╗╚██████╔╝██║ ╚████║██║     ██║╚██████╔╝
   ╚═════╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝     ╚═╝ ╚═════╝

  Aby użyć tego panelu dla INNEGO projektu, zmień tylko CONFIG poniżej.
  Pozostały kod jest w pełni generyczny.
══════════════════════════════════════════════════════════════════════ */

var CONFIG = {
  /* ── Repozytorium GitHub ── */
  owner:  'xrangarx',
  repo:   'KrPage-Strona',
  branch: 'main',

  /* ── Dane strony ── */
  siteName: 'KrPage',
  siteUrl:  'https://krpage.pl',

  /* ── Folder na zdjęcia (względem public/) ── */
  imgRoot: 'public/images',

  /* ── Kolekcje treści ──────────────────────────────────────────────
     Każda kolekcja to folder z plikami Markdown.
     Pola: name (klucz w frontmatter), label, type:
       string  — krótki tekst
       text    — długi tekst (textarea)
       date    — data (YYYY-MM-DD)
       select  — lista wyboru, wymaga: options: [...]
       image   — URL zdjęcia + picker z galerii
       tags    — lista tagów oddzielona przecinkami
     Pole "body" (treść Markdown) jest zawsze dodawane automatycznie.
  ── */
  collections: [
    {
      id:     'blog',
      label:  'Wpisy bloga',
      icon:   'article',
      folder: 'src/content/blog',
      fields: [
        { name:'title',       label:'Tytuł',          type:'string', required:true },
        { name:'description', label:'Opis SEO (meta description)', type:'text', required:true },
        { name:'date',        label:'Data publikacji', type:'date'  },
        { name:'category',    label:'Kategoria',       type:'select',
          options:['Tech SEO','Strategia','Content','Link Building','Local SEO'] },
        { name:'image',       label:'Zdjęcie okładkowe', type:'image' },
        { name:'readTime',    label:'Czas czytania',   type:'string', placeholder:'np. 8 min' },

        { type:'section', label:'SEO & OpenGraph', icon:'travel_explore' },
        { name:'og_title',        label:'OG Title (opcjonalnie — inny niż tytuł)', type:'string',
          placeholder:'Krótszy, bardziej klikalny tytuł dla social media' },
        { name:'og_description',  label:'OG Description (opcjonalnie)',             type:'text',
          placeholder:'Opis dla podglądu w social media, może różnić się od meta desc' },
        { name:'canonical',       label:'Canonical URL (opcjonalnie)',               type:'string',
          placeholder:'https://krpage.pl/blog/slug — wypełnij tylko jeśli inny niż bieżący URL' },
        { name:'focus_keyphrase', label:'Focus Keyphrase',                           type:'string',
          placeholder:'np. pozycjonowanie lokalne Kraków' },
        { name:'tags',            label:'Tagi / słowa kluczowe (przecinkami)',       type:'tags',
          placeholder:'np. SEO, pozycjonowanie, Google' },
        { name:'date_modified',   label:'Data modyfikacji (opcjonalnie)',            type:'date' },

        { type:'section', label:'Indeksowanie', icon:'visibility' },
        { name:'noindex', label:'Noindex — wyklucz z indeksu Google', type:'checkbox' },

