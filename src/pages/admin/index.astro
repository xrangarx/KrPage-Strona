/* ─ wire all color pickers ─ */
function wireColorPickers(){
  LAY_COLOR_FIELDS.forEach(function(fid){
    var picker=qs('#cp-'+fid), hex=qs('#'+fid)
    if(!picker||!hex) return
    picker.addEventListener('input',function(){ hex.value=this.value })
    hex.addEventListener('input',function(){
      var v=this.value.trim()
      if(/^#[0-9a-fA-F]{6}$/.test(v)){ try{ picker.value=v }catch(e){} }
    })
  })
}

