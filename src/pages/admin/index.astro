  currentView='list-'+col.id
  setActiveNav(col.id)
  hideAllViews()
  show(qs('#view-list'))
  show(qs('#new-btn'))
  qs('#toolbar-title').textContent=col.label
  qs('#new-btn').onclick=function(){openEditor(col,null)}
  await loadList(col)
}

async function loadList(col){
  var grid=qs('#list-grid')
  var load=qs('#list-loading')
  grid.innerHTML=''
  show(load)
  try{
    var files=await ghList(col.folder)
    var mds=files.filter(function(f){return f.name.endsWith('.md')})
    var cnt=qs('#cnt-'+col.id)
    if(cnt) cnt.textContent=mds.length

    if(!mds.length){
      hide(load)
      grid.innerHTML='<div class="list-empty">Brak wpisów. Utwórz pierwszy.</div>'
      return
    }
    var posts=await Promise.all(mds.map(function(f){
      return ghGet(f.path).then(function(r){return Object.assign(r,{name:f.name})})
    }))
    posts.sort(function(a,b){
      var da=parseFM(a.content).fm.date||'', db=parseFM(b.content).fm.date||''
      return db.localeCompare(da)
    })
    hide(load)
    posts.forEach(function(post){
      var p=parseFM(post.content)
      var fm=p.fm
      var card=document.createElement('div')
      card.className='doc-card fade'
      var imgSrc=fm.image||'https://placehold.co/56x40/111224/404dff?text=IMG'
      var badge=fm.category||fm.type||fm.industry||''
      var meta=fm.date||''
      var sub=fm.readTime||fm.result||''
      card.innerHTML=
        '<div class="doc-thumb"><img src="'+imgSrc+'" alt="" onerror="this.src=\'https://placehold.co/56x40/111224/404dff?text=IMG\'"/></div>'+
        '<div class="doc-info">'+
          '<div class="doc-title">'+(fm.title||post.name)+'</div>'+
          '<div class="doc-meta">'+
            (badge?'<span class="badge">'+badge+'</span>':'')+
            (meta?'<span class="meta-date">'+meta+'</span>':'')+
            (sub?'<span class="meta-date">'+sub+'</span>':'')+
          '</div>'+
        '</div>'+
        '<button class="doc-del-btn" title="Usuń wpis" tabindex="-1">'+
          '<span class="material-symbols-outlined" style="font-size:16px">delete</span>'+
        '</button>'+
        '<span class="material-symbols-outlined doc-arrow">chevron_right</span>'
      card.querySelector('.doc-del-btn').addEventListener('click', async function(e){
        e.stopPropagation()
        var title=fm.title||post.name
        if(!confirm('Usunąć "'+title+'" z repozytorium?\n\nTej operacji nie można cofnąć.')) return
        this.disabled=true
        this.innerHTML='<span class="material-symbols-outlined spin" style="font-size:15px">refresh</span>'
        try{
          await ghDelete(post.path, post.sha, 'delete: '+post.name)
          card.style.transition='opacity .2s'
          card.style.opacity='0'
          setTimeout(function(){ card.remove(); var c=qs('#cnt-'+col.id); if(c) c.textContent=parseInt(c.textContent||0)-1 }, 200)
          toast('✓ "'+title+'" usunięty','ok')
        } catch(err){
          toast('❌ '+err.message,'err')
          this.disabled=false
          this.innerHTML='<span class="material-symbols-outlined" style="font-size:16px">delete</span>'
        }
      })
      card.addEventListener('click',function(){openEditor(col,post)})
      grid.appendChild(card)
    })
  }catch(e){
    hide(load)
    grid.innerHTML='<div class="list-empty" style="color:var(--err)">Błąd: '+e.message+'</div>'
  }
}

/* ══ EDITOR ══ */
function openEditor(col, post){
  currentCol=col
  editingFile=post?{path:post.path,sha:post.sha}:null
  currentView='editor'
  hideAllViews()
  show(qs('#view-editor'))
  show(qs('#back-btn'))
  show(qs('#save-btn'))
  qs('#back-btn').onclick=function(){switchToList(col)}
  qs('#toolbar-title').textContent=post?'Edycja — '+(parseFM(post.content).fm.title||post.name):'Nowy wpis'
  qs('#save-label').textContent=post?'Zapisz zmiany':'Opublikuj'
  qs('#toolbar-status').textContent=''
  renderForm(col, post)
}

function renderForm(col, post){
  var fm={}, body=''
  if(post){ var p=parseFM(post.content); fm=p.fm; body=p.body }

  var slugVal=post?post.name.replace('.md',''):''

  function buildFieldHtml(f){
    var val=fm[f.name]!==undefined?fm[f.name]:''
    if(Array.isArray(val)) val=val.join(', ')
    else if(typeof val==='string'&&val.trim().startsWith('[')){
      try{ var arr=JSON.parse(val); if(Array.isArray(arr)) val=arr.join(', ') }catch(e){}
    }
    var req=f.required?'<span class="req">*</span>':''
    var fh='<div class="field"><label class="field-label" for="ff-'+f.name+'">'+f.label+req+'</label>'
    if(f.type==='string'){
      fh+='<input class="inp" id="ff-'+f.name+'" data-field="'+f.name+'" value="'+esc(val)+'" placeholder="'+(f.placeholder||'')+'" />'
    } else if(f.type==='text'){
      fh+='<textarea class="ta" id="ff-'+f.name+'" data-field="'+f.name+'" rows="2">'+esc(val)+'</textarea>'
    } else if(f.type==='date'){
      fh+='<input class="inp" type="date" id="ff-'+f.name+'" data-field="'+f.name+'" value="'+esc(val||today())+'" />'
    } else if(f.type==='select'){
      var opts=f.options.map(function(o){
        return '<option value="'+esc(o)+'"'+(val===o?' selected':'')+'>'+o+'</option>'
      }).join('')
      fh+='<select class="sel" id="ff-'+f.name+'" data-field="'+f.name+'"><option value="">Wybierz…</option>'+opts+'</select>'
    } else if(f.type==='image'){
      fh+=
        '<div class="inp-row">'+
          '<input class="inp" id="ff-'+f.name+'" data-field="'+f.name+'" value="'+esc(val)+'" placeholder="/images/... lub https://..." />'+
          '<button class="btn btn-ghost btn-sm" type="button" data-picker-target="ff-'+f.name+'" style="padding:0 12px;flex-shrink:0">'+
            '<span class="material-symbols-outlined" style="font-size:15px">photo_library</span>Galeria'+
          '</button>'+
        '</div>'+
        (val?'<img class="img-field-prev" id="fimg-'+f.name+'" src="'+esc(val)+'" alt="" onerror="this.style.display=\'none\'" />':
             '<img class="img-field-prev" id="fimg-'+f.name+'" src="" alt="" style="display:none" />')
    } else if(f.type==='tags'){
      fh+='<input class="inp" id="ff-'+f.name+'" data-field="'+f.name+'" value="'+esc(val)+'" placeholder="'+(f.placeholder||'tag1, tag2, tag3')+'" />'
    } else if(f.type==='checkbox'){
      var checked=(val===true||val==='true')
      fh='<div class="field" style="flex-direction:row;align-items:center;gap:10px">'+
         '<input type="checkbox" id="ff-'+f.name+'" data-field="'+f.name+'" data-type="checkbox"'+(checked?' checked':'')+
         ' style="width:16px;height:16px;accent-color:var(--accent);flex-shrink:0;cursor:pointer" />'+
         '<label class="field-label" for="ff-'+f.name+'" style="margin:0;cursor:pointer">'+f.label+req+'</label>'
    }
    return fh+'</div>'
  }

  function layoutGroup(fields){
    var items=fields.map(function(f){ return {f:f,html:buildFieldHtml(f)} })
    var rows='<div class="form-grid g2" style="margin-bottom:0">'
    var i=0
    while(i<items.length){
      var cur=items[i]
      var isWide=cur.f.type==='text'||cur.f.type==='image'||cur.f.type==='tags'
      if(isWide){
        rows+='</div><div class="form-grid g2" style="margin-bottom:12px"><div style="grid-column:1/-1">'+cur.html+'</div></div><div class="form-grid g2" style="margin-bottom:0">'
      } else {
        rows+=cur.html
      }
      i++
    }
    return rows+'</div>'
  }

  // Split fields into groups at 'section' boundaries
  var groups=[], curGroup={label:null,fields:[]}
  col.fields.forEach(function(f){
    if(f.type==='section'){
      groups.push(curGroup)
      curGroup={label:f.label, icon:f.icon||'tune', fields:[]}
    } else {
      curGroup.fields.push(f)
    }
  })
  groups.push(curGroup)

  var html='<div class="form-grid g2" style="margin-bottom:12px">'+
    '<div class="field"><label class="field-label" for="f-slug">Slug (URL pliku)</label>'+
    '<input class="inp" id="f-slug" value="'+esc(slugVal)+'" placeholder="np. audyt-seo-2025" /></div>'+
    '<div></div></div>'+
    '<div class="serp-wrap" id="serp-wrap">'+
      '<div class="serp-label">Podgląd w Google</div>'+
      '<div class="serp-url" id="serp-url">'+esc(CONFIG.siteUrl)+'/...</div>'+
      '<div class="serp-title" id="serp-title">Tytuł wpisu</div>'+
      '<div class="serp-desc"  id="serp-desc">Opis meta...</div>'+
      '<div class="serp-counters">'+
        '<div class="serp-cnt">'+
          '<span>Tytuł</span>'+
          '<div class="serp-cnt-bar"><div class="serp-cnt-fill" id="serp-bar-t" style="width:0%;background:var(--ok)"></div></div>'+
          '<span id="serp-cnt-t" style="font-variant-numeric:tabular-nums">0/60</span>'+
        '</div>'+
        '<div class="serp-cnt">'+
          '<span>Opis</span>'+
          '<div class="serp-cnt-bar"><div class="serp-cnt-fill" id="serp-bar-d" style="width:0%;background:var(--ok)"></div></div>'+
          '<span id="serp-cnt-d" style="font-variant-numeric:tabular-nums">0/155</span>'+
        '</div>'+
      '</div>'+
    '</div>'

  groups.forEach(function(g){
    if(!g.fields.length) return
    if(g.label){
      html+=
        '<div class="field-section">'+
          '<div class="field-section-hdr" onclick="this.parentElement.classList.toggle(\'open\')">'+
            '<span class="material-symbols-outlined sec-chev">chevron_right</span>'+
            '<span class="material-symbols-outlined" style="font-size:15px;opacity:.5">'+g.icon+'</span>'+
            g.label+
          '</div>'+
          '<div class="field-section-body">'+layoutGroup(g.fields)+'</div>'+
        '</div>'
    } else {
      html+=layoutGroup(g.fields)
    }
  })

  qs('#form-fields').innerHTML=html
  qs('#md-editor').value=body
  updatePreview()

  // auto-slug from title
  var titleInp=qs('#ff-title')
  if(titleInp&&!editingFile){
    titleInp.addEventListener('input',function(){
      qs('#f-slug').value=slugify(this.value)
      updateSerp()
    })
  }

  // ── SERP live preview ──
  function updateSerp(){
    var rawTitle = (qs('#ff-og_title')||{}).value || (qs('#ff-title')||{}).value || ''
    var rawDesc  = (qs('#ff-og_description')||{}).value || (qs('#ff-description')||{}).value || ''
    var slug     = (qs('#f-slug')||{}).value || ''
    var colPath  = currentCol ? (currentCol.id==='blog' ? '/blog/' : '/') : '/'
    var url      = CONFIG.siteUrl + colPath + slug

    var titleEl  = qs('#serp-title')
    var descEl   = qs('#serp-desc')
    var urlEl    = qs('#serp-url')
    var cntT     = qs('#serp-cnt-t')
    var cntD     = qs('#serp-cnt-d')
    var barT     = qs('#serp-bar-t')
    var barD     = qs('#serp-bar-d')
    if(!titleEl) return

    var tLen = rawTitle.length, dLen = rawDesc.length
    var tPct = Math.min(100, Math.round(tLen/60*100))
    var dPct = Math.min(100, Math.round(dLen/155*100))
    var tCol = tLen > 60 ? 'var(--err)' : tLen > 45 ? 'var(--warn)' : 'var(--ok)'
    var dCol = dLen > 155 ? 'var(--err)' : dLen > 130 ? 'var(--warn)' : 'var(--ok)'

    titleEl.textContent = rawTitle || '—'
    titleEl.className   = 'serp-title' + (tLen > 60 ? ' over' : '')
    descEl.textContent  = rawDesc  || '—'
    descEl.className    = 'serp-desc'  + (dLen > 155 ? ' over' : '')
    urlEl.textContent   = url
    cntT.textContent    = tLen + '/60'
    cntD.textContent    = dLen + '/155'
    barT.style.width    = tPct + '%'
    barT.style.background = tCol
    barD.style.width    = dPct + '%'
    barD.style.background = dCol
  }

  // Wire listeners for all SERP-relevant inputs
  ;['ff-title','ff-og_title','ff-description','ff-og_description','f-slug'].forEach(function(id){
    var el=qs('#'+id)
    if(el) el.addEventListener('input', updateSerp)
  })
  updateSerp()

  // image picker buttons + live preview
  qsa('[data-picker-target]').forEach(function(btn){
    btn.addEventListener('click',function(){
      var target=btn.dataset.pickerTarget
      openPicker(function(url){
        var el=qs('#'+target)
        if(!el) return
        el.value=url
        var fname=target.replace('ff-','')
        var prev=qs('#fimg-'+fname)
        if(prev){prev.src=url;prev.style.display='block'}
        toast('✅ Wybrano: '+url.split('/').pop())
      })
    })
  })
  // live preview on manual URL input
  qsa('.img-field-prev').forEach(function(img){
    var fname=img.id.replace('fimg-','')
    var inp=qs('#ff-'+fname)
    if(inp) inp.addEventListener('input',function(){
      var u=this.value.trim()
      if(u){img.src=u;img.style.display='block'}else img.style.display='none'
    })
  })
}

function esc(s){
  if(s===undefined||s===null) return ''
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')
}

/* ══ SAVE ══ */
qs('#save-btn').addEventListener('click', async function(){
  var col=currentCol
  var slug=qs('#f-slug').value.trim()
  var values={}
  col.fields.forEach(function(f){
    var el=qs('#ff-'+f.name)
    if(!el) return
    if(f.type==='checkbox') values[f.name]=el.checked
    else values[f.name]=el.value.trim()
  })
  var body=qs('#md-editor').value.trim()

  // validate required
  var missing=[]
  col.fields.filter(function(f){return f.required}).forEach(function(f){
    if(!values[f.name]) missing.push(f.label)
  })
  if(!body) missing.push('Treść')
  if(missing.length){ toast('⚠ Uzupełnij: '+missing.join(', '),'warn'); return }

  if(!slug) slug=slugify(values.title||'wpis')
  var path=editingFile?editingFile.path:col.folder+'/'+slug+'.md'
  var sha=editingFile?editingFile.sha:null
  var content=buildFM(col,values,body)
  var msg=(editingFile?'update':'add')+': '+slug+'.md'

  var statusEl=qs('#toolbar-status')
  this.disabled=true
  qs('#save-label').textContent='Publikuję…'
  statusEl.textContent=''
  statusEl.className='toolbar-status'
  try{
    var res=await ghPut(path,content,sha,msg)
    toast('✅ '+(editingFile?'Zaktualizowano':'Opublikowano')+'!','ok')
    statusEl.textContent='✅ Live za ~60 s'
    statusEl.className='toolbar-status ok'
    if(!editingFile){
      editingFile={path:path,sha:res.content.sha}
      qs('#save-label').textContent='Zapisz zmiany'
    } else {
      editingFile.sha=res.content.sha
    }
    // update count
    var cnt=qs('#cnt-'+col.id)
    if(cnt&&!sha) cnt.textContent=parseInt(cnt.textContent||'0',10)+1
  }catch(e){
    toast('❌ '+e.message,'err')
    statusEl.textContent='❌ '+e.message
    statusEl.className='toolbar-status err'
  }finally{
    this.disabled=false
    qs('#save-label').textContent=editingFile?'Zapisz zmiany':'Opublikuj'
  }
})

