<!-- is:inline prevents Astro from treating this as ESM module — functions stay global -->
<script is:inline>
/* ══════════════════════════════════════════
   CONFIG
══════════════════════════════════════════ */
var OWNER  = 'xrangarx'
var REPO   = 'KrPage-Strona'
var BRANCH = 'main'
var BLOG   = 'src/content/blog'
var REAL   = 'src/content/realizacje'
var IMG_BLOG = 'public/images/blog'
var IMG_SITE = 'public/images'

var token = ''
var editingFile = null  // {path, sha}
var currentImgFolder = 'blog'

/* ══════════════════════════════════════════
   UTILS
══════════════════════════════════════════ */
function b64enc(str) {
  var bytes = new TextEncoder().encode(str)
  var bin = ''
  bytes.forEach(function(b){ bin += String.fromCharCode(b) })
  return btoa(bin)
}
function b64dec(b64) {
  var bin = atob(b64.replace(/\s/g,''))
  var bytes = new Uint8Array(bin.length)
  for (var i=0;i<bin.length;i++) bytes[i]=bin.charCodeAt(i)
  return new TextDecoder().decode(bytes)
}
function slugify(s) {
  return s.toLowerCase()
    .replace(/ą/g,'a').replace(/ć/g,'c').replace(/ę/g,'e').replace(/ł/g,'l')
    .replace(/ń/g,'n').replace(/ó/g,'o').replace(/ś/g,'s')
    .replace(/ź/g,'z').replace(/ż/g,'z')
    .replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-').slice(0,60)
}
function today() {
  return new Date().toISOString().slice(0,10)
}
function toast(msg, type) {
  var t = document.getElementById('toast')
  t.textContent = msg
  t.className = type||''
  t.style.display = 'flex'
  clearTimeout(t._timer)
  t._timer = setTimeout(function(){ t.style.display='none' }, 3500)
}
function qs(sel){ return document.querySelector(sel) }
function qsa(sel){ return document.querySelectorAll(sel) }

/* ══════════════════════════════════════════
   GITHUB API
══════════════════════════════════════════ */
function ghHeaders(extra) {
  return Object.assign({ Authorization:'token '+token, Accept:'application/vnd.github+json' }, extra||{})
}
function ghUrl(path) {
  return 'https://api.github.com/repos/'+OWNER+'/'+REPO+'/contents/'+path
}

async function ghList(path) {
  var r = await fetch(ghUrl(path), { headers: ghHeaders() })
  if (r.status===404) return []
  if (!r.ok) { var d=await r.json(); throw new Error(d.message||'HTTP '+r.status) }
  return r.json()
}
async function ghGet(path) {
  var r = await fetch(ghUrl(path), { headers: ghHeaders() })
  if (!r.ok) { var d=await r.json(); throw new Error(d.message||'HTTP '+r.status) }
  var d = await r.json()
  return { content: b64dec(d.content), sha: d.sha, path: d.path, rawB64: d.content.replace(/\s/g,'') }
}
async function ghPut(path, content, sha, msg) {
  var body = { message: msg, content: b64enc(content), branch: BRANCH }
  if (sha) body.sha = sha
  var r = await fetch(ghUrl(path), {
    method:'PUT', headers: ghHeaders({'Content-Type':'application/json'}),
    body: JSON.stringify(body)
  })
  var d = await r.json()
  if (!r.ok) throw new Error(d.message||'HTTP '+r.status)
  return d
}
async function ghPutBin(path, rawB64, sha, msg) {
  var body = { message: msg, content: rawB64, branch: BRANCH }
  if (sha) body.sha = sha
  var r = await fetch(ghUrl(path), {
    method:'PUT', headers: ghHeaders({'Content-Type':'application/json'}),
    body: JSON.stringify(body)
  })
  var d = await r.json()
  if (!r.ok) throw new Error(d.message||'HTTP '+r.status)
  return d
}
async function ghDelete(path, sha, msg) {
  var r = await fetch(ghUrl(path), {
    method:'DELETE', headers: ghHeaders({'Content-Type':'application/json'}),
    body: JSON.stringify({ message: msg, sha: sha, branch: BRANCH })
  })
  if (!r.ok) { var d=await r.json(); throw new Error(d.message||'HTTP '+r.status) }
}

/* ══════════════════════════════════════════
   FRONTMATTER
══════════════════════════════════════════ */
function buildMd(f) {
  var img = f.image || ('https://placehold.co/800x450/050A07/2DFF5F?text='+encodeURIComponent(f.category))
  return '---\ntitle: "'+f.title.replace(/"/g,'\\"')+'"\ndescription: "'+f.description.replace(/"/g,'\\"')+'"\ndate: "'+f.date+'"\ncategory: "'+f.category+'"\nimage: "'+img+'"\nreadTime: "'+f.readTime+'"\n---\n\n'+f.body
}
function parseMd(raw) {
  var m = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/)
  if (!m) return { body: raw }
  var fm = {}
  m[1].split('\n').forEach(function(line){
    var idx = line.indexOf(':')
    if (idx<0) return
    fm[line.slice(0,idx).trim()] = line.slice(idx+1).trim().replace(/^"(.*)"$/,'$1')
  })
  fm.body = m[2].trim()
  return fm
}

