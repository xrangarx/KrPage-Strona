var pickerFolder     = 'images/blog'

/* ── UI shortcuts ── */
function qs(s){ return document.querySelector(s) }
function qsa(s){ return document.querySelectorAll(s) }
function show(el){ if(el) el.classList.remove('hidden') }
function hide(el){ if(el) el.classList.add('hidden') }

/* ── Init login UI from CONFIG ── */
qs('#brand-name').textContent  = CONFIG.siteName + ' Admin'
qs('#sb-name').textContent     = CONFIG.siteName + ' Admin'
qs('#warn-repo').textContent   = CONFIG.repo
