/* ══ MD TOOLBAR ══ */
function mdInsert(type){
  var ed=qs('#md-editor')
  var s=ed.selectionStart, e=ed.selectionEnd
  var sel=ed.value.slice(s,e)
  var before=ed.value.slice(0,s), after=ed.value.slice(e)
  var ins='', selS=-1, selE=-1

  function nl(){ return (before===''||before.endsWith('\n'))?'':'\n' }
  function commit(){
    ed.value=before+ins+after
    ed.focus()
    if(selS>=0) ed.setSelectionRange(selS,selE)
    else ed.setSelectionRange(s+ins.length,s+ins.length)
    updatePreview()
  }

  if(type==='bold'){
    ins='**'+(sel||'pogrubiony tekst')+'**'
    if(!sel){selS=s+2;selE=s+ins.length-2}
    commit()
  } else if(type==='italic'){
    ins='*'+(sel||'kursywa')+'*'
    if(!sel){selS=s+1;selE=s+ins.length-1}
    commit()
  } else if(type==='strike'){
    ins='~~'+(sel||'przekreślony tekst')+'~~'
    if(!sel){selS=s+2;selE=s+ins.length-2}
    commit()
  } else if(type==='ul'){
    ins=nl()+'- '+(sel||'element')+'\n'; commit()
  } else if(type==='ol'){
    ins=nl()+'1. '+(sel||'element')+'\n'; commit()
  } else if(type==='quote'){
    ins=nl()+'> '+(sel||'cytat')+'\n'; commit()
  } else if(type==='hr'){
    ins=nl()+'\n---\n\n'; commit()
  } else if(type==='indent'){
    var lines=(sel||'').split('\n')
    ins=nl()+lines.map(function(l){return '  '+l}).join('\n')+'\n'; commit()
  } else if(type==='outdent'){
    var lines2=(sel||'').split('\n')
    ins=nl()+lines2.map(function(l){return l.startsWith('  ')?l.slice(2):l}).join('\n')+'\n'; commit()
  } else if(type==='align-left'){
    ins=nl()+'<div style="text-align:left">\n\n'+(sel||'Tekst')+'\n\n</div>\n'; commit()
  } else if(type==='align-center'){
    ins=nl()+'<div style="text-align:center">\n\n'+(sel||'Tekst wyśrodkowany')+'\n\n</div>\n'; commit()
  } else if(type==='align-right'){
    ins=nl()+'<div style="text-align:right">\n\n'+(sel||'Tekst')+'\n\n</div>\n'; commit()
  } else if(type==='link'){
    var url=prompt('URL linku:','https://')
    if(!url) return
    ins='['+(sel||'tekst linku')+']('+url+')'; commit()
  } else if(type==='btn'){
    var burl=prompt('URL przycisku:','https://')
    if(!burl) return
    var btxt=prompt('Tekst przycisku:',sel||'Dowiedz się więcej')||'Kliknij tutaj'
    ins=nl()+'<a href="'+burl+'" class="btn-content">'+btxt+'</a>\n'; commit()
  } else if(type==='image'){
    var savedS=s, savedE=e
    openPicker(function(url){
      var alt=prompt('Alt text (opis zdjęcia dla SEO):')||''
      var cap=prompt('Podpis pod zdjęciem (opcjonalnie):')||''
      var ins2=nl()+'!['+alt+']('+url+')'+(cap?'\n*'+cap+'*':'')+'\n'
      ed.value=ed.value.slice(0,savedS)+ins2+ed.value.slice(savedE)
      ed.focus();ed.setSelectionRange(savedS+ins2.length,savedS+ins2.length)
      updatePreview()
    })
  }
}

/* Format selector (heading / paragraph) */
qs('#md-format-sel').addEventListener('change',function(){
  var ed=qs('#md-editor')
  var s=ed.selectionStart, e=ed.selectionEnd
  var sel=ed.value.slice(s,e)||'Tekst'
  var before=ed.value.slice(0,s), after=ed.value.slice(e)
  var val=this.value; if(!val){this.selectedIndex=0;return}
  var nl=(before===''||before.endsWith('\n'))?'':'\n'
  var ins=val==='p'? (nl+sel+'\n') : (nl+'#'.repeat(parseInt(val.replace('h','')))+' '+sel+'\n')
  ed.value=before+ins+after
  ed.focus();ed.setSelectionRange(s+ins.length,s+ins.length)
  updatePreview()
  this.selectedIndex=0
})

