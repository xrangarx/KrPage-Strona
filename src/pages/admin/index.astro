---
// Standalone admin — no BaseLayout, noindex
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Panel CMS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/marked@9.1.6/marked.min.js"></script>
  <style is:global>
    /* ── RESET ── */
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html,body{height:100%}

    /* ── TOKENS ── */
    :root{
      --sidebar:   #090a18;
      --sidebar2:  #0d0e1f;
      --bg:        #0d0e1c;
      --bg2:       #111224;
      --bg3:       #161729;
      --bg4:       #20213a;
      --border:    rgba(64,77,255,0.14);
      --border2:   rgba(64,77,255,0.08);
      --accent:    #404dff;
      --accent10:  rgba(64,77,255,0.10);
      --accent20:  rgba(64,77,255,0.20);
      --accent30:  rgba(64,77,255,0.30);
      --text:      #e2e1ff;
      --text2:     #c4c3e0;
      --muted:     #7f7f9c;
      --ok:        #3fcf77;
      --err:       #ff4d6d;
      --warn:      #ffc800;
      --ok10:      rgba(63,207,119,0.10);
      --err10:     rgba(255,77,109,0.10);
    }

    body{
      font-family:'Manrope',system-ui,sans-serif;
      background:var(--bg);
      color:var(--text);
      font-size:14px;
      line-height:1.5;
      -webkit-font-smoothing:antialiased;
    }

    .hidden{display:none!important}
    .material-symbols-outlined{
      font-family:'Material Symbols Outlined';font-style:normal;font-weight:400;
      font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;
      vertical-align:middle;line-height:1;font-size:18px;
      display:inline-block;white-space:nowrap;word-wrap:normal;direction:ltr;
      -webkit-font-feature-settings:'liga';-webkit-font-smoothing:antialiased;
    }
    @keyframes spin{to{transform:rotate(360deg)}}
    .spin{animation:spin .8s linear infinite;display:inline-block}
    @keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
    .fade{animation:fadeIn .18s ease}

    /* ── LOGIN ── */
    #login-screen{
      min-height:100vh;display:flex;align-items:center;justify-content:center;
      background:var(--bg);
    }
    .login-card{
      width:100%;max-width:420px;
      background:var(--bg2);border:1px solid var(--border);
      padding:40px 36px;
    }
    .login-brand{display:flex;align-items:center;gap:10px;margin-bottom:6px}
    .login-brand-icon{
      width:36px;height:36px;background:var(--accent10);border:1px solid var(--accent30);
      display:flex;align-items:center;justify-content:center;
    }
    .login-brand-name{font-size:18px;font-weight:800;color:var(--text)}
    .login-sub{font-size:13px;color:var(--muted);margin-bottom:28px}
    .login-warn{
      background:rgba(255,200,0,0.06);border:1px solid rgba(255,200,0,0.25);
      color:var(--warn);font-size:12px;padding:10px 14px;margin-bottom:20px;line-height:1.6;
    }
    .login-warn strong{display:block;margin-bottom:2px;font-size:11px;letter-spacing:.04em;text-transform:uppercase}
    .login-warn code{font-family:monospace;font-size:11px;opacity:.85}

    /* ── BUTTONS ── */
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:6px;
      font-family:'Manrope',sans-serif;font-size:13px;font-weight:700;
      letter-spacing:.04em;padding:9px 18px;border:none;cursor:pointer;
      transition:all .15s;text-decoration:none;white-space:nowrap;
    }
    .btn-primary{background:var(--accent);color:#fff}
    .btn-primary:hover:not(:disabled){filter:brightness(1.15)}
    .btn-primary:disabled{opacity:.5;cursor:not-allowed}
    .btn-ghost{background:transparent;color:var(--muted);border:1px solid transparent;padding:7px 12px}
    .btn-ghost:hover{border-color:var(--border);color:var(--text)}
    .btn-danger{background:transparent;color:var(--err);border:1px solid rgba(255,77,109,.2);padding:6px 12px}
    .btn-danger:hover{background:var(--err10);border-color:rgba(255,77,109,.4)}
    .btn-sm{font-size:11px;padding:5px 10px}
    .btn-full{width:100%}

    /* ── INPUTS ── */
    .field{display:flex;flex-direction:column;gap:5px}
    .field-label{
      font-size:11px;font-weight:700;text-transform:uppercase;
      letter-spacing:.07em;color:var(--muted)
    }
    .field-label .req{color:var(--accent);margin-left:2px}
    .inp,.sel,.ta{
      width:100%;padding:9px 12px;
      background:var(--bg3);border:1px solid var(--border2);
      color:var(--text);font-family:'Manrope',sans-serif;font-size:13px;
      outline:none;transition:border-color .15s;
    }
    .inp:focus,.sel:focus,.ta:focus{border-color:var(--accent30)}
    .inp::placeholder{color:var(--muted)}
    .sel option{background:var(--bg2)}
    .ta{resize:vertical;min-height:68px;line-height:1.55}
    .inp-row{display:flex;gap:8px;align-items:stretch}
    .inp-row .inp{flex:1}

    /* ── APP SHELL ── */
    #app{display:flex;height:100vh;overflow:hidden}

    /* ── SIDEBAR ── */
    #sidebar{
      width:220px;min-width:220px;
      background:var(--sidebar);border-right:1px solid var(--border2);
      display:flex;flex-direction:column;overflow:hidden;
    }
    .sidebar-head{
      padding:20px 16px 16px;border-bottom:1px solid var(--border2);
      display:flex;align-items:center;gap:10px;
    }
    .sidebar-icon{
      width:30px;height:30px;background:var(--accent10);border:1px solid var(--accent30);
      display:flex;align-items:center;justify-content:center;flex-shrink:0;
    }
    .sidebar-name{font-size:15px;font-weight:800;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .sidebar-body{flex:1;overflow-y:auto;padding:12px 8px}
    .sidebar-section{
      font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;
      color:var(--muted);padding:4px 8px 6px;
    }
    .nav-item{
      display:flex;align-items:center;gap:9px;width:100%;
      padding:8px 10px;background:transparent;border:none;
      color:var(--text2);font-family:'Manrope',sans-serif;font-size:13px;font-weight:600;
      cursor:pointer;transition:all .12s;text-align:left;
    }
    .nav-item:hover{background:var(--bg3);color:var(--text)}
    .nav-item.active{background:var(--accent10);color:var(--accent)}
    .nav-item .material-symbols-outlined{font-size:16px}
    .nav-count{
      margin-left:auto;font-size:10px;font-weight:700;
      background:var(--bg3);color:var(--muted);
      padding:1px 6px;min-width:20px;text-align:center;
    }
    .nav-item.active .nav-count{background:var(--accent20);color:var(--accent)}
    .sidebar-sep{height:1px;background:var(--border2);margin:8px 8px}
    .sidebar-foot{padding:10px 8px;border-top:1px solid var(--border2)}

    /* ── MAIN ── */
    #main{flex:1;display:flex;flex-direction:column;overflow:hidden}

    /* ── TOOLBAR ── */
    .toolbar{
      height:52px;min-height:52px;
      display:flex;align-items:center;gap:10px;padding:0 24px;
      background:var(--bg);border-bottom:1px solid var(--border2);
    }
    .toolbar-title{font-size:15px;font-weight:700;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .toolbar-status{font-size:12px;font-weight:600}
    .toolbar-status.ok{color:var(--ok)}
    .toolbar-status.err{color:var(--err)}

    /* ── VIEW ── */
    .view{flex:1;overflow-y:auto;padding:24px}

    /* ── LIST VIEW ── */
    .list-empty{color:var(--muted);font-size:14px;padding:24px 0;display:flex;align-items:center;gap:8px}
    .doc-card{
      display:flex!important;flex-direction:row!important;align-items:center;gap:14px;
      background:var(--bg2);border:1px solid var(--border2);
      padding:12px 16px;margin-bottom:6px;
      cursor:pointer;transition:border-color .12s,background .12s;
    }
    .doc-card:hover{border-color:var(--accent30);background:var(--bg3)}
    .doc-thumb{
      width:60px!important;min-width:60px!important;max-width:60px!important;
      height:42px!important;background:var(--bg3);
      flex-shrink:0;overflow:hidden;
    }
    .doc-thumb img{
      width:60px!important;height:42px!important;
      object-fit:cover;display:block;
    }
    .doc-info{flex:1;min-width:0}
    .doc-title{font-size:14px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:4px}
    .doc-meta{display:flex!important;flex-direction:row!important;align-items:center;gap:8px;flex-wrap:wrap}
    .badge{
      display:inline-block;padding:2px 8px;
      font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;
      border:1px solid var(--accent30);color:var(--accent);
      white-space:nowrap;
    }
    .badge-muted{border-color:var(--border);color:var(--muted)}
    .meta-date{font-size:11px;color:var(--muted);white-space:nowrap}
    .doc-arrow{color:var(--muted);font-size:16px;margin-left:auto;flex-shrink:0}

    /* ── EDITOR VIEW ── */
    #view-editor{display:flex;flex-direction:column;height:100%;overflow:hidden}
    /* editor-scroll: pass-through flex column (no own scrolling/padding) */
    .editor-scroll{flex:1;display:flex;flex-direction:column;overflow:hidden;padding:0}
    /* form-fields: scrollable panel, starts collapsed */
    #form-fields{overflow-y:auto;padding:16px 24px;max-height:55vh;flex-shrink:0;border-bottom:1px solid var(--border2)}
    #form-fields.meta-collapsed{display:none}
    /* markdown content area: fills remaining height */
    #md-content-field{flex:1;display:flex;flex-direction:column;overflow:hidden;gap:0!important;margin:0!important}
    .form-grid{display:grid;gap:12px}
    .g2{grid-template-columns:1fr 1fr}
    .g3{grid-template-columns:1fr 1fr 1fr}
    @media(max-width:800px){.g2,.g3{grid-template-columns:1fr}}
    .md-split{
      display:grid;grid-template-columns:1fr 1fr;gap:0;
      border-top:1px solid var(--border);flex:1;min-height:0;
    }
    .md-pane{display:flex;flex-direction:column;overflow:hidden}
    .md-pane+.md-pane{border-left:1px solid var(--border)}
    .pane-label{
      padding:6px 14px;border-bottom:1px solid var(--border);
      font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);
      background:var(--bg2);
    }
    #md-editor{
      flex:1;padding:14px;background:var(--bg3);
      border:none;color:var(--text);
      font-family:'Courier New',monospace;font-size:13px;line-height:1.7;
      resize:none;outline:none;
    }
    #md-preview{
      flex:1;padding:16px;overflow-y:auto;background:var(--bg2);
      font-size:13px;line-height:1.75;color:var(--text2);
    }
    #md-preview h1,#md-preview h2,#md-preview h3{color:var(--text);font-weight:700;margin:1em 0 .35em}
    #md-preview h2{font-size:1.15em}
    #md-preview h3{font-size:1.05em}
    #md-preview p{margin-bottom:.65em}
    #md-preview strong{color:var(--text)}
    #md-preview a{color:var(--accent)}
    #md-preview code{background:var(--bg3);padding:1px 5px;font-size:.85em;color:var(--accent);font-family:monospace}
    #md-preview ul,#md-preview ol{padding-left:1.5em;margin-bottom:.65em}
    #md-preview blockquote{border-left:3px solid var(--accent30);padding-left:12px;color:var(--muted);font-style:italic}
    @media(max-width:800px){.md-split{grid-template-columns:1fr} .md-pane+.md-pane{display:none}}

    /* ── IMAGES ── */
    .img-subtabs{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:20px}
    .img-subtab{
      padding:8px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
      color:var(--muted);font-family:'Manrope',sans-serif;font-size:12px;font-weight:700;
      cursor:pointer;text-transform:uppercase;letter-spacing:.06em;transition:all .12s;margin-bottom:-1px;
    }
    .img-subtab.active{color:var(--accent);border-bottom-color:var(--accent)}
    .upload-zone{
      border:2px dashed var(--border);padding:36px 24px;text-align:center;
      cursor:pointer;transition:all .15s;margin-bottom:16px;
    }
    .upload-zone:hover,.upload-zone.drag{border-color:var(--accent30);background:var(--accent10)}
    .upload-zone .ms{font-size:32px;color:var(--muted);display:block;margin-bottom:8px}
    .upload-zone p{color:var(--muted);font-size:13px}
    .upload-zone p.strong{color:var(--text);font-weight:700;margin-bottom:3px}
    .webp-row{display:flex;align-items:center;gap:8px;margin-bottom:16px;font-size:13px;color:var(--text2)}
    .webp-row input{accent-color:var(--accent);cursor:pointer}
    #upload-log{margin-bottom:12px}
    .log-item{display:flex;align-items:center;gap:10px;padding:7px 12px;background:var(--bg2);border:1px solid var(--border);margin-bottom:5px;font-size:12px}
    .log-item .url{font-family:monospace;font-size:11px;color:var(--accent);margin-left:auto;white-space:nowrap}
    .imgs-count{font-size:12px;color:var(--muted);margin-bottom:12px}
    .imgs-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(152px,1fr));gap:8px}
    .img-card{background:var(--bg2);border:1px solid var(--border);overflow:hidden}
    .img-card img{width:100%;height:100px;object-fit:cover;display:block}
    .img-info{padding:7px 9px}
    .img-name{font-size:10px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:5px}
    .img-actions{display:flex;gap:4px}
    .img-btn{
      flex:1;display:flex;align-items:center;justify-content:center;gap:3px;
      padding:4px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;
      cursor:pointer;border:1px solid var(--border);background:transparent;color:var(--muted);transition:all .12s;
    }
    .img-btn:hover{border-color:var(--accent30);color:var(--accent)}
    .img-btn.copy{color:var(--accent);border-color:var(--accent30)}

    /* ── MD TOOLBAR ── */
    .md-toolbar{background:var(--bg2);border-bottom:1px solid var(--border);display:flex;flex-direction:column}
    .md-toolbar-row{display:flex;gap:1px;padding:3px 8px;align-items:center;flex-wrap:wrap}
    .md-toolbar-row+.md-toolbar-row{border-top:1px solid var(--border2)}
    .md-tb-btn{
      display:flex;align-items:center;justify-content:center;gap:2px;
      padding:3px 7px;background:transparent;border:1px solid transparent;
      color:var(--muted);cursor:pointer;font-family:'Manrope',sans-serif;
      font-size:11px;font-weight:700;letter-spacing:.02em;transition:all .12s;
    }
    .md-tb-btn:hover,.md-tb-btn:focus{border-color:var(--accent30);color:var(--accent);background:var(--accent10);outline:none}
    .md-tb-sep{width:1px;background:var(--border);height:14px;margin:0 3px;flex-shrink:0}
    .md-tb-select{
      background:var(--bg3);border:1px solid var(--border2);color:var(--text2);
      font-family:'Manrope',sans-serif;font-size:11px;font-weight:700;
      padding:2px 6px;cursor:pointer;outline:none;height:24px;
    }
    .md-tb-select:focus{border-color:var(--accent30)}
    .md-color-wrap{position:relative;display:inline-flex;align-items:center}
    .md-color-palette{
      position:absolute;top:calc(100% + 3px);left:0;z-index:9500;
      background:var(--bg2);border:1px solid var(--border);
      padding:5px;display:none;flex-wrap:wrap;gap:3px;width:114px;
    }
    .md-color-palette.open{display:flex}
    .md-color-swatch{
      width:15px;height:15px;cursor:pointer;flex-shrink:0;
      border:2px solid transparent;transition:border-color .1s;
    }
    .md-color-swatch:hover{border-color:var(--text)}
    #md-color-input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}

    /* ── META TOGGLE (collapsible fields) ── */
    .meta-toggle{
      display:flex;align-items:center;gap:8px;padding:9px 16px;
      background:var(--bg2);border-bottom:1px solid var(--border2);
      cursor:pointer;font-size:11px;font-weight:700;color:var(--muted);
      text-transform:uppercase;letter-spacing:.07em;user-select:none;
    }
    .meta-toggle:hover{color:var(--text2);background:var(--bg3)}
    .meta-toggle .material-symbols-outlined{font-size:15px;transition:transform .2s}
    #form-fields.meta-collapsed{display:none}

    /* ── IMG FIELD PREVIEW ── */
    .img-field-prev{margin-top:6px;max-width:220px;max-height:130px;object-fit:contain;border:1px solid var(--border);background:var(--bg3);display:block}

    /* ── LIGHTBOX ── */
    #lightbox{
      position:fixed;inset:0;background:rgba(0,0,0,.94);z-index:9200;
      display:none;flex-direction:column;align-items:center;justify-content:center;cursor:zoom-out;padding:20px;
    }
    #lightbox.open{display:flex}
    #lightbox-img-el{max-width:92vw;max-height:88vh;object-fit:contain;display:block;cursor:default}
    #lightbox-cap{color:var(--text2);font-size:11px;margin-top:10px;opacity:.6}

    /* ── IMG EDIT MODAL ── */
    #img-edit-modal{
      position:fixed;inset:0;background:rgba(9,10,24,.92);z-index:9100;
      display:none;align-items:center;justify-content:center;padding:20px;
    }
    #img-edit-modal.open{display:flex}
    .img-edit-inner{background:var(--bg2);border:1px solid var(--border);width:100%;max-width:520px;display:flex;flex-direction:column}
    .img-edit-head{
      display:flex;align-items:center;padding:12px 16px;border-bottom:1px solid var(--border);
      font-size:14px;font-weight:700;color:var(--accent);gap:8px;
    }
    #img-edit-prev{width:100%;height:190px;object-fit:contain;background:var(--bg3);border-bottom:1px solid var(--border);display:block}
    .img-edit-body{padding:16px;display:flex;flex-direction:column;gap:14px}
    .img-edit-row{display:flex;gap:8px;align-items:flex-end}
    .img-edit-row .field{flex:1}

    /* ── IMG PICKER MODAL ── */
    #picker-modal{
      position:fixed;inset:0;background:rgba(9,10,24,.9);z-index:9000;
      display:none;align-items:center;justify-content:center;padding:20px;
    }
    #picker-modal.open{display:flex}
    .picker-inner{
      background:var(--bg2);border:1px solid var(--border);
      width:100%;max-width:780px;max-height:82vh;display:flex;flex-direction:column;
    }
    .picker-head{
      display:flex;align-items:center;padding:12px 16px;border-bottom:1px solid var(--border);
      font-size:14px;font-weight:700;color:var(--accent);gap:8px;
    }
    .picker-tabs{display:flex;gap:0;padding:0 16px;border-bottom:1px solid var(--border)}
    .picker-tab{
      padding:8px 16px;background:transparent;border:none;border-bottom:2px solid transparent;
      color:var(--muted);font-family:'Manrope',sans-serif;font-size:11px;font-weight:700;
      cursor:pointer;text-transform:uppercase;letter-spacing:.06em;margin-bottom:-1px;transition:all .12s;
    }
    .picker-tab.active{color:var(--accent);border-bottom-color:var(--accent)}
    .picker-body{flex:1;overflow-y:auto;padding:14px;display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px}
    .picker-card{background:var(--bg3);border:2px solid transparent;cursor:pointer;transition:all .12s}
    .picker-card:hover{border-color:var(--accent30)}
    .picker-card img{width:100%;height:85px;object-fit:cover;display:block}
    .picker-card-name{padding:4px 7px;font-size:9px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

    /* ── TOAST ── */
    #toast{
      position:fixed;bottom:20px;right:20px;z-index:9999;
      background:var(--bg2);border:1px solid var(--accent30);color:var(--accent);
      padding:10px 16px;font-size:13px;font-weight:600;display:none;align-items:center;gap:8px;
      box-shadow:0 0 24px rgba(64,77,255,.12);
    }
    #toast.err{border-color:rgba(255,77,109,.4);color:var(--err)}
    #toast.ok-t{border-color:rgba(63,207,119,.4);color:var(--ok)}
  </style>
</head>
<body>

<!-- ═══════════════════════════════════ LOGIN ═══ -->
<section id="login-screen">
  <div class="login-card">
    <div class="login-brand">
      <div class="login-brand-icon"><span class="material-symbols-outlined" style="color:var(--accent);font-size:16px">terminal</span></div>
      <span class="login-brand-name" id="brand-name">Panel CMS</span>
    </div>
    <p class="login-sub" id="login-sub">Panel zarządzania treściami — GitHub Pages.</p>

    <div class="login-warn">
      <strong>Wymagany Personal Access Token</strong>
      GitHub → Settings → Developer settings → Personal access tokens → Fine-grained →
