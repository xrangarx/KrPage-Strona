/* WebP conversion */
function toWebP(file, quality) {
  return new Promise(function(resolve){
    var img = new Image()
    var url = URL.createObjectURL(file)
    img.onload = function(){
      var c = document.createElement('canvas')
      c.width = img.naturalWidth; c.height = img.naturalHeight
      c.getContext('2d').drawImage(img,0,0)
      c.toBlob(function(blob){ URL.revokeObjectURL(url); resolve(blob) }, 'image/webp', quality||0.85)
    }
    img.onerror = function(){ URL.revokeObjectURL(url); resolve(file) }
    img.src = url
  })
}
function blobToB64(blob) {
  return new Promise(function(resolve){
    var r = new FileReader()
    r.onload = function(e){ resolve(e.target.result.split(',')[1]) }
    r.readAsDataURL(blob)
  })
}

var uploadZone = document.getElementById('upload-zone')
var fileInput  = document.getElementById('file-input')
uploadZone.addEventListener('click', function(){ fileInput.click() })
uploadZone.addEventListener('dragover', function(e){ e.preventDefault(); this.classList.add('dragover') })
uploadZone.addEventListener('dragleave', function(){ this.classList.remove('dragover') })
uploadZone.addEventListener('drop', function(e){ e.preventDefault(); this.classList.remove('dragover'); handleFiles(e.dataTransfer.files) })
fileInput.addEventListener('change', function(){ handleFiles(this.files) })

async function handleFiles(files) {
  var progress = document.getElementById('upload-progress')
  progress.innerHTML = ''
  var convertWebP = document.getElementById('webp-toggle').checked
  var destFolder = currentImgFolder==='blog' ? IMG_BLOG : IMG_SITE

  for (var i=0; i<files.length; i++) {
    var file = files[i]
    if (file.size > 5*1024*1024) { toast('❌ '+file.name+': za duży plik (max 5MB)', 'err'); continue }
    var item = document.createElement('div')
    item.className = 'prog-item'
    item.innerHTML = '<span class="material-symbols-outlined spin" style="font-size:15px">progress_activity</span>'+
      '<span>'+file.name+'</span><span class="prog-ok">Konwertowanie...</span>'
    progress.appendChild(item)
    try {
      var blob = file
      var ext  = file.name.replace(/.*\./,'').toLowerCase()
      var baseName = file.name.replace(/\.[^.]+$/,'')
      if (convertWebP && ext !== 'webp') {
        blob = await toWebP(file, 0.85)
        ext = 'webp'
      }
      var b64  = await blobToB64(blob)
      var filename = Date.now()+'-'+slugify(baseName)+'.'+ext
      var path = destFolder+'/'+filename
      var url  = '/'+path.replace('public/','')
      item.querySelector('.prog-ok').textContent = 'Wgrywanie...'
      // Check if exists
      var sha = null
      try { var ex = await ghGet(path); sha = ex.sha } catch{}
      await ghPutBin(path, b64, sha, 'upload: '+filename)
      item.querySelector('.spin').remove()
      item.querySelector('.prog-ok').textContent = '✅ OK'
      var urlEl = document.createElement('span')
      urlEl.className = 'prog-url'
      urlEl.textContent = url
      item.appendChild(urlEl)
      var cpBtn = document.createElement('button')
      cpBtn.className = 'btn btn-ghost'
      cpBtn.style.cssText = 'font-size:10px;padding:3px 8px;margin-left:4px'
      cpBtn.textContent = 'Kopiuj URL'
      cpBtn.onclick = function(u){ return function(){ copyUrl(u, this) } }(url)
      item.appendChild(cpBtn)
    } catch(e) {
      if (item.querySelector('.spin')) item.querySelector('.spin').remove()
      var errEl = item.querySelector('.prog-ok')
      errEl.className = 'prog-err'
      var msg = e.message.includes('Requires authentication')
        ? '❌ Brak uprawnień zapisu — token musi mieć "Contents: Read & write"'
        : '❌ '+e.message
      errEl.textContent = msg
    }
  }
  fileInput.value = ''
  loadImages()
}

async function loadImages() {
  var grid  = document.getElementById('images-grid')
  var count = document.getElementById('images-count')
  grid.innerHTML = ''
  count.textContent = ''
  var folder = currentImgFolder==='blog' ? IMG_BLOG : IMG_SITE
  try {
    var files = await ghList(folder)
    var imgs = files.filter(function(f){
      return /\.(jpg|jpeg|png|webp|gif|svg)$/i.test(f.name)
    })
    // For site folder, exclude blog subfolder entries
    if (currentImgFolder==='site') {
      imgs = imgs.filter(function(f){ return f.type==='file' })
    }
    count.textContent = imgs.length+' zdjęć w /'+folder.replace('public/','')
    if (!imgs.length) {
      grid.innerHTML = '<p style="color:var(--muted);font-size:13px">Brak zdjęć w tym folderze.</p>'
      return
    }
    imgs.reverse().forEach(function(f){
      var url = '/'+f.path.replace('public/','')
      var card = document.createElement('div')
      card.className = 'image-card'
      card.dataset.path = f.path
      card.dataset.sha  = f.sha
      card.dataset.url  = url
      card.dataset.name = f.name
      card.innerHTML =
        '<img src="'+url+'" alt="'+f.name+'" loading="lazy" onerror="this.src=\'https://placehold.co/160x110/0D1410/2DFF5F?text=IMG\'" />'+
        '<div class="image-card-info">'+
          '<div class="image-card-name">'+f.name+'</div>'+
          '<div class="image-card-actions">'+
            '<button class="img-btn copy" data-action="copy">'+
              '<span class="material-symbols-outlined" style="font-size:11px">content_copy</span>URL'+
            '</button>'+
            '<button class="img-btn" data-action="rename">'+
              '<span class="material-symbols-outlined" style="font-size:11px">edit</span>Zmień'+
            '</button>'+
          '</div>'+
        '</div>'+
        '<div class="rename-input-wrap" id="ri-'+f.sha.slice(0,8)+'">'+
          '<input type="text" value="'+f.name+'" placeholder="nowa-nazwa.webp" />'+
          '<div class="rename-actions">'+
            '<button class="rename-confirm" data-sha="'+f.sha.slice(0,8)+'">✓ Zmień</button>'+
            '<button class="rename-cancel" data-sha="'+f.sha.slice(0,8)+'">✗</button>'+
          '</div>'+
        '</div>'
      // events
      card.querySelector('[data-action="copy"]').addEventListener('click', function(){
        copyUrl(card.dataset.url, this)
      })
      card.querySelector('[data-action="rename"]').addEventListener('click', function(){
        var wrap = card.querySelector('.rename-input-wrap')
        wrap.classList.toggle('active')
        if (wrap.classList.contains('active')) wrap.querySelector('input').focus()
      })
      card.querySelector('.rename-confirm').addEventListener('click', function(){
        var newName = card.querySelector('.rename-input-wrap input').value.trim()
        if (!newName) return
        renameImage(card.dataset.path, card.dataset.sha, newName, card.dataset.url)
      })
      card.querySelector('.rename-cancel').addEventListener('click', function(){
        card.querySelector('.rename-input-wrap').classList.remove('active')
      })
      grid.appendChild(card)
    })
  } catch(e) {
    grid.innerHTML = '<p style="color:var(--danger);font-size:13px">Błąd: '+e.message+'</p>'
  }
}

function copyUrl(url, btn) {
  navigator.clipboard.writeText(url).then(function(){
    var orig = btn.innerHTML
    btn.textContent = '✅ Skopiowano'
    setTimeout(function(){ btn.innerHTML = orig }, 1500)
  })
}

async function renameImage(oldPath, sha, newName, oldUrl) {
  // Ensure extension
  if (!newName.includes('.')) newName += '.webp'
  var dir = oldPath.substring(0, oldPath.lastIndexOf('/'))
  var newPath = dir+'/'+newName
  var newUrl  = '/'+newPath.replace('public/','')
  if (newPath === oldPath) return

  toast('↻ Zmieniam nazwę i aktualizuję linki...', 'warn')
  try {
    // 1. Get raw binary
    var fileData = await ghGet(oldPath)
    // 2. Create new file
    await ghPutBin(newPath, fileData.rawB64, null, 'rename: '+newPath)
    // 3. Update refs in all .md files
    var updated = 0
    var allMd = []
    try { allMd = allMd.concat(await ghList(BLOG)) } catch{}
    try { allMd = allMd.concat(await ghList(REAL)) } catch{}
    allMd = allMd.filter(function(f){ return f.name.endsWith('.md') })
    for (var i=0; i<allMd.length; i++) {
      var md = await ghGet(allMd[i].path)
      if (md.content.indexOf(oldUrl) >= 0) {
        var fixed = md.content.split(oldUrl).join(newUrl)
        await ghPut(md.path, fixed, md.sha, 'update ref: '+newName)
        updated++
      }
    }
    // 4. Delete old file
    await ghDelete(oldPath, sha, 'delete: '+oldPath.split('/').pop())
    toast('✅ Zmieniono nazwę! Zaktualizowano '+updated+' pliki md.', '')
    loadImages()
  } catch(e) {
    toast('❌ '+e.message, 'err')
  }
}

