/* WebP */
function toWebP(file,q){
  return new Promise(function(res){
    var img=new Image(), url=URL.createObjectURL(file)
    img.onload=function(){
      var c=document.createElement('canvas'); c.width=img.naturalWidth; c.height=img.naturalHeight
      c.getContext('2d').drawImage(img,0,0)
      c.toBlob(function(b){URL.revokeObjectURL(url);res(b)},'image/webp',q||.85)
    }
    img.onerror=function(){URL.revokeObjectURL(url);res(file)}
    img.src=url
  })
}
function blobToB64(blob){
  return new Promise(function(res){
    var r=new FileReader()
    r.onload=function(e){res(e.target.result.split(',')[1])}
    r.readAsDataURL(blob)
  })
}

var uz=qs('#upload-zone'), fi=qs('#file-input')
uz.addEventListener('click',function(){fi.click()})
uz.addEventListener('dragover',function(e){e.preventDefault();this.classList.add('drag')})
uz.addEventListener('dragleave',function(){this.classList.remove('drag')})
uz.addEventListener('drop',function(e){e.preventDefault();this.classList.remove('drag');handleFiles(e.dataTransfer.files)})
fi.addEventListener('change',function(){handleFiles(this.files)})

async function handleFiles(files){
  var log=qs('#upload-log'); log.innerHTML=''
  var cvt=qs('#webp-cb').checked
  var destFolder=CONFIG.imgRoot+(currentImgFolder.endsWith('/blog')?'/blog':'')

  for(var i=0;i<files.length;i++){
    var file=files[i]
    if(file.size>5*1024*1024){toast('❌ '+file.name+': max 5 MB','err');continue}
    var item=document.createElement('div'); item.className='log-item'
    item.innerHTML='<span class="material-symbols-outlined spin" style="font-size:15px">progress_activity</span><span>'+file.name+'</span><span style="color:var(--muted)">Konwertowanie…</span>'
    log.appendChild(item)
    try{
      var blob=file, ext=file.name.replace(/.*\./,'').toLowerCase()
      var base=file.name.replace(/\.[^.]+$/,'')
      if(cvt&&ext!=='webp'){blob=await toWebP(file,.85);ext='webp'}
      var b64=await blobToB64(blob)
      var fname=Date.now()+'-'+slugify(base)+'.'+ext
      var path=destFolder+'/'+fname
      var url='/images'+(currentImgFolder.endsWith('/blog')?'/blog':'')+'/'+fname
      item.querySelector('span:last-child').textContent='Wgrywanie…'
      var sha=null; try{var ex=await ghGet(path);sha=ex.sha}catch{}
      await ghPutBin(path,b64,sha,'upload: '+fname)
      item.querySelector('.spin').remove()
      item.querySelector('span:last-child').style.color='var(--ok)'
      item.querySelector('span:last-child').textContent='✅ OK'
      var urlEl=document.createElement('span'); urlEl.className='url'; urlEl.textContent=url; item.appendChild(urlEl)
      var cp=document.createElement('button'); cp.className='btn btn-ghost btn-sm'; cp.textContent='Kopiuj URL'
      cp.onclick=(function(u){return function(){navigator.clipboard.writeText(u).then(function(){cp.textContent='✅ Skopiowano';setTimeout(function(){cp.textContent='Kopiuj URL'},1500)})}})(url)
      item.appendChild(cp)
    }catch(e){
      if(item.querySelector('.spin')) item.querySelector('.spin').remove()
      var el=item.querySelector('span:last-child'); el.style.color='var(--err)'; el.textContent='❌ '+e.message
    }
  }
  fi.value=''
  loadImages()
}

async function loadImages(){
  var grid=qs('#imgs-grid'), cnt=qs('#imgs-count')
  grid.innerHTML=''; cnt.textContent=''
  var folder=CONFIG.imgRoot+(currentImgFolder.endsWith('/blog')?'/blog':'')
  try{
    var files=await ghList(folder)
    var imgs=files.filter(function(f){return f.type==='file'&&/\.(jpg|jpeg|png|webp|gif|svg)$/i.test(f.name)})
    cnt.textContent=imgs.length+' plików w /'+folder.replace('public/','')
    if(!imgs.length){grid.innerHTML='<p style="color:var(--muted);font-size:13px">Brak zdjęć.</p>';return}
    imgs.slice().reverse().forEach(function(f){
      var url='/'+f.path.replace('public/','')
      var card=document.createElement('div'); card.className='img-card'
      card.innerHTML=
        '<img src="'+url+'" alt="'+(altTexts[f.name]||f.name)+'" loading="lazy" style="cursor:zoom-in" onerror="this.src=\'https://placehold.co/152x100/111224/404dff?text=IMG\'"/>'+
        '<div class="img-info">'+
          '<div class="img-name">'+f.name+'</div>'+
          '<div class="img-actions">'+
            '<button class="img-btn copy" data-url="'+url+'">'+
              '<span class="material-symbols-outlined" style="font-size:11px">content_copy</span>URL'+
            '</button>'+
            '<button class="img-btn" title="Edytuj">'+
              '<span class="material-symbols-outlined" style="font-size:11px">edit</span>'+
            '</button>'+
          '</div>'+
        '</div>'
      card.querySelector('img').addEventListener('click',function(){ openLightbox(url,f.name) })
      card.querySelector('.img-btn.copy').addEventListener('click',function(ev){
        ev.stopPropagation()
        navigator.clipboard.writeText(this.dataset.url).then(function(){toast('✅ URL skopiowany!','ok')})
      })
      card.querySelector('.img-btn:not(.copy)').addEventListener('click',function(ev){
        ev.stopPropagation()
        openImgEdit({url:url,path:f.path,name:f.name,sha:f.sha})
      })
      grid.appendChild(card)
    })
  }catch(e){
    grid.innerHTML='<p style="color:var(--err);font-size:13px">Błąd: '+e.message+'</p>'
  }
}

/* ══ LIGHTBOX ══ */
function openLightbox(url, name){
  qs('#lightbox-img-el').src=url
  qs('#lightbox-img-el').alt=name||''
  qs('#lightbox-cap').textContent=name||''
  qs('#lightbox').classList.add('open')
}
qs('#lightbox').addEventListener('click',function(e){ if(e.target!==qs('#lightbox-img-el')) this.classList.remove('open') })
document.addEventListener('keydown',function(e){
  if(e.key==='Escape'){
    qs('#lightbox').classList.remove('open')
    qs('#img-edit-modal').classList.remove('open')
  }
})

/* ══ ALT TEXTS MANIFEST ══ */
var altTexts={}, altTextsSha=null
async function loadAltTexts(){
  try{
    var d=await ghGet(CONFIG.imgRoot+'/alt-texts.json')
    altTexts=JSON.parse(d.content)
    altTextsSha=d.sha
  } catch(e){ altTexts={}; altTextsSha=null }
}
async function saveAltTexts(){
  var content=JSON.stringify(altTexts,null,2)
  var res=await ghPut(CONFIG.imgRoot+'/alt-texts.json',content,altTextsSha,'update: alt-texts.json')
  altTextsSha=res.content.sha
}

/* ══ IMG EDIT MODAL ══ */
var currentEditImg=null
function openImgEdit(info){
  currentEditImg=info
  qs('#img-edit-prev').src=info.url
  qs('#img-rename-inp').value=info.name
  qs('#img-alt-inp').value=altTexts[info.name]||''
  qs('#img-edit-modal').classList.add('open')
}
qs('#img-edit-close').addEventListener('click',function(){ qs('#img-edit-modal').classList.remove('open') })
qs('#img-edit-modal').addEventListener('click',function(e){ if(e.target===this) this.classList.remove('open') })

qs('#img-rename-btn').addEventListener('click',async function(){
  if(!currentEditImg) return
  var newName=qs('#img-rename-inp').value.trim()
  if(!newName||newName===currentEditImg.name){ toast('⚠ Podaj nową nazwę','warn'); return }
  var parts=currentEditImg.path.split('/')
  parts[parts.length-1]=newName
  var newPath=parts.join('/')
  this.disabled=true
  try{
    var existing=await ghGet(currentEditImg.path)
    await ghPutBin(newPath,existing.rawB64,null,'rename: '+currentEditImg.name+' → '+newName)
    await ghDelete(currentEditImg.path,existing.sha,'rename: '+currentEditImg.name)
    if(altTexts[currentEditImg.name]!==undefined){
      altTexts[newName]=altTexts[currentEditImg.name]
      delete altTexts[currentEditImg.name]
      await saveAltTexts()
    }
    toast('✅ Zmieniono nazwę: '+newName,'ok')
    qs('#img-edit-modal').classList.remove('open')
    loadImages()
  } catch(e){ toast('❌ '+e.message,'err') }
  this.disabled=false
})

qs('#img-alt-btn').addEventListener('click',async function(){
  if(!currentEditImg) return
  var alt=qs('#img-alt-inp').value.trim()
  this.disabled=true
  try{
    if(alt) altTexts[currentEditImg.name]=alt
    else delete altTexts[currentEditImg.name]
    await saveAltTexts()
    toast('✅ Alt text zapisany!','ok')
  } catch(e){ toast('❌ '+e.message,'err') }
  this.disabled=false
})

/* ══ IMAGE PICKER MODAL ══ */
function openPicker(cb){
  pickerCallback=cb
  qs('#picker-modal').classList.add('open')
  loadPickerImages()
}
qs('#picker-close').addEventListener('click',function(){qs('#picker-modal').classList.remove('open')})
qs('#picker-modal').addEventListener('click',function(e){if(e.target===this)this.classList.remove('open')})
qsa('.picker-tab').forEach(function(btn){
  btn.addEventListener('click',function(){
    qsa('.picker-tab').forEach(function(b){b.classList.remove('active')})
    this.classList.add('active')
    pickerFolder=this.dataset.pfolder
    loadPickerImages()
  })
})
async function loadPickerImages(){
  var body=qs('#picker-body')
  body.innerHTML='<p style="color:var(--muted);font-size:13px;grid-column:1/-1">Ładowanie…</p>'
  var folder=CONFIG.imgRoot+(pickerFolder.endsWith('/blog')?'/blog':'')
  try{
    var files=await ghList(folder)
    var imgs=files.filter(function(f){return f.type==='file'&&/\.(jpg|jpeg|png|webp|gif|svg)$/i.test(f.name)})
    body.innerHTML=''
    if(!imgs.length){body.innerHTML='<p style="color:var(--muted);font-size:13px;grid-column:1/-1">Brak zdjęć.</p>';return}
    imgs.slice().reverse().forEach(function(f){
      var url='/'+f.path.replace('public/','')
      var card=document.createElement('div'); card.className='picker-card'
      card.innerHTML='<img src="'+url+'" alt="'+f.name+'" loading="lazy" onerror="this.src=\'https://placehold.co/130x85/111224/404dff?text=IMG\'"/>'+
        '<div class="picker-card-name">'+f.name+'</div>'
      card.addEventListener('click',function(){
        if(pickerCallback) pickerCallback(url)
        qs('#picker-modal').classList.remove('open')
      })
      body.appendChild(card)
    })
  }catch(e){
    body.innerHTML='<p style="color:var(--err);font-size:13px;grid-column:1/-1">Błąd: '+e.message+'</p>'
  }
}
</script>
</body>
</html>
