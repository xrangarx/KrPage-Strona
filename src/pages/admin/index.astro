/* ─ build font cards ─ */
function buildFontCards(containerId, getActive, setActive){
  var el=qs('#'+containerId); if(!el) return
  el.innerHTML=''
  LAY_FONTS.forEach(function(f){
    var card=document.createElement('div')
    card.className='lay-font-card'+(getActive()===f.id?' active':'')
    card.innerHTML=
      '<div class="lay-font-name" style="font-family:\''+f.id+'\',sans-serif">'+f.label+'</div>'+
      '<div class="lay-font-sample" style="font-family:\''+f.id+'\',sans-serif">'+f.sample+'</div>'+
      '<div class="lay-font-pangram" style="font-family:\''+f.id+'\',sans-serif">Szybki brązowy lis skoczył przez płot</div>'
    card.addEventListener('click',function(){
      setActive(f.id)
      qsa('#'+containerId+' .lay-font-card').forEach(function(c){c.classList.remove('active')})
      card.classList.add('active')
    })
    el.appendChild(card)
  })
}

