qs('#site-link').href          = CONFIG.siteUrl

/* ── TOAST ── */
function toast(msg, type) {
  var t = qs('#toast')
  t.textContent = msg
  t.className   = type === 'err' ? 'err' : (type === 'ok' ? 'ok-t' : '')
  t.style.display = 'flex'
  clearTimeout(t._t)
  t._t = setTimeout(function(){ t.style.display='none' }, 3600)
}

/* ══ GITHUB API ══ */
function ghUrl(path) {
  return 'https://api.github.com/repos/' + CONFIG.owner + '/' + CONFIG.repo + '/contents/' + path
}
function ghH(extra) {
  return Object.assign({ Authorization:'token '+token, Accept:'application/vnd.github+json' }, extra||{})
}
function b64enc(str) {
  var bytes=new TextEncoder().encode(str),bin=''
  bytes.forEach(function(b){bin+=String.fromCharCode(b)})
  return btoa(bin)
}
function b64dec(b64) {
  var bin=atob(b64.replace(/\s/g,'')), bytes=new Uint8Array(bin.length)
  for(var i=0;i<bin.length;i++) bytes[i]=bin.charCodeAt(i)
  return new TextDecoder().decode(bytes)
}
async function ghList(path) {
  var r=await fetch(ghUrl(path),{headers:ghH()})
  if(r.status===404) return []
  if(!r.ok){var d=await r.json();throw new Error(d.message||'HTTP '+r.status)}
  return r.json()
}
async function ghGet(path) {
  var r=await fetch(ghUrl(path),{headers:ghH()})
  if(!r.ok){var d=await r.json();throw new Error(d.message||'HTTP '+r.status)}
  var d=await r.json()
  return {content:b64dec(d.content),sha:d.sha,path:d.path,rawB64:d.content.replace(/\s/g,'')}
}
async function ghPut(path,content,sha,msg) {
  var body={message:msg,content:b64enc(content),branch:CONFIG.branch}
  if(sha) body.sha=sha
  var r=await fetch(ghUrl(path),{method:'PUT',headers:ghH({'Content-Type':'application/json'}),body:JSON.stringify(body)})
  var d=await r.json()
  if(!r.ok) throw new Error(d.message||'HTTP '+r.status)
  return d
}
async function ghPutBin(path,rawB64,sha,msg) {
  var body={message:msg,content:rawB64,branch:CONFIG.branch}
  if(sha) body.sha=sha
  var r=await fetch(ghUrl(path),{method:'PUT',headers:ghH({'Content-Type':'application/json'}),body:JSON.stringify(body)})
  var d=await r.json()
  if(!r.ok) throw new Error(d.message||'HTTP '+r.status)
  return d
}
async function ghDelete(path,sha,msg) {
  var r=await fetch(ghUrl(path),{method:'DELETE',headers:ghH({'Content-Type':'application/json'}),body:JSON.stringify({message:msg,sha:sha,branch:CONFIG.branch})})
  if(!r.ok){var d=await r.json();throw new Error(d.message||'HTTP '+r.status)}
}

/* ══ FRONTMATTER ══ */
function parseFM(raw) {
  var m=raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/)
  if(!m) return {fm:{},body:raw}
  var fm={}, lines=m[1].split('\n'), i=0
  while(i<lines.length){
    var line=lines[i]
    if(i+1<lines.length && lines[i+1].trimStart().startsWith('- ')){
      var key=line.replace(':','').trim(), arr=[]
      i++
      while(i<lines.length && lines[i].trimStart().startsWith('- ')){
        arr.push(lines[i].replace(/^\s*-\s*/,'').replace(/^"(.*)"$/,'$1').trim())
        i++
      }
      fm[key]=arr
    } else {
      var idx=line.indexOf(':')
      if(idx>=0){
        var k=line.slice(0,idx).trim()
        var v=line.slice(idx+1).trim().replace(/^"(.*)"$/,'$1')
        fm[k]=v
      }
      i++
    }
  }
  return {fm,body:m[2].trim()}
}
function buildFM(col, values, body) {
  var lines=['---']
  col.fields.forEach(function(f){
    var v=values[f.name]
    if(v===undefined||v===null||v==='') return
    if(f.type==='tags'){
      var items=String(v).split(',').map(function(s){return s.trim()}).filter(Boolean)
      if(items.length){ lines.push(f.name+':'); items.forEach(function(it){lines.push('  - "'+it+'"')}) }
    } else {
      lines.push(f.name+': "'+String(v).replace(/\\/g,'\\\\').replace(/"/g,'\\"')+'"')
    }
  })
  lines.push('---','',body)
  return lines.join('\n')
}
function slugify(s) {
  return s.toLowerCase()
    .replace(/ą/g,'a').replace(/ć/g,'c').replace(/ę/g,'e').replace(/ł/g,'l')
    .replace(/ń/g,'n').replace(/ó/g,'o').replace(/ś/g,'s').replace(/ź/g,'z').replace(/ż/g,'z')
    .replace(/[^a-z0-9 -]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-').slice(0,60)
}
function today(){ return new Date().toISOString().slice(0,10) }

/* ══ LOGIN ══ */
qs('#login-btn').addEventListener('click', async function(){
  var pat=qs('#pat-inp').value.trim()
  if(!pat) return
  qs('#login-label').textContent='Sprawdzam…'
  this.disabled=true
  try{
    var r=await fetch('https://api.github.com/repos/'+CONFIG.owner+'/'+CONFIG.repo,{headers:{Authorization:'token '+pat}})
    if(!r.ok) throw new Error('Nieprawidłowy token lub brak dostępu do repozytorium')
    token=pat
    if(qs('#remember-tok').checked) localStorage.setItem('cms_pat',pat)
    else sessionStorage.setItem('cms_pat',pat)
    showApp()
  } catch(e){
    toast('❌ '+e.message,'err')
    qs('#login-label').textContent='Zaloguj'
    this.disabled=false
  }
})
qs('#pat-inp').addEventListener('keydown',function(e){if(e.key==='Enter') qs('#login-btn').click()})
qs('#logout-btn').addEventListener('click',function(){
  token=''
  localStorage.removeItem('cms_pat')
  sessionStorage.removeItem('cms_pat')
  hide(qs('#app'))
  show(qs('#login-screen'))
})

;(function(){
  var saved=localStorage.getItem('cms_pat')||sessionStorage.getItem('cms_pat')
  if(saved){token=saved; qs('#login-screen').style.display='none'; showApp()}
})()

function showApp(){
  hide(qs('#login-screen'))
  show(qs('#app'))
  buildSidebarNav()
  // open first collection
  if(CONFIG.collections.length) switchToList(CONFIG.collections[0])
}

/* ══ SIDEBAR NAV ══ */
function buildSidebarNav(){
  var nav=qs('#nav-collections')
  nav.innerHTML=''
  CONFIG.collections.forEach(function(col){
    var btn=document.createElement('button')
    btn.className='nav-item'
    btn.dataset.colId=col.id
    btn.innerHTML='<span class="material-symbols-outlined" style="font-size:16px;flex-shrink:0">'+col.icon+'</span>'+
      '<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+col.label+'</span>'+
      '<span class="nav-count" id="cnt-'+col.id+'">…</span>'
    btn.addEventListener('click',function(){switchToList(col)})
    nav.appendChild(btn)
  })
  // images nav
  qs('[data-view="images"]').addEventListener('click',switchToImages)
}
function setActiveNav(id){
  qsa('.nav-item').forEach(function(b){ b.classList.toggle('active', b.dataset.colId===id||b.dataset.view===id) })
}

/* ══ VIEWS ══ */
function hideAllViews(){
  hide(qs('#view-list'))
  hide(qs('#view-editor'))
  hide(qs('#view-images'))
  hide(qs('#back-btn'))
  hide(qs('#save-btn'))
  hide(qs('#new-btn'))
  qs('#toolbar-status').textContent=''
}

async function switchToList(col){
  currentCol=col
  currentView='list-'+col.id
  setActiveNav(col.id)
  hideAllViews()
  show(qs('#view-list'))
  show(qs('#new-btn'))
  qs('#toolbar-title').textContent=col.label
  qs('#new-btn').onclick=function(){openEditor(col,null)}
  await loadList(col)
}

async function loadList(col){
  var grid=qs('#list-grid')
  var load=qs('#list-loading')
  grid.innerHTML=''
  show(load)
  try{
    var files=await ghList(col.folder)
    var mds=files.filter(function(f){return f.name.endsWith('.md')})
    var cnt=qs('#cnt-'+col.id)
    if(cnt) cnt.textContent=mds.length

    if(!mds.length){
      hide(load)
      grid.innerHTML='<div class="list-empty">Brak wpisów. Utwórz pierwszy.</div>'
      return
    }
    var posts=await Promise.all(mds.map(function(f){
      return ghGet(f.path).then(function(r){return Object.assign(r,{name:f.name})})
    }))
    posts.sort(function(a,b){
      var da=parseFM(a.content).fm.date||'', db=parseFM(b.content).fm.date||''
      return db.localeCompare(da)
    })
    hide(load)
    posts.forEach(function(post){
      var p=parseFM(post.content)
      var fm=p.fm
      var card=document.createElement('div')
      card.className='doc-card fade'
      var imgSrc=fm.image||'https://placehold.co/56x40/111224/404dff?text=IMG'
      var badge=fm.category||fm.type||fm.industry||''
      var meta=fm.date||''
      var sub=fm.readTime||fm.result||''
      card.innerHTML=
        '<div class="doc-thumb"><img src="'+imgSrc+'" alt="" onerror="this.src=\'https://placehold.co/56x40/111224/404dff?text=IMG\'"/></div>'+
        '<div class="doc-info">'+
          '<div class="doc-title">'+(fm.title||post.name)+'</div>'+
          '<div class="doc-meta">'+
            (badge?'<span class="badge">'+badge+'</span>':'')+
            (meta?'<span class="meta-date">'+meta+'</span>':'')+
            (sub?'<span class="meta-date">'+sub+'</span>':'')+
          '</div>'+
        '</div>'+
        '<span class="material-symbols-outlined doc-arrow">chevron_right</span>'
      card.addEventListener('click',function(){openEditor(col,post)})
      grid.appendChild(card)
    })
  }catch(e){
    hide(load)
    grid.innerHTML='<div class="list-empty" style="color:var(--err)">Błąd: '+e.message+'</div>'
  }
}

/* ══ EDITOR ══ */
function openEditor(col, post){
  currentCol=col
  editingFile=post?{path:post.path,sha:post.sha}:null
  currentView='editor'
  hideAllViews()
  show(qs('#view-editor'))
  show(qs('#back-btn'))
  show(qs('#save-btn'))
  qs('#back-btn').onclick=function(){switchToList(col)}
  qs('#toolbar-title').textContent=post?'Edycja — '+(parseFM(post.content).fm.title||post.name):'Nowy wpis'
  qs('#save-label').textContent=post?'Zapisz zmiany':'Opublikuj'
  qs('#toolbar-status').textContent=''
  renderForm(col, post)
}

function renderForm(col, post){
  var fm={}, body=''
  if(post){ var p=parseFM(post.content); fm=p.fm; body=p.body }

  // slug field (always first, derived from title)
  var slugVal=post?post.name.replace('.md',''):''

  var html='<div class="form-grid g2" style="margin-bottom:12px">'+
    '<div class="field">'+
      '<label class="field-label" for="f-slug">Slug (URL pliku)</label>'+
      '<input class="inp" id="f-slug" value="'+esc(slugVal)+'" placeholder="np. audyt-seo-2025" />'+
    '</div>'+
    '<div></div>'+
  '</div>'+
  '<div class="form-grid g2" style="margin-bottom:0">'

  var gridItems=[]
  col.fields.forEach(function(f){
    var val=fm[f.name]!==undefined?fm[f.name]:''
    // normalize arrays (YAML array) and inline JSON arrays to comma string
    if(Array.isArray(val)) val=val.join(', ')
    else if(typeof val==='string'&&val.trim().startsWith('[')){
      try{ var arr=JSON.parse(val); if(Array.isArray(arr)) val=arr.join(', ') }catch(e){}
    }
    var req=f.required?'<span class="req">*</span>':''
    var fieldHtml='<div class="field">'+'<label class="field-label" for="ff-'+f.name+'">'+f.label+req+'</label>'

    if(f.type==='string'){
      fieldHtml+='<input class="inp" id="ff-'+f.name+'" data-field="'+f.name+'" value="'+esc(val)+'" placeholder="'+(f.placeholder||'')+'" />'
    } else if(f.type==='text'){
      fieldHtml+='<textarea class="ta" id="ff-'+f.name+'" data-field="'+f.name+'" rows="2">'+esc(val)+'</textarea>'
    } else if(f.type==='date'){
      fieldHtml+='<input class="inp" type="date" id="ff-'+f.name+'" data-field="'+f.name+'" value="'+esc(val||today())+'" />'
    } else if(f.type==='select'){
      var opts=f.options.map(function(o){
        return '<option value="'+esc(o)+'"'+(val===o?' selected':'')+'>'+o+'</option>'
      }).join('')
      fieldHtml+='<select class="sel" id="ff-'+f.name+'" data-field="'+f.name+'"><option value="">Wybierz…</option>'+opts+'</select>'
    } else if(f.type==='image'){
      fieldHtml+=
        '<div class="inp-row">'+
          '<input class="inp" id="ff-'+f.name+'" data-field="'+f.name+'" value="'+esc(val)+'" placeholder="/images/... lub https://..." />'+
          '<button class="btn btn-ghost btn-sm" type="button" data-picker-target="ff-'+f.name+'" style="padding:0 12px;flex-shrink:0">'+
            '<span class="material-symbols-outlined" style="font-size:15px">photo_library</span>Galeria'+
          '</button>'+
        '</div>'+
        (val?'<img class="img-field-prev" id="fimg-'+f.name+'" src="'+esc(val)+'" alt="" onerror="this.style.display=\'none\'" />':
             '<img class="img-field-prev" id="fimg-'+f.name+'" src="" alt="" style="display:none" />')
    } else if(f.type==='tags'){
      fieldHtml+='<input class="inp" id="ff-'+f.name+'" data-field="'+f.name+'" value="'+esc(val)+'" placeholder="'+(f.placeholder||'tag1, tag2, tag3')+'" />'
    }
    fieldHtml+='</div>'
    gridItems.push({f:f, html:fieldHtml})
  })

  // layout: wide fields (text, image) go full-width; others pair up
  var rows=''
  var i=0
  while(i<gridItems.length){
    var cur=gridItems[i]
    var isWide=cur.f.type==='text'||cur.f.type==='image'||cur.f.type==='tags'
    if(isWide){
      rows+='</div><div class="form-grid g2" style="margin-bottom:12px"><div style="grid-column:1/-1">'+cur.html+'</div></div><div class="form-grid g2" style="margin-bottom:0">'
      i++
    } else {
      rows+=cur.html
      i++
    }
  }
  html+=rows+'</div>'

  qs('#form-fields').innerHTML=html
  qs('#md-editor').value=body
  updatePreview()

  // auto-slug from title
  var titleInp=qs('#ff-title')
  if(titleInp&&!editingFile){
    titleInp.addEventListener('input',function(){
      qs('#f-slug').value=slugify(this.value)
    })
  }

  // image picker buttons + live preview
  qsa('[data-picker-target]').forEach(function(btn){
    btn.addEventListener('click',function(){
      var target=btn.dataset.pickerTarget
      openPicker(function(url){
        var el=qs('#'+target)
        if(!el) return
        el.value=url
        var fname=target.replace('ff-','')
        var prev=qs('#fimg-'+fname)
        if(prev){prev.src=url;prev.style.display='block'}
        toast('✅ Wybrano: '+url.split('/').pop())
      })
    })
  })
  // live preview on manual URL input
  qsa('.img-field-prev').forEach(function(img){
    var fname=img.id.replace('fimg-','')
    var inp=qs('#ff-'+fname)
    if(inp) inp.addEventListener('input',function(){
      var u=this.value.trim()
      if(u){img.src=u;img.style.display='block'}else img.style.display='none'
    })
  })
}

function esc(s){
  if(s===undefined||s===null) return ''
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')
}

/* ══ SAVE ══ */
qs('#save-btn').addEventListener('click', async function(){
  var col=currentCol
  var slug=qs('#f-slug').value.trim()
  var values={}
  col.fields.forEach(function(f){
    var el=qs('#ff-'+f.name)
    if(el) values[f.name]=el.value.trim()
  })
  var body=qs('#md-editor').value.trim()

  // validate required
  var missing=[]
  col.fields.filter(function(f){return f.required}).forEach(function(f){
    if(!values[f.name]) missing.push(f.label)
  })
  if(!body) missing.push('Treść')
  if(missing.length){ toast('⚠ Uzupełnij: '+missing.join(', '),'warn'); return }

  if(!slug) slug=slugify(values.title||'wpis')
  var path=editingFile?editingFile.path:col.folder+'/'+slug+'.md'
  var sha=editingFile?editingFile.sha:null
  var content=buildFM(col,values,body)
  var msg=(editingFile?'update':'add')+': '+slug+'.md'

  var statusEl=qs('#toolbar-status')
  this.disabled=true
  qs('#save-label').textContent='Publikuję…'
  statusEl.textContent=''
  statusEl.className='toolbar-status'
  try{
    var res=await ghPut(path,content,sha,msg)
    toast('✅ '+(editingFile?'Zaktualizowano':'Opublikowano')+'!','ok')
    statusEl.textContent='✅ Live za ~60 s'
    statusEl.className='toolbar-status ok'
    if(!editingFile){
      editingFile={path:path,sha:res.content.sha}
      qs('#save-label').textContent='Zapisz zmiany'
    } else {
      editingFile.sha=res.content.sha
    }
    // update count
    var cnt=qs('#cnt-'+col.id)
    if(cnt&&!sha) cnt.textContent=parseInt(cnt.textContent||'0',10)+1
  }catch(e){
    toast('❌ '+e.message,'err')
    statusEl.textContent='❌ '+e.message
    statusEl.className='toolbar-status err'
  }finally{
    this.disabled=false
    qs('#save-label').textContent=editingFile?'Zapisz zmiany':'Opublikuj'
  }
})

