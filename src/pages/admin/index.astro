---
// Standalone admin — noindex, no BaseLayout
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>KrPage Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#050A07;--bg2:#0D1410;--bg3:#151C17;
      --border:rgba(45,255,95,0.12);--neon:#2DFF5F;
      --neon10:rgba(45,255,95,0.08);--neon30:rgba(45,255,95,0.3);
      --text:#dee4de;--muted:#7a9478;--danger:#ff4d6d;--warn:#ffc800;
    }
    body{font-family:'Manrope',sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
    .hidden{display:none!important}
    .material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;vertical-align:middle}

    /* LOGIN */
    #login-screen{min-height:100vh;display:flex;align-items:center;justify-content:center}
    .login-box{width:100%;max-width:460px;padding:48px 40px;background:var(--bg2);border:1px solid var(--border);box-shadow:0 0 60px rgba(45,255,95,0.06)}
    .admin-logo{display:flex;align-items:center;gap:10px;font-size:22px;font-weight:800;color:var(--neon);margin-bottom:8px}
    .login-box>p{color:var(--muted);font-size:14px;margin-bottom:24px;line-height:1.6}
    .login-warn{background:rgba(255,200,0,0.08);border:1px solid rgba(255,200,0,0.3);color:var(--warn);font-size:12px;padding:10px 14px;margin-bottom:16px;line-height:1.6}
    .login-warn strong{display:block;margin-bottom:4px}

    /* BUTTONS */
    .btn{display:inline-flex;align-items:center;gap:7px;font-family:'Manrope',sans-serif;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:10px 18px;border:none;cursor:pointer;transition:all .15s}
    .btn-primary{background:var(--neon);color:#003010}
    .btn-primary:hover{filter:brightness(1.15)}
    .btn-primary:disabled{opacity:.5;cursor:not-allowed}
    .btn-secondary{background:transparent;color:var(--muted);border:1px solid var(--border)}
    .btn-secondary:hover{border-color:var(--neon30);color:var(--text)}
    .btn-ghost{background:transparent;color:var(--muted);border:1px solid transparent;padding:6px 10px;font-size:12px}
    .btn-ghost:hover{border-color:var(--border);color:var(--text)}
    .btn-danger{background:transparent;color:var(--danger);border:1px solid rgba(255,77,109,0.2);font-size:12px;padding:6px 10px}
    .btn-danger:hover{background:rgba(255,77,109,0.08);border-color:rgba(255,77,109,0.4)}
    .btn-full{width:100%;justify-content:center}

    /* INPUTS */
    .admin-input,.admin-select,.admin-textarea{
      width:100%;padding:10px 12px;background:var(--bg3);
      border:1px solid var(--border);color:var(--text);
      font-family:'Manrope',sans-serif;font-size:14px;outline:none;transition:border-color .15s
    }
    .admin-input:focus,.admin-select:focus,.admin-textarea:focus{border-color:var(--neon30)}
    .admin-select option{background:var(--bg2)}
    .field-label{display:block;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:5px}
    .field-group{display:flex;flex-direction:column}

    /* DASHBOARD */
    #dashboard{display:flex;flex-direction:column;min-height:100vh}
    .admin-header{
      display:flex;align-items:center;gap:16px;padding:0 24px;height:56px;
      background:var(--bg2);border-bottom:1px solid var(--border);
      position:sticky;top:0;z-index:100
    }
    .header-logo{font-size:15px;font-weight:800;color:var(--neon);white-space:nowrap;display:flex;align-items:center;gap:8px}
    .tab-nav{display:flex;gap:2px;flex:1;overflow-x:auto}
    .tab-btn{
      display:inline-flex;align-items:center;gap:6px;padding:8px 14px;
      background:transparent;border:none;border-bottom:2px solid transparent;
      color:var(--muted);font-family:'Manrope',sans-serif;font-size:12px;font-weight:700;
      cursor:pointer;text-transform:uppercase;letter-spacing:.06em;
      transition:all .15s;white-space:nowrap
    }
    .tab-btn:hover{color:var(--text)}
    .tab-btn.active{color:var(--neon);border-bottom-color:var(--neon)}

    .tab-content{flex:1;padding:28px;display:none}
    .tab-content.active{display:block}
    .section-title{font-size:18px;font-weight:800;margin-bottom:0}

    /* POSTS */
    .posts-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
    .post-card{
      background:var(--bg2);border:1px solid var(--border);
      padding:16px 20px;display:flex;align-items:center;gap:16px;
      margin-bottom:10px;transition:border-color .15s
    }
    .post-card:hover{border-color:var(--neon30)}
    .post-info{flex:1;min-width:0}
    .post-title{font-size:14px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:4px}
    .post-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    .cat-badge{display:inline-block;padding:2px 7px;border:1px solid var(--neon30);color:var(--neon);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em}
    .meta-text{font-size:11px;color:var(--muted)}
    .loading{color:var(--muted);font-size:14px;display:flex;align-items:center;gap:8px;padding:16px 0}
    @keyframes spin{to{transform:rotate(360deg)}}
    .spin{display:inline-block;animation:spin .8s linear infinite}

    /* EDITOR */
    .form-grid{display:grid;gap:12px;margin-bottom:12px}
    .g2{grid-template-columns:1fr 1fr}
    .g3{grid-template-columns:1fr 1fr 1fr}
    .g1{grid-template-columns:1fr}
    .editor-split{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:14px 0;height:calc(100vh - 430px);min-height:280px}
    .editor-pane,.preview-pane{background:var(--bg2);border:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden}
    .pane-label{padding:7px 14px;border-bottom:1px solid var(--border);font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
    #md-editor{flex:1;padding:14px;background:transparent;border:none;color:var(--text);font-family:'Courier New',monospace;font-size:13px;line-height:1.7;resize:none;outline:none}
    #md-preview{flex:1;padding:16px;overflow-y:auto;font-size:14px;line-height:1.7}
    #md-preview h1,#md-preview h2,#md-preview h3{color:var(--text);margin:1em 0 .4em;font-weight:700}
    #md-preview h2{font-size:1.2em}
    #md-preview h3{font-size:1.05em}
    #md-preview p{color:#9cb89c;margin-bottom:.7em}
    #md-preview strong{color:var(--text)}
    #md-preview a{color:var(--neon)}
    #md-preview code{background:var(--bg3);padding:1px 5px;font-size:.85em;color:var(--neon)}
    #md-preview ul,#md-preview ol{padding-left:1.4em;margin-bottom:.7em;color:#9cb89c}
    #md-preview blockquote{border-left:3px solid var(--neon30);padding-left:12px;color:var(--muted);font-style:italic}
    .editor-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    #save-status{font-size:13px;font-weight:600}
    #save-status.ok{color:var(--neon)}
    #save-status.err{color:var(--danger)}

    /* IMAGES */
    .img-subtabs{display:flex;gap:4px;margin-bottom:20px;border-bottom:1px solid var(--border);padding-bottom:0}
    .img-subtab{padding:8px 16px;background:transparent;border:none;border-bottom:2px solid transparent;color:var(--muted);font-family:'Manrope',sans-serif;font-size:12px;font-weight:700;cursor:pointer;text-transform:uppercase;letter-spacing:.06em;transition:all .15s;margin-bottom:-1px}
    .img-subtab:hover{color:var(--text)}
    .img-subtab.active{color:var(--neon);border-bottom-color:var(--neon)}
    .upload-zone{
      border:2px dashed var(--border);padding:40px 24px;text-align:center;
      cursor:pointer;transition:all .15s;margin-bottom:20px;
    }
    .upload-zone:hover,.upload-zone.dragover{border-color:var(--neon30);background:var(--neon10)}
    .upload-zone .material-symbols-outlined{font-size:36px;color:var(--muted);display:block;margin-bottom:10px}
    .upload-zone p{color:var(--muted);font-size:14px}
    .upload-zone p.strong{color:var(--text);font-weight:700;margin-bottom:4px}
    .webp-toggle{display:flex;align-items:center;gap:10px;margin-bottom:16px;font-size:13px;color:var(--muted)}
    .webp-toggle input{accent-color:var(--neon);width:16px;height:16px;cursor:pointer}
    .webp-toggle span{cursor:pointer}
    #upload-progress{margin-bottom:12px}
    .prog-item{display:flex;align-items:center;gap:10px;font-size:13px;padding:8px 12px;background:var(--bg2);border:1px solid var(--border);margin-bottom:6px}
    .prog-ok{color:var(--neon);font-weight:700}
    .prog-err{color:var(--danger);font-weight:700}
    .prog-url{font-family:monospace;font-size:11px;color:var(--neon);margin-left:auto;white-space:nowrap}
    .images-count{font-size:12px;color:var(--muted);margin-bottom:14px}
    .images-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px}
    .image-card{background:var(--bg2);border:1px solid var(--border);overflow:hidden;position:relative}
    .image-card img{width:100%;height:110px;object-fit:cover;display:block}
    .image-card-info{padding:8px 10px}
    .image-card-name{font-size:10px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:6px}
    .image-card-actions{display:flex;gap:4px}
    .img-btn{flex:1;display:flex;align-items:center;justify-content:center;gap:3px;padding:5px 6px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;cursor:pointer;border:1px solid var(--border);background:transparent;color:var(--muted);transition:all .15s}
    .img-btn:hover{border-color:var(--neon30);color:var(--neon)}
    .img-btn.copy{color:var(--neon);border-color:var(--neon30)}
    .rename-input-wrap{display:none;padding:8px 10px;border-top:1px solid var(--border);gap:4px;flex-direction:column}
    .rename-input-wrap.active{display:flex}
    .rename-input-wrap input{width:100%;padding:5px 8px;background:var(--bg3);border:1px solid var(--border);color:var(--text);font-size:11px;outline:none}
    .rename-input-wrap input:focus{border-color:var(--neon30)}
    .rename-actions{display:flex;gap:4px}
    .rename-confirm,.rename-cancel{flex:1;padding:4px 8px;font-size:10px;font-weight:700;text-transform:uppercase;cursor:pointer;border:none}
    .rename-confirm{background:var(--neon);color:#003010}
    .rename-cancel{background:var(--bg3);color:var(--muted);border:1px solid var(--border)}

    /* INSPECTOR */
    .inspector-box{max-width:680px}
    .inspector-box h2{font-size:20px;font-weight:800;margin-bottom:10px}
    .inspector-box>p{color:var(--muted);font-size:14px;line-height:1.7;margin-bottom:24px}
    .bookmarklet-link{
      display:inline-flex;align-items:center;gap:8px;
      background:var(--neon);color:#003010;font-size:14px;font-weight:800;
      padding:12px 20px;text-decoration:none;cursor:grab;letter-spacing:.02em
    }
    .drag-hint{font-size:12px;color:var(--muted);margin-top:8px;margin-bottom:24px}
    .steps{list-style:none;display:flex;flex-direction:column;gap:8px;margin-bottom:20px}
    .steps li{display:flex;gap:14px;background:var(--bg2);border:1px solid var(--border);padding:12px 14px}
    .step-n{color:var(--neon);font-weight:800;font-size:17px;min-width:20px}
    .step-t{font-size:13px;color:var(--muted);line-height:1.5}
    .step-t strong{color:var(--text)}
    .ex-box{background:var(--bg3);border:1px solid var(--border);border-left:3px solid var(--neon);padding:14px 18px}
    .ex-box p{font-size:12px;color:var(--muted);margin-bottom:6px}
    .ex-box code{font-family:'Courier New',monospace;font-size:12px;color:var(--neon)}

    /* TOAST */
    #toast{
      position:fixed;bottom:20px;right:20px;z-index:9999;
      background:var(--bg2);border:1px solid var(--neon30);color:var(--neon);
      padding:10px 18px;font-size:13px;font-weight:600;display:none;
      align-items:center;gap:8px;box-shadow:0 0 20px rgba(45,255,95,0.15);
      animation:slideIn .2s ease
    }
    @keyframes slideIn{from{transform:translateY(8px);opacity:0}to{transform:translateY(0);opacity:1}}
    #toast.err{border-color:rgba(255,77,109,.4);color:var(--danger)}
    #toast.warn{border-color:rgba(255,200,0,.4);color:var(--warn)}

    @media(max-width:900px){
      .editor-split{grid-template-columns:1fr;height:auto}
      .preview-pane{display:none}
      .g3{grid-template-columns:1fr 1fr}
    }
    @media(max-width:600px){
      .tab-content{padding:14px}
      .g2,.g3{grid-template-columns:1fr}
    }
  </style>
</head>
<body>

<!-- LOGIN -->
<section id="login-screen">
  <div class="login-box">
    <div class="admin-logo">
      <span class="material-symbols-outlined">terminal</span>
      KrPage Admin
    </div>
    <p>Panel zarządzania treściami. Zaloguj się GitHub Personal Access Token z uprawnieniami do zapisu.</p>
    <div class="login-warn">
      <strong>⚠ Wymagany token z uprawnieniami do zapisu</strong>
      GitHub → Settings → Developer settings → Personal access tokens → Fine-grained →
      repo: KrPage-Strona → <strong>Contents: Read & write</strong> + Metadata: Read
    </div>
    <input class="admin-input" type="password" id="pat-input" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx" autocomplete="current-password" style="margin-bottom:10px" />
    <button class="btn btn-primary btn-full" id="login-btn">
      <span class="material-symbols-outlined" style="font-size:16px">lock_open</span>
      <span id="login-label">Zaloguj</span>
    </button>
  </div>
</section>

<!-- DASHBOARD -->
<div id="dashboard" class="hidden">
  <header class="admin-header">
    <div class="header-logo">
      <span class="material-symbols-outlined" style="font-size:16px">terminal</span>KrPage
    </div>
    <nav class="tab-nav">
      <button class="tab-btn active" data-tab="posts">
        <span class="material-symbols-outlined" style="font-size:15px">article</span>Wpisy
      </button>
      <button class="tab-btn" data-tab="editor">
        <span class="material-symbols-outlined" style="font-size:15px">edit_note</span>Nowy wpis
      </button>
      <button class="tab-btn" data-tab="images">
        <span class="material-symbols-outlined" style="font-size:15px">photo_library</span>Zdjęcia
      </button>
      <button class="tab-btn" data-tab="inspector">
        <span class="material-symbols-outlined" style="font-size:15px">search</span>Inspektor
      </button>
    </nav>
    <button class="btn btn-ghost" id="logout-btn" style="margin-left:auto;white-space:nowrap">
      <span class="material-symbols-outlined" style="font-size:13px">logout</span>Wyloguj
    </button>
  </header>

  <!-- WPISY -->
  <div id="tab-posts" class="tab-content active">
    <div class="posts-header">
      <p class="section-title">Wpisy blogowe</p>
      <button class="btn btn-primary" id="btn-new-post" style="font-size:12px">
        <span class="material-symbols-outlined" style="font-size:15px">add</span>Nowy wpis
      </button>
    </div>
    <div id="posts-loading" class="loading">
      <span class="material-symbols-outlined spin">progress_activity</span>Ładowanie z GitHub...
    </div>
    <div id="posts-grid"></div>
  </div>

  <!-- EDYTOR -->
  <div id="tab-editor" class="tab-content">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
      <p class="section-title" id="editor-title">Nowy wpis</p>
      <span id="editing-badge" class="cat-badge hidden" style="border-color:rgba(255,200,0,.4);color:var(--warn)">Edycja</span>
    </div>

    <div class="form-grid g2">
      <div class="field-group">
        <label class="field-label">Tytuł *</label>
        <input class="admin-input" id="f-title" placeholder="np. Jak przeprowadzić audyt SEO w 2025" />
      </div>
      <div class="field-group">
        <label class="field-label">Slug (URL) — auto z tytułu</label>
        <input class="admin-input" id="f-slug" placeholder="audyt-seo-2025" />
      </div>
    </div>
    <div class="form-grid g1">
      <div class="field-group">
        <label class="field-label">Opis SEO (meta description) *</label>
        <input class="admin-input" id="f-description" placeholder="Krótki opis widoczny w Google — 120–160 znaków" />
      </div>
    </div>
    <div class="form-grid g3">
      <div class="field-group">
        <label class="field-label">Kategoria *</label>
        <select class="admin-select" id="f-category">
          <option value="">Wybierz...</option>
          <option>Tech SEO</option><option>Strategia</option>
          <option>Content</option><option>Link Building</option><option>Local SEO</option>
        </select>
      </div>
      <div class="field-group">
        <label class="field-label">Data publikacji</label>
        <input class="admin-input" id="f-date" type="date" />
      </div>
      <div class="field-group">
        <label class="field-label">Czas czytania</label>
        <input class="admin-input" id="f-readtime" placeholder="np. 7 min" />
      </div>
    </div>
    <div class="form-grid g1">
      <div class="field-group">
        <label class="field-label">URL zdjęcia okładkowego (wgraj w zakładce Zdjęcia → kopiuj URL)</label>
        <input class="admin-input" id="f-image" placeholder="https://... lub /images/blog/..." />
      </div>
    </div>

    <div class="editor-split">
      <div class="editor-pane">
        <div class="pane-label">✏️ Markdown</div>
        <textarea id="md-editor" placeholder="# Nagłówek&#10;&#10;Treść wpisu...&#10;&#10;## Sekcja&#10;&#10;Tekst z **pogrubieniem** i [linkiem](https://...)"></textarea>
      </div>
      <div class="preview-pane">
        <div class="pane-label">👁 Podgląd live</div>
        <div id="md-preview"></div>
      </div>
    </div>

    <div class="editor-actions">
      <button class="btn btn-secondary hidden" id="cancel-edit-btn">
        <span class="material-symbols-outlined" style="font-size:14px">close</span>Anuluj
      </button>
      <button class="btn btn-primary" id="save-btn" style="min-width:170px">
        <span class="material-symbols-outlined" style="font-size:15px">rocket_launch</span>
        <span id="save-label">Opublikuj</span>
      </button>
      <span id="save-status"></span>
    </div>
  </div>

  <!-- ZDJĘCIA -->
  <div id="tab-images" class="tab-content">
    <p class="section-title" style="margin-bottom:18px">Zdjęcia</p>

    <div class="img-subtabs">
      <button class="img-subtab active" data-folder="blog">📁 Blog (/images/blog/)</button>
      <button class="img-subtab" data-folder="site">📁 Podstrony (/images/)</button>
    </div>

    <div id="upload-section">
      <div class="upload-zone" id="upload-zone">
        <input type="file" id="file-input" accept="image/*" multiple style="display:none" />
        <span class="material-symbols-outlined">cloud_upload</span>
        <p class="strong">Przeciągnij zdjęcia tutaj lub kliknij</p>
        <p>JPEG, PNG, WebP, GIF — max 5MB na plik</p>
      </div>
      <div class="webp-toggle">
        <input type="checkbox" id="webp-toggle" checked />
        <span onclick="document.getElementById('webp-toggle').click()">
          Automatycznie konwertuj na <strong>WebP</strong> (mniejszy plik, lepsza wydajność)
        </span>
      </div>
    </div>

    <div id="upload-progress"></div>
    <div class="images-count" id="images-count"></div>
    <div class="images-grid" id="images-grid"></div>
  </div>

  <!-- INSPEKTOR -->
  <div id="tab-inspector" class="tab-content">
    <div class="inspector-box">
      <h2>🔍 Inspektor elementów</h2>
      <p>Przeciągnij poniższy przycisk na pasek zakładek. Na żywej stronie kliknij go — wejdziesz w tryb inspekcji. Kliknij dowolny element i opis trafi do schowka. Wklej go tutaj do Claude Code z opisem co chcesz zmienić.</p>
      <a id="bookmarklet-link" href="#" class="bookmarklet-link">
        <span class="material-symbols-outlined" style="font-size:15px">search</span>KrPage Inspector
      </a>
      <p class="drag-hint">↑ Przeciągnij ten przycisk na pasek zakładek (jednorazowo)</p>
      <ul class="steps">
        <li><span class="step-n">1</span><span class="step-t">Przeciągnij <strong>KrPage Inspector</strong> na pasek zakładek</span></li>
        <li><span class="step-n">2</span><span class="step-t">Wejdź na <strong>krpage.pl</strong> i kliknij zakładkę — elementy podświetlają się zielono</span></li>
        <li><span class="step-n">3</span><span class="step-t">Kliknij element który chcesz zmienić → opis trafi do <strong>schowka</strong></span></li>
        <li><span class="step-n">4</span><span class="step-t">Wklej do Claude Code i napisz co ma być inaczej, np. <em>"zmień kolor tła tego elementu"</em></span></li>
      </ul>
      <div class="ex-box">
