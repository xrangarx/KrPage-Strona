/* ─ switch to layout view ─ */
async function switchToLayout(){
  currentView='layout'
  setActiveNav('layout')
  hideAllViews()
  show(qs('#view-layout'))
  qs('#toolbar-title').textContent='Layout globalny'

  buildColorPresets()
  buildFontCards('body-font-row',   function(){ return currentBodyFont }, function(v){ currentBodyFont=v })
  buildFontCards('heading-font-row',function(){ return currentHeadFont }, function(v){ currentHeadFont=v })

  // Fill weight selects (non-heading)
  ;['bodyWeight','quoteWeight','btnWeight'].forEach(function(id){
    var el=qs('#'+id); if(el) fillWeightSelect(el,'400')
  })

  try{
    var lf=await ghGet('src/data/layout.json')
    layoutSha=lf.sha
    var d=JSON.parse(lf.content)

    // body font
    currentBodyFont=d.bodyFont||'Manrope'
    currentHeadFont=d.headingFont||'Manrope'
    buildFontCards('body-font-row',   function(){ return currentBodyFont }, function(v){ currentBodyFont=v })
    buildFontCards('heading-font-row',function(){ return currentHeadFont }, function(v){ currentHeadFont=v })

    // body typo numbers
    ;['bodySize','bodyLineHeight','bodyLetterSpacing'].forEach(function(id){
      var el=qs('#'+id); if(el&&d[id]!==undefined) el.value=d[id]
    })
    fillWeightSelect(qs('#bodyWeight'), d.bodyWeight||'400')

    // heading rows
    buildHeadingRows(d)

    // quote / btn
    ;['quoteSize','quoteLineHeight','btnSize','btnLetterSpacing','btnRadius'].forEach(function(id){
      var el=qs('#'+id); if(el&&d[id]!==undefined) el.value=d[id]
    })
    fillWeightSelect(qs('#quoteWeight'), d.quoteWeight||'400')
    fillWeightSelect(qs('#btnWeight'),   d.btnWeight||'700')
    if(qs('#quoteStyle')&&d.quoteStyle) qs('#quoteStyle').value=d.quoteStyle

    // colors
    LAY_COLOR_FIELDS.forEach(function(fid){
      var hex=qs('#'+fid), picker=qs('#cp-'+fid)
      var val=d[fid]||''
      if(hex) hex.value=val
      if(picker&&/^#[0-9a-fA-F]{6}$/.test(val)){ try{ picker.value=val }catch(e){} }
    })

    // layout
    ;['containerWidth','globalRadius'].forEach(function(id){
      var el=qs('#'+id); if(el&&d[id]!==undefined) el.value=d[id]
    })

  } catch(e){ toast('Błąd ładowania layout.json: '+e.message,'err') }
}

/* ─ collect all layout values ─ */
function collectLayoutData(){
  var d={}
  // fonts
  d.bodyFont=currentBodyFont
  d.headingFont=currentHeadFont
  // body typo
  ;['bodySize','bodyWeight','bodyLineHeight','bodyLetterSpacing'].forEach(function(id){
    var el=qs('#'+id); if(el) d[id]=el.value
  })
  // h1-h6
  ;[1,2,3,4,5,6].forEach(function(n){
    var h='h'+n
    ;[h+'Size',h+'Weight',h+'LineHeight',h+'LetterSpacing'].forEach(function(id){
      var el=qs('#'+id); if(el) d[id]=el.value
    })
  })
  // quote
  ;['quoteSize','quoteWeight','quoteStyle','quoteLineHeight'].forEach(function(id){
    var el=qs('#'+id); if(el) d[id]=el.value
  })
  // btn
  ;['btnSize','btnWeight','btnLetterSpacing','btnRadius'].forEach(function(id){
    var el=qs('#'+id); if(el) d[id]=el.value
  })
  // colors
  LAY_COLOR_FIELDS.forEach(function(fid){
    var el=qs('#'+fid); if(el) d[fid]=el.value
  })
  // layout
  ;['containerWidth','globalRadius'].forEach(function(id){
    var el=qs('#'+id); if(el) d[id]=el.value
  })
  return d
}

