---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)

const allPosts = await getCollection('blog')
const related  = allPosts
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 3)
---

<BaseLayout
  title={`${post.data.title} — Blog KrPage`}
  description={post.data.description}
  schemaType="blogpost"
  schemaProps={{ headline: post.data.title, datePublished: post.data.date, image: post.data.image }}
>

  <!-- Hero image -->
  <div class="w-full h-64 md:h-96 overflow-hidden relative">
    <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#050A07] via-[#050A07]/40 to-transparent"></div>
  </div>

  <article class="max-w-3xl mx-auto px-6 md:px-12 py-xl">

    <!-- Meta -->
    <div class="flex flex-wrap items-center gap-3 mb-md">
      <span class="text-label-sm text-neon uppercase tracking-widest border border-neon/20 px-2 py-0.5">
        {post.data.category}
      </span>
      <span class="text-label-sm text-on-surface-variant">{post.data.date}</span>
      <span class="text-label-sm text-on-surface-variant">·</span>
      <span class="text-label-sm text-on-surface-variant">{post.data.readTime} czytania</span>
    </div>

    <!-- Title -->
    <h1 class="text-headline-xl text-on-surface mb-lg">{post.data.title}</h1>

    <!-- Content -->
    <div class="prose prose-invert prose-neon max-w-none
                prose-headings:text-on-surface prose-headings:font-black
                prose-h2:text-headline-lg prose-h2:mt-xl prose-h2:mb-md
                prose-h3:text-headline-md prose-h3:mt-lg prose-h3:mb-sm
                prose-p:text-body-md prose-p:text-on-surface-variant prose-p:leading-relaxed prose-p:mb-md
                prose-li:text-body-md prose-li:text-on-surface-variant
                prose-strong:text-on-surface prose-strong:font-bold
                prose-a:text-neon prose-a:no-underline hover:prose-a:underline
                prose-hr:border-outline-variant/30
                prose-code:text-neon prose-code:bg-surface-container prose-code:px-1.5 prose-code:py-0.5
                prose-blockquote:border-l-neon prose-blockquote:text-on-surface-variant">
      <Content />
    </div>

    <!-- CTA -->
    <div class="mt-xl pt-xl border-t border-outline-variant/30">
      <div class="bento-card p-lg text-center">
        <p class="text-body-lg text-on-surface mb-md">
          Potrzebujesz pomocy z SEO? <span class="text-neon">Pierwsza analiza bezpłatna.</span>
        </p>
        <a href="/kontakt"
           class="inline-flex items-center gap-2 bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest px-xl py-md hover:brightness-125 hover:shadow-neon active:scale-95 transition-all shadow-neon-sm">
          Umów konsultację
        </a>
      </div>
    </div>

  </article>

  <!-- Related posts -->
  {related.length > 0 && (
    <section class="max-w-7xl mx-auto px-6 md:px-12 pb-xl">
      <div class="section-label mb-sm">Z tej samej kategorii</div>
      <h2 class="text-headline-lg text-on-surface mb-lg">Podobne wpisy</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        {related.map(p => (
          <article class="bento-card overflow-hidden group hover:border-neon/40 transition-all flex flex-col">
            <a href={`/blog/${p.id}`} class="block overflow-hidden h-40">
              <img src={p.data.image} alt={p.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </a>
            <div class="p-md flex flex-col flex-1">
              <span class="text-label-sm text-neon border border-neon/20 px-2 py-0.5 self-start mb-sm uppercase tracking-widest">{p.data.category}</span>
              <h3 class="text-headline-md text-on-surface group-hover:text-neon transition-colors flex-1">
                <a href={`/blog/${p.id}`}>{p.data.title}</a>
              </h3>
              <a href={`/blog/${p.id}`} class="mt-sm inline-flex items-center gap-1 text-neon text-label-sm uppercase tracking-widest hover:gap-3 transition-all">
                Czytaj <span class="material-symbols-outlined text-sm">arrow_forward</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

</BaseLayout>
