---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const allPosts = await getCollection('blog')
const posts = allPosts.sort((a, b) => b.data.date.localeCompare(a.data.date))
const categories = ['Wszystkie', 'Tech SEO', 'Strategia', 'Content', 'Link Building', 'Local SEO']
---

<BaseLayout
  title="Blog SEO — Poradniki, Strategie i Analizy"
  description="Blog KrPage: praktyczne poradniki SEO, analizy algorytmów Google, strategie link buildingu i content marketingu. Wiedza oparta o dane i realne wyniki."
  schemaType="webpage"
>

  <section class="max-w-7xl mx-auto px-6 md:px-12 pt-16 pb-lg relative">
    <div class="absolute -top-20 left-0 w-96 h-96 bg-neon/5 blur-[100px] rounded-full pointer-events-none"></div>
    <div class="relative z-10 mb-xl">
      <div class="section-label mb-sm">Baza wiedzy</div>
      <h1 class="text-headline-xl text-on-surface mb-md">
        Blog <span class="text-neon">SEO</span>
      </h1>
      <p class="text-body-lg text-on-surface-variant max-w-2xl">
        Praktyczna wiedza o pozycjonowaniu, technicznym SEO i strategii contentowej — oparta o dane z realnych projektów.
      </p>
    </div>

    <!-- Category filters -->
    <div class="flex flex-wrap gap-2 mb-xl">
      {categories.map((cat, i) => (
        <button
          data-filter={cat}
          class:list={[
            'filter-btn px-4 py-1.5 text-label-sm uppercase tracking-widest border transition-all',
            i === 0
              ? 'bg-neon text-on-primary border-neon'
              : 'border-outline-variant text-on-surface-variant hover:border-neon/40 hover:text-neon',
          ]}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Posts list -->
    <div class="space-y-6" id="posts-list">
      {posts.map(post => (
        <article
          data-category={post.data.category}
          class="post-card bento-card overflow-hidden group hover:border-neon/40 transition-all duration-300"
        >
          <div class="flex flex-col sm:flex-row">
            <a href={`/blog/${post.id}`} class="sm:w-72 lg:w-80 shrink-0 overflow-hidden block">
              <img
                src={post.data.image}
                alt={post.data.title}
                class="w-full h-52 sm:h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </a>
            <div class="flex flex-col justify-between p-lg flex-1">
              <div>
                <div class="flex items-center gap-3 mb-sm">
                  <span class="text-label-sm text-neon uppercase tracking-widest border border-neon/20 px-2 py-0.5">
                    {post.data.category}
                  </span>
                  <span class="text-label-sm text-on-surface-variant">{post.data.date}</span>
                  <span class="text-label-sm text-on-surface-variant">·</span>
                  <span class="text-label-sm text-on-surface-variant">{post.data.readTime} czytania</span>
                </div>
                <h2 class="text-headline-md text-on-surface mb-sm group-hover:text-neon transition-colors">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="text-body-md text-on-surface-variant line-clamp-3">{post.data.description}</p>
              </div>
              <div class="mt-md pt-md border-t border-outline-variant/30">
                <a
                  href={`/blog/${post.id}`}
                  class="inline-flex items-center gap-2 text-neon text-label-sm uppercase tracking-widest
                         border-b border-neon/30 pb-0.5 hover:border-neon hover:gap-4 transition-all"
                >
                  Czytaj artykuł
                  <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div id="empty-state" class="hidden text-center py-xl">
      <span class="material-symbols-outlined text-neon/30 text-5xl mb-md block">search_off</span>
      <p class="text-body-lg text-on-surface-variant">Brak wpisów w tej kategorii.</p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl">
    <div class="bento-card p-xl relative overflow-hidden">
      <div class="absolute right-0 top-0 bottom-0 w-1/3 bg-neon/3 blur-[80px] pointer-events-none"></div>
      <div class="relative z-10 grid lg:grid-cols-2 gap-lg items-center">
        <div>
          <div class="section-label mb-sm">Wiedza prosto do skrzynki</div>
          <h2 class="text-headline-lg text-on-surface mb-sm">
            Bądź o krok przed<br /><span class="text-neon">konkurencją</span>
          </h2>
          <p class="text-body-md text-on-surface-variant">
            Nowe wpisy, analizy algorytmów i case studies — bez spamu, raz w tygodniu.
          </p>
        </div>
        <div>
          <a href="/kontakt"
             class="flex items-center justify-center gap-2 bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest py-md hover:brightness-125 hover:shadow-neon active:scale-95 transition-all shadow-neon-sm">
            <span class="material-symbols-outlined text-sm">mail</span>
            Zapisz się na newsletter
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn')
  const cards      = document.querySelectorAll<HTMLElement>('.post-card')
  const emptyState = document.getElementById('empty-state')

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.filter ?? 'Wszystkie'
      filterBtns.forEach(b => {
        const active = b === btn
        b.classList.toggle('bg-neon',                 active)
        b.classList.toggle('text-on-primary',         active)
        b.classList.toggle('border-neon',             active)
        b.classList.toggle('border-outline-variant',  !active)
        b.classList.toggle('text-on-surface-variant', !active)
      })
      let visible = 0
      cards.forEach(card => {
        const match = selected === 'Wszystkie' || card.dataset.category === selected
        card.style.display = match ? '' : 'none'
        if (match) visible++
      })
      emptyState?.classList.toggle('hidden', visible > 0)
    })
  })
</script>
