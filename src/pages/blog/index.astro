---
import BaseLayout from '../../layouts/BaseLayout.astro'

const posts = [
  {
    slug: 'audyt-seo-krok-po-kroku',
    category: 'Tech SEO',
    title: 'Audyt SEO krok po kroku — kompletny przewodnik 2025',
    desc: 'Dowiedz się jak przeprowadzić pełny audyt techniczny strony. Omawiamy Core Web Vitals, crawlowanie, indeksowanie i profil linkowy.',
    date: '2026-01-15',
    readTime: '12 min',
  },
  {
    slug: 'topical-authority-budowanie',
    category: 'Strategia',
    title: 'Topical Authority — jak zbudować autorytet tematyczny domeny',
    desc: 'Topical authority to jeden z kluczowych czynników rankingowych Google w 2025. Wyjaśniamy jak projektować silosy i mapę tematyczną.',
    date: '2026-02-03',
    readTime: '9 min',
  },
  {
    slug: 'core-web-vitals-optymalizacja',
    category: 'Tech SEO',
    title: 'Core Web Vitals 2025 — jak osiągnąć zielone wyniki',
    desc: 'LCP, CLS, INP — kompleksowy przewodnik po optymalizacji Core Web Vitals dla WordPressa, Astro i niestandardowych stron.',
    date: '2026-02-20',
    readTime: '11 min',
  },
  {
    slug: 'link-building-strategie',
    category: 'Link Building',
    title: 'Link Building w 2025 — strategie które działają',
    desc: 'Guest posting, digital PR, broken link building i linkowanie wewnętrzne. Które strategie przynoszą najlepszy ROI w polskim SEO.',
    date: '2026-03-05',
    readTime: '14 min',
  },
  {
    slug: 'nlp-seo-optymalizacja-tresci',
    category: 'Content',
    title: 'NLP w SEO — jak pisać treści pod algorytmy Google',
    desc: 'Google rozumie kontekst i semantykę. Pokazujemy jak używać NLP, LSI i encji do tworzenia treści rankujących w TOP3.',
    date: '2026-03-18',
    readTime: '8 min',
  },
  {
    slug: 'local-seo-gmb-optymalizacja',
    category: 'Local SEO',
    title: 'Local SEO i Google Moja Firma — kompletny poradnik',
    desc: 'Jak zoptymalizować profil GMB, zdobyć recenzje i dominować w lokalnych wynikach Google Maps dla swojego biznesu.',
    date: '2026-04-01',
    readTime: '10 min',
  },
]

const categories = ['Wszystkie', 'Tech SEO', 'Strategia', 'Content', 'Link Building', 'Local SEO']
---

<BaseLayout
  title="Blog SEO — Poradniki, Strategie i Analizy"
  description="Blog KrPage: praktyczne poradniki SEO, analizy algorytmów Google, strategie link buildingu i content marketingu. Wiedza oparta o dane i realne wyniki."
  schemaType="webpage"
>

  <!-- HERO -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 pt-16 pb-lg relative">
    <div class="absolute -top-20 left-0 w-96 h-96 bg-neon/5 blur-[100px] rounded-full pointer-events-none"></div>
    <div class="relative z-10 mb-xl">
      <div class="section-label mb-sm">Baza wiedzy</div>
      <h1 class="text-headline-xl text-on-surface mb-md">
        Blog <span class="text-neon">SEO</span>
      </h1>
      <p class="text-body-lg text-on-surface-variant max-w-2xl">
        Praktyczna wiedza o pozycjonowaniu, technicznym SEO i strategii contentowej — oparta o dane z realnych projektów.
      </p>
    </div>

    <!-- Category filters (static, visual only) -->
    <div class="flex flex-wrap gap-2 mb-xl">
      {categories.map((cat, i) => (
        <span class:list={[
          'px-4 py-1.5 text-label-sm uppercase tracking-widest border cursor-pointer transition-all',
          i === 0
            ? 'bg-neon text-on-primary border-neon'
            : 'border-outline-variant text-on-surface-variant hover:border-neon/30 hover:text-neon',
        ]}>
          {cat}
        </span>
      ))}
    </div>

    <!-- Posts grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
      {posts.map((post, i) => (
        <article class:list={['bento-card flex flex-col group', i === 0 && 'md:col-span-2 lg:col-span-1']}>
          <!-- Color bar -->
          <div class="h-px bg-gradient-to-r from-neon to-transparent"></div>
          <div class="p-lg flex flex-col flex-1">
            <div class="flex items-center justify-between mb-sm">
              <span class="text-label-sm text-neon uppercase tracking-widest border border-neon/20 px-2 py-0.5">{post.category}</span>
              <span class="text-label-sm text-on-surface-variant">{post.readTime}</span>
            </div>
            <h2 class="text-headline-md text-on-surface mb-sm group-hover:text-neon transition-colors flex-1">
              <a href={`/blog/${post.slug}`}>{post.title}</a>
            </h2>
            <p class="text-body-md text-on-surface-variant mb-md">{post.desc}</p>
            <div class="flex items-center justify-between mt-auto pt-md border-t border-outline-variant/30">
              <span class="text-label-sm text-on-surface-variant">{post.date}</span>
              <a href={`/blog/${post.slug}`}
                 class="inline-flex items-center gap-1 text-neon text-label-sm uppercase tracking-widest group-hover:gap-3 transition-all">
                Czytaj
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl">
    <div class="bento-card p-xl relative overflow-hidden">
      <div class="absolute right-0 top-0 bottom-0 w-1/3 bg-neon/3 blur-[80px] pointer-events-none"></div>
      <div class="relative z-10 grid lg:grid-cols-2 gap-lg items-center">
        <div>
          <div class="section-label mb-sm">Wiedza prosto do skrzynki</div>
          <h2 class="text-headline-lg text-on-surface mb-sm">
            Bądź o krok przed<br /><span class="text-neon">konkurencją</span>
          </h2>
          <p class="text-body-md text-on-surface-variant">
            Nowe wpisy, analizy algorytmów i case studies — bez spamu, raz w tygodniu.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-md">
          <a href="/kontakt"
             class="flex-1 flex items-center justify-center gap-2 bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest py-md hover:brightness-110 active:scale-95 transition-all shadow-neon-sm">
            <span class="material-symbols-outlined text-sm">mail</span>
            Zapisz się
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
