---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const allPosts   = await getCollection('blog')
const latestPosts = allPosts
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 4)
---

<BaseLayout
  title="Specjalista SEO – Audyt i Pozycjonowanie Stron"
  description="KrPage – precyzyjne SEO dla firm i e-commerce. Audyty techniczne, strategie pozycjonowania i content marketing, które generują mierzalny wzrost w Google."
  schemaType="home"
>

  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 pt-16 pb-xl relative overflow-hidden">
    <div class="absolute -top-40 -left-40 w-[500px] h-[500px] bg-neon/5 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">

      <!-- Left: copy -->
      <div class="lg:col-span-7 z-10">
        <div class="section-label mb-md">
          <span class="w-2 h-2 rounded-full bg-neon animate-pulse"></span>
          System Online: Optymalizacja Aktywna
        </div>

        <p class="text-headline-xl text-on-surface mb-md">
          Architektura<br />
          <span class="text-neon">Precyzyjnego wzrostu</span><br />
          w Google
        </p>

        <p class="text-body-lg text-on-surface-variant max-w-xl mb-lg">
          Przekształcam dane w dominację rynkową. Projektuję zaawansowane ekosystemy widoczności, które skalują Twój biznes w organicznych wynikach wyszukiwania — bez skrótów, z mierzalnymi rezultatami.
        </p>

        <div class="flex flex-wrap gap-md">
          <a
            href="/kontakt"
            class="inline-flex items-center gap-2
                   bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest
                   px-lg py-md
                   hover:brightness-125 hover:shadow-neon active:scale-95 transition-all shadow-neon-sm"
          >
            <span class="material-symbols-outlined text-sm">troubleshoot</span>
            Zamów bezpłatny audyt
          </a>
          <a
            href="/uslugi"
            class="inline-flex items-center gap-2
                   border border-neon/30 text-neon font-bold text-label-md uppercase tracking-widest
                   px-lg py-md
                   hover:bg-neon/10 hover:border-neon/60 transition-all"
          >
            Zobacz usługi
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Right: profile photo -->
      <div class="lg:col-span-5 relative flex justify-center lg:justify-end">
        <div class="relative">
          <!-- Neon frame accents -->
          <div class="absolute -inset-px border border-neon/20 z-10 pointer-events-none"></div>
          <div class="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 border-neon z-20 pointer-events-none"></div>
          <div class="absolute top-0 right-0 w-8 h-8 border-t-2 border-r-2 border-neon z-20 pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 w-8 h-8 border-b-2 border-l-2 border-neon z-20 pointer-events-none"></div>
          <div class="absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 border-neon z-20 pointer-events-none"></div>
          <!-- Ambient glow behind photo -->
          <div class="absolute -inset-4 bg-neon/5 blur-2xl rounded-full pointer-events-none"></div>
          <!-- Photo -->
          <div class="overflow-hidden h-[370px] lg:h-[440px]">
            <img
              src="/images/krzysztof.jpg"
              alt="Krzysztof — KrPage, Specjalista SEO"
              class="relative z-10 w-full max-w-xs lg:max-w-sm object-cover object-top"
              style="filter: brightness(0.95) contrast(1.05);"
            />
          </div>
          <!-- Status badge -->
          <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 z-20 w-max max-w-[90%]
                      bg-[#06070f] border border-neon/30 px-3 py-1.5
                      flex items-center gap-2 shadow-neon-sm">
            <span class="w-2 h-2 rounded-full bg-neon animate-pulse shrink-0"></span>
            <span class="text-label-sm text-neon uppercase tracking-widest leading-snug">Dostępny dla nowych projektów</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SEO INTRO — H1 dla Google
  ═══════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 mb-xl">
    <div class="bento-card px-lg py-lg md:px-xl md:py-lg border-l-4 border-neon/50">
      <h1 class="text-headline-lg text-on-surface mb-md">
        <span class="block">Freelancer SEO</span>
        <span class="block text-neon">Krzysztof Parfieniuk</span>
      </h1>
      <p class="text-body-lg text-on-surface-variant max-w-4xl leading-relaxed">
        Pomagam firmom oraz sklepom internetowym przekształcać ruch z wyszukiwarki Google w przewidywalne źródło przychodów. Jako niezależny freelancer SEO, łączę zaawansowaną analitykę techniczną z precyzyjną strategią content marketingową oraz automatyzacją procesów. Działam bez pośredników – wybierając współpracę ze mną, zyskujesz bezpośredni kontakt ze specjalistą, pełną transparentność oraz działania dopasowane do specyfiki Twojego biznesu.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       STATS BENTO
  ═══════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 mb-xl">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-md">
      {[
        { icon: 'monitoring',    value: '+248%',  label: 'Średni wzrost widoczności' },
        { icon: 'query_stats',   value: '1.2M+',  label: 'Zindeksowanych fraz'       },
        { icon: 'speed',         value: '0.4s',   label: 'Średni LCP po audycie'     },
        { icon: 'rocket_launch', value: 'x5.2',   label: 'Wzrost ROI z organica'     },
      ].map(stat => (
        <div class="bento-card p-lg flex flex-col justify-between group hover:border-neon/40 transition-all">
          <div class="flex justify-between items-start mb-lg">
            <span class="material-symbols-outlined text-neon">{stat.icon}</span>
            <div class="flex items-end gap-px h-5">
              <div class="w-1 bg-neon/20 h-1/3"></div>
              <div class="w-1 bg-neon/40 h-1/2"></div>
              <div class="w-1 bg-neon/60 h-3/4"></div>
              <div class="w-1 bg-neon    h-full shadow-neon-sm"></div>
            </div>
          </div>
          <div>
            <p class="text-headline-lg text-neon mb-xs">{stat.value}</p>
            <p class="text-label-md text-on-surface-variant uppercase tracking-widest">{stat.label}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SERVICES
  ═══════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 mb-xl">
    <div class="mb-lg">
      <div class="section-label mb-sm">Protokoły operacyjne</div>
      <h2 class="text-headline-lg text-on-surface">
        Jak zwiększam<br />
        <span class="text-neon">Twoją widoczność</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
      {[
        {
          icon:    'troubleshoot',
          title:   'Audyt Techniczny SEO',
          desc:    'Pełna analiza kodu, struktury i Core Web Vitals przy użyciu autorskich skryptów diagnostycznych. Dostajesz raport z konkretnymi priorytetami napraw.',
          tags:    ['Core Web Vitals', 'Crawl Analysis', 'Indeksowanie'],
          href:    '/uslugi/audyt-seo',
        },
        {
          icon:    'hub',
          title:   'Strategia Pozycjonowania',
          desc:    'Budowa długofalowych planów penetracji rynku opartych o analizę luk w widoczności konkurencji i mapowanie fraz kluczowych.',
          tags:    ['Keyword Mapping', 'Link Building', 'Topical Authority'],
          href:    '/uslugi/pozycjonowanie',
        },
        {
          icon:    'article',
          title:   'Content Marketing SEO',
          desc:    'Tworzenie treści optymalizowanych pod NLP i silosy tematyczne, które budują autorytet domeny i konwertują ruch organiczny.',
          tags:    ['NLP Optimization', 'Silo Topics', 'SEO Copywriting'],
          href:    '/uslugi/content-marketing',
        },
      ].map(s => (
        <div class="bento-card p-lg relative overflow-hidden group flex flex-col hover:border-neon/40 hover:shadow-[0_0_24px_rgba(64,77,255,0.08)] transition-all duration-300">
          <div class="absolute top-0 right-0 p-4 text-neon/10 group-hover:text-neon/25 transition-colors">
            <span class="material-symbols-outlined text-6xl">{s.icon}</span>
          </div>
          <div class="relative z-10 flex flex-col flex-1">
            <h3 class="text-headline-md text-on-surface mb-sm">{s.title}</h3>
            <p class="text-body-md text-on-surface-variant mb-md flex-1">{s.desc}</p>
            <div class="flex flex-wrap gap-2 mb-md">
              {s.tags.map(tag => (
                <span class="px-2 py-0.5 bg-surface-container-highest border border-outline-variant text-label-sm text-on-surface-variant uppercase">
                  {tag}
                </span>
              ))}
            </div>
            <a href={s.href}
               class="inline-flex items-center gap-2 text-neon text-label-md uppercase tracking-widest
                      border-b border-neon/30 pb-0.5 hover:border-neon hover:gap-4 transition-all self-start">
              Dowiedz się więcej
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       WHY KRPAGE
  ═══════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 mb-xl">
    <div class="bg-surface-container-low border border-white/5 p-lg rounded-2xl relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-neon/5 blur-[100px] rounded-full pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-lg items-center relative z-10">
        <div>
          <div class="section-label mb-md">Dlaczego KrPage?</div>
          <h2 class="text-headline-lg text-on-surface mb-lg">
            Technologia i<br />
            <span class="text-neon">przejrzyste wyniki</span>
          </h2>

          <div class="space-y-md">
            {[
              {
                icon:  'precision_manufacturing',
                title: 'Technologiczna przewaga',
                desc:  'Korzystam z autorskich narzędzi do data-miningu i crawlingu, których nie znajdziesz w standardowych pakietach SaaS.',
              },
              {
                icon:  'security',
                title: 'Strategia White-Hat',
                desc:  'Bezpieczne, trwałe wzrosty oparte na zrozumieniu algorytmów Google — bez szybkich sztuczek, które cofną Cię na starcie.',
              },
              {
                icon:  'analytics',
                title: 'Raporty, które rozumiesz',
                desc:  'Miesięczne raporty zawierające tylko dane, które mają znaczenie dla Twojego biznesu — bez zbędnego szumu.',
              },
            ].map(item => (
              <div class="flex gap-md">
                <div class="w-10 h-10 shrink-0 bg-neon/10 border border-neon/20 flex items-center justify-center">
                  <span class="material-symbols-outlined text-neon text-base">{item.icon}</span>
                </div>
                <div>
                  <h4 class="text-label-md uppercase text-neon mb-1">{item.title}</h4>
                  <p class="text-body-md text-on-surface-variant">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Animated process steps -->
        <div id="process-steps" class="space-y-4">
          {[
            { n: '01', title: 'Analiza',       desc: 'Ekstrakcja danych z GA4, Search Console i autorskiego crawlera. Budujemy pełny obraz kondycji domeny.' },
            { n: '02', title: 'Optymalizacja', desc: 'Implementacja poprawek technicznych, on-page i content — od krytycznych po quick-wins.' },
            { n: '03', title: 'Skalowanie',    desc: 'Zarządzanie velocity linków, rozbudowa treści i monitoring rankingów w czasie rzeczywistym.' },
          ].map((step, i) => (
            <div
              data-step={i}
              class:list={[
                'process-step flex gap-4 p-4 border-l-4 transition-all duration-500',
                i === 0
                  ? 'border-neon bg-neon/5 step-active'
                  : 'border-outline-variant bg-surface-container-low opacity-50',
              ]}
            >
              <span class:list={[
                'text-headline-md font-black opacity-50 shrink-0',
                i === 0 ? 'text-neon' : 'text-on-surface-variant',
              ]}>{step.n}</span>
              <div>
                <p class="text-label-md uppercase tracking-wider text-on-surface font-bold mb-1">{step.title}</p>
                <p class="text-label-sm text-on-surface-variant">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CASE STUDY TEASER  (number counters)
  ═══════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 mb-xl">
    <div class="mb-lg">
      <div class="section-label mb-sm">Rezultaty</div>
      <h2 class="text-headline-lg text-on-surface">
        Projekty i <span class="text-neon">wyniki</span>
      </h2>
    </div>

    <div id="case-studies" class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
      {[
        { category: 'E-commerce',  prefix: '+', num: 318, suffix: '% ruchu',         period: '6 miesięcy',  desc: 'Sklep z elektroniką. Audyt techniczny + przebudowa architektury kategorii + linkbuilding.' },
        { category: 'Usługi B2B',  prefix: 'Top 3 na ', num: 47, suffix: ' fraz',    period: '4 miesiące',  desc: 'Firma consultingowa. Strategia treści oparta o topical authority w wąskiej niszy.' },
        { category: 'Local SEO',   prefix: '+', num: 520, suffix: '% w Google Maps', period: '3 miesiące',  desc: 'Sieć gabinetów medycznych. Optymalizacja GMB + lokalne silosy contentowe.' },
      ].map((cs, i) => (
        <div class="bento-card p-lg flex flex-col gap-sm hover:border-neon/40 hover:shadow-[0_0_24px_rgba(64,77,255,0.08)] transition-all duration-300 group">
          <span class="text-label-sm uppercase tracking-widest text-neon/60 font-mono">{cs.category}</span>
          <p class="text-headline-md text-neon font-black">
            {cs.prefix}<span class="counter" data-target={cs.num} data-index={i}>0</span>{cs.suffix}
          </p>
          <p class="text-label-sm text-on-surface-variant uppercase">{cs.period}</p>
          <div class="w-full h-px bg-neon/10 my-xs"></div>
          <p class="text-body-md text-on-surface-variant flex-1">{cs.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       BLOG PREVIEW
  ═══════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 mb-xl">
    <div class="flex items-end justify-between mb-lg">
      <div>
        <div class="section-label mb-sm">Baza wiedzy</div>
        <h2 class="text-headline-lg text-on-surface">
          Ostatnie wpisy <span class="text-neon">na blogu</span>
        </h2>
      </div>
      <a href="/blog"
         class="hidden sm:inline-flex items-center gap-2 border border-neon/30 text-neon text-label-sm uppercase tracking-widest px-md py-sm hover:bg-neon/10 hover:border-neon/60 transition-all">
        Wszystkie wpisy
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-gutter">
      {latestPosts.map(post => (
        <article class="bento-card overflow-hidden group hover:border-neon/40 hover:shadow-[0_0_24px_rgba(64,77,255,0.08)] transition-all duration-300 flex flex-col">
          <a href={`/blog/${post.id}`} class="block overflow-hidden h-48">
            <img
              src={post.data.image}
              alt={post.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </a>
          <div class="p-lg flex flex-col flex-1">
            <div class="flex items-center gap-2 mb-sm">
              <span class="text-label-sm text-neon uppercase tracking-widest border border-neon/20 px-2 py-0.5">{post.data.category}</span>
              <span class="text-label-sm text-on-surface-variant ml-auto">{post.data.readTime}</span>
            </div>
            <h3 class="text-headline-md text-on-surface mb-sm group-hover:text-neon transition-colors flex-1">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h3>
            <div class="flex items-center justify-between mt-auto pt-md border-t border-outline-variant/30">
              <span class="text-label-sm text-on-surface-variant">{post.data.date}</span>
              <a href={`/blog/${post.id}`}
                 class="inline-flex items-center gap-1 text-neon text-label-sm uppercase tracking-widest hover:gap-3 transition-all">
                Czytaj
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="sm:hidden mt-md text-center">
      <a href="/blog"
         class="inline-flex items-center gap-2 border border-neon/30 text-neon text-label-sm uppercase tracking-widest px-md py-sm hover:bg-neon/10 transition-all">
        Wszystkie wpisy
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CTA
  ═══════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 mb-xl">
    <div class="bento-card px-xl py-xl rounded-3xl text-center relative overflow-hidden">
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="w-[600px] h-[300px] bg-neon/5 blur-[100px] rounded-full"></div>
      </div>

      <div class="relative z-10">
        <div class="section-label mx-auto mb-md">Darmowa konsultacja</div>
        <h2 class="text-headline-xl text-on-surface mb-md">
          Gotowy na <span class="text-neon">nowy poziom</span><br />
          widoczności?
        </h2>
        <p class="text-body-lg text-on-surface-variant max-w-xl mx-auto mb-lg">
          Pierwsza analiza potencjału Twojej domeny jest bezpłatna. Umów się, a pokażę Ci konkretnie, gdzie tracisz ruch i jak to naprawić.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-md">
          <a
            href="/kontakt"
            class="inline-flex items-center justify-center gap-2
                   bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest
                   px-xl py-md hover:brightness-125 hover:shadow-neon active:scale-95 transition-all shadow-neon-sm"
          >
            <span class="material-symbols-outlined text-sm">calendar_month</span>
            Umów bezpłatny audyt
          </a>
          <a
            href="/blog"
            class="inline-flex items-center justify-center gap-2
                   border border-neon/30 text-neon font-bold text-label-md uppercase tracking-widest
                   px-xl py-md hover:bg-neon/10 hover:border-neon/60 transition-all"
          >
            Czytaj blog SEO
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  /* ── Process Steps Auto-Cycle ── */
  const steps = document.querySelectorAll<HTMLElement>('.process-step')
  let current = 0
  const TOTAL = steps.length

  function activateStep(idx: number) {
    steps.forEach((el, i) => {
      const numEl = el.querySelector<HTMLElement>('span:first-child')
      if (i === idx) {
        el.classList.add('border-neon', 'bg-neon/5', 'step-active')
        el.classList.remove('border-outline-variant', 'bg-surface-container-low', 'opacity-50')
        if (numEl) numEl.classList.replace('text-on-surface-variant', 'text-neon')
      } else {
        el.classList.remove('border-neon', 'bg-neon/5', 'step-active')
        el.classList.add('border-outline-variant', 'bg-surface-container-low', 'opacity-50')
        if (numEl) numEl.classList.replace('text-neon', 'text-on-surface-variant')
      }
    })
  }

  setInterval(() => {
    current = (current + 1) % TOTAL
    activateStep(current)
  }, 3000)

  /* ── Number Counters (IntersectionObserver) ── */
  const counters = document.querySelectorAll<HTMLElement>('.counter')
  let countersTriggered = false

  function runCounters() {
    if (countersTriggered) return
    countersTriggered = true
    counters.forEach(el => {
      const target = parseInt(el.dataset.target ?? '0', 10)
      const duration = 1800
      const start = performance.now()
      const startVal = Math.max(0, Math.floor(target * 0.02))

      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1)
        // ease-out cubic
        const eased = 1 - Math.pow(1 - progress, 3)
        el.textContent = String(Math.floor(startVal + eased * (target - startVal)))
        if (progress < 1) requestAnimationFrame(tick)
        else el.textContent = String(target)
      }
      requestAnimationFrame(tick)
    })
  }

  const caseSection = document.getElementById('case-studies')
  if (caseSection) {
    new IntersectionObserver(
      (entries) => { if (entries[0].isIntersecting) runCounters() },
      { threshold: 0.3 }
    ).observe(caseSection)
  }
</script>
