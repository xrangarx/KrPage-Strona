---
import BaseLayout from '../layouts/BaseLayout.astro'
import InlineEditor from '../components/InlineEditor.astro'
import content from '../data/pages/jak-buduje-stronki.json'

const JakBudujeContent = null

const { stack, steps, benefits, costs } = content
---

<BaseLayout
  title="Jak buduję strony klientom — KrPage"
  description="Transparentny opis procesu, narzędzi i kosztów tworzenia nowoczesnych, bezpiecznych i szybkich stron internetowych na bazie Astro + GitHub Pages."
  schemaType="webpage"
>

  <!-- ═══════ HERO ═══════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl relative overflow-hidden">
    <div class="absolute -top-20 -right-20 w-[500px] h-[500px] bg-neon/5 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="max-w-3xl relative z-10">
      <div class="section-label mb-md" data-cms="heroEyebrow">{content.heroEyebrow}</div>
      <h1 class="text-headline-xl text-on-surface mb-lg">
        <span data-cms="heroTitleL1">{content.heroTitleL1}</span><br />
        <span class="text-neon" data-cms="heroTitleAccent">{content.heroTitleAccent}</span>
      </h1>
      <p class="text-body-lg text-on-surface-variant mb-lg max-w-2xl" data-cms="heroLead">
        {content.heroLead}
      </p>

      <!-- Trzy filary -->
      <div class="grid grid-cols-3 gap-3">
        {content.pillars.map((s, i) => (
          <div class="bento-card p-md text-center">
            <p class="text-headline-lg text-neon mb-0" data-cms={`pillars.${i}.n`}>{s.n}</p>
            <p class="text-label-sm text-on-surface-variant uppercase tracking-wider mt-1" data-cms={`pillars.${i}.label`}>{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ CMS CONTENT ═══════ -->
  {JakBudujeContent && (
    <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl border-t border-surface-container-high">
      <div class="max-w-3xl prose prose-invert max-w-none
                  prose-headings:text-on-surface prose-headings:font-black
                  prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-4 prose-h2:pb-3 prose-h2:border-b prose-h2:border-outline-variant/40
                  prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-3 prose-h3:text-neon/80
                  prose-p:text-on-surface-variant prose-p:leading-relaxed prose-p:mb-5 prose-p:text-base
                  prose-li:text-on-surface-variant prose-li:leading-relaxed
                  prose-ul:my-3 prose-ol:my-3
                  prose-strong:text-on-surface prose-strong:font-semibold
                  prose-a:text-neon prose-a:no-underline hover:prose-a:underline">
        <JakBudujeContent />
      </div>
    </section>
  )}

  <!-- ═══════ DLACZEGO NIE WORDPRESS ═══════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl border-t border-surface-container-high">
    <div class="section-label mb-md" data-cms="wpEyebrow">{content.wpEyebrow}</div>
    <h2 class="text-headline-lg text-on-surface mb-lg max-w-xl" style="text-wrap:balance" data-cms="wpTitle">
      {content.wpTitle}
    </h2>

    <div class="grid md:grid-cols-2 gap-6">
      <!-- WordPress -->
      <div class="bento-card p-lg border-surface-container-high">
        <div class="flex items-center gap-3 mb-md">
          <span aria-hidden="true" class="material-symbols-outlined text-on-surface-variant" style="font-size:20px">dangerous</span>
          <h3 class="text-label-lg text-on-surface-variant uppercase tracking-wider" data-cms="wpCardTitle">{content.wpCardTitle}</h3>
        </div>
        <ul class="space-y-3">
          {content.wpCons.map((item, i) => (
            <li class="flex gap-3 text-body-sm text-on-surface-variant">
              <span aria-hidden="true" class="material-symbols-outlined flex-shrink-0" style="font-size:16px;color:rgba(255,77,109,0.7);margin-top:2px">close</span>
              <span data-cms={`wpCons.${i}`}>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- JAMstack -->
      <div class="bento-card p-lg border-neon/20" style="background:rgb(var(--tw-accent) / 0.04)">
        <div class="flex items-center gap-3 mb-md">
          <span aria-hidden="true" class="material-symbols-outlined text-neon" style="font-size:20px">verified</span>
          <h3 class="text-label-lg text-neon uppercase tracking-wider" data-cms="jamCardTitle">{content.jamCardTitle}</h3>
        </div>
        <ul class="space-y-3">
          {content.jamPros.map((item, i) => (
            <li class="flex gap-3 text-body-sm text-on-surface-variant">
              <span aria-hidden="true" class="material-symbols-outlined flex-shrink-0 text-neon" style="font-size:16px;margin-top:2px">check</span>
              <span data-cms={`jamPros.${i}`}>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════ STACK ═══════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl border-t border-surface-container-high">
    <div class="section-label mb-md" data-cms="stackEyebrow">{content.stackEyebrow}</div>
    <h2 class="text-headline-lg text-on-surface mb-lg max-w-xl" style="text-wrap:balance" data-cms="stackTitle">
      {content.stackTitle}
    </h2>

    <div class="grid md:grid-cols-3 gap-5">
      {stack.map((tool, i) => (
        <div class="bento-card p-lg hover:border-neon/30 transition-colors">
          <div class="flex items-center gap-3 mb-md">
            <div class="w-9 h-9 bg-neon/10 border border-neon/30 flex items-center justify-center flex-shrink-0">
              <span aria-hidden="true" class="material-symbols-outlined text-neon" style="font-size:18px">{tool.icon}</span>
            </div>
            <div>
              <p class="text-label-sm text-on-surface-variant uppercase tracking-wider" data-cms={`stack.${i}.role`}>{tool.role}</p>
              <p class="text-title-md text-on-surface font-bold" data-cms={`stack.${i}.name`}>{tool.name}</p>
            </div>
          </div>
          <p class="text-body-sm text-on-surface-variant mb-md" data-cms={`stack.${i}.desc`}>{tool.desc}</p>
          <div class="flex flex-wrap gap-2">
            {tool.tags.map(tag => (
              <span class="text-xs font-bold uppercase tracking-wider px-2 py-1 border border-neon/25 text-neon" style="font-size:10px">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════ WORKFLOW ═══════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl border-t border-surface-container-high">
    <div class="section-label mb-md" data-cms="workflowEyebrow">{content.workflowEyebrow}</div>
    <h2 class="text-headline-lg text-on-surface mb-lg max-w-xl" style="text-wrap:balance" data-cms="workflowTitle">
      {content.workflowTitle}
    </h2>

    <div class="max-w-3xl space-y-0">
      {steps.map((step, i) => (
        <div class="flex gap-6 relative">
          {/* vertical line */}
          {i < steps.length - 1 && (
            <div class="absolute left-[19px] top-[48px] bottom-0 w-px bg-neon/15"></div>
          )}
          {/* number */}
          <div class="w-10 h-10 border border-neon/30 flex items-center justify-center flex-shrink-0 z-10" style="background:rgb(var(--tw-accent) / 0.08)">
            <span class="text-neon font-bold" style="font-size:13px;font-family:monospace">{step.n}</span>
          </div>
          {/* content */}
          <div class="pb-10">
            <h3 class="text-title-md text-on-surface font-bold mb-2" style="text-wrap:balance" data-cms={`steps.${i}.title`}>{step.title}</h3>
            <p class="text-body-sm text-on-surface-variant mb-3" data-cms={`steps.${i}.desc`}>{step.desc}</p>
            <code class="text-xs text-neon bg-surface-container px-2 py-1" style="font-size:11px" data-cms={`steps.${i}.detail`}>{step.detail}</code>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════ BENEFITY ═══════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl border-t border-surface-container-high">
    <div class="section-label mb-md" data-cms="benefitsEyebrow">{content.benefitsEyebrow}</div>
    <h2 class="text-headline-lg text-on-surface mb-lg max-w-xl" style="text-wrap:balance" data-cms="benefitsTitle">
      {content.benefitsTitle}
    </h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {benefits.map((b, i) => (
        <div class="bento-card p-lg hover:border-neon/30 transition-colors">
          <div class="flex items-start gap-3">
            <span aria-hidden="true" class="material-symbols-outlined text-neon flex-shrink-0" style="font-size:20px;margin-top:1px">{b.icon}</span>
            <div>
              <h3 class="text-title-sm text-on-surface font-bold mb-2" data-cms={`benefits.${i}.title`}>{b.title}</h3>
              <p class="text-body-sm text-on-surface-variant" data-cms={`benefits.${i}.desc`}>{b.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════ KOSZTY ═══════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl border-t border-surface-container-high">
    <div class="section-label mb-md" data-cms="costsEyebrow">{content.costsEyebrow}</div>
    <h2 class="text-headline-lg text-on-surface mb-lg max-w-xl" style="text-wrap:balance" data-cms="costsTitle">
      {content.costsTitle}
    </h2>

    <div class="max-w-2xl">
      <div class="border border-surface-container-high" style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums">
          <thead>
            <tr style="border-bottom:1px solid rgb(var(--tw-accent) / 0.14)">
              <th class="text-label-sm text-on-surface-variant uppercase tracking-wider" style="text-align:left;padding:10px 20px;font-size:10px">Składnik</th>
              <th class="text-label-sm text-on-surface-variant uppercase tracking-wider" style="text-align:left;padding:10px 20px;font-size:10px">Koszt</th>
              <th class="text-label-sm text-on-surface-variant uppercase tracking-wider" style="text-align:left;padding:10px 20px;font-size:10px">Uwagi</th>
            </tr>
          </thead>
          <tbody>
            {costs.map((row, i) => (
              <tr style={`border-bottom:1px solid rgb(var(--tw-accent) / 0.08);${i===costs.length-1?'border-bottom:none':''}`}>
                <td class="text-body-sm text-on-surface font-medium" style="padding:11px 20px" data-cms={`costs.${i}.item`}>{row.item}</td>
                <td style="padding:11px 20px">
                  <span class={row.cost === '0 zł' ? 'text-neon' : 'text-on-surface'}
                        style="font-family:monospace;font-size:13px;font-weight:700" data-cms={`costs.${i}.cost`}>
                    {row.cost}
                  </span>
                </td>
                <td class="text-body-sm text-on-surface-variant" style="padding:11px 20px" data-cms={`costs.${i}.note`}>{row.note}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr style="border-top:1px solid rgb(var(--tw-accent) / 0.2)">
              <td class="text-on-surface font-bold" style="padding:14px 20px" data-cms="costsTotalLabel">{content.costsTotalLabel}</td>
              <td style="padding:14px 20px">
                <span class="text-on-surface font-bold" style="font-family:monospace;font-size:14px" data-cms="costsTotalValue">{content.costsTotalValue}</span>
              </td>
              <td class="text-body-sm text-on-surface-variant" style="padding:14px 20px" data-cms="costsTotalNote">{content.costsTotalNote}</td>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- CTA -->
      <div class="bento-card p-lg mt-6 border-neon/25" style="background:rgb(var(--tw-accent) / 0.04)">
        <h3 class="text-title-md text-on-surface font-bold mb-3" style="text-wrap:balance" data-cms="ctaTitle">
          {content.ctaTitle}
        </h3>
        <p class="text-body-sm text-on-surface-variant mb-md" data-cms="ctaBody">
          {content.ctaBody}
        </p>
        <a href="/kontakt" class="btn-neon inline-flex items-center gap-2">
          <span aria-hidden="true" class="material-symbols-outlined" style="font-size:16px">send</span>
          <span data-cms="ctaBtn">{content.ctaBtn}</span>
        </a>
      </div>
    </div>
  </section>

  <InlineEditor contentPath="src/data/pages/jak-buduje-stronki.json" />

</BaseLayout>
