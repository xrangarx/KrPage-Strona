---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const allCases = await getCollection('realizacje')
const cases    = allCases.sort((a, b) => a.data.title.localeCompare(b.data.title))
const typeFilters = ['Wszystkie', 'SEO', 'Strona']
---

<BaseLayout
  title="Jak działam — Case Studies SEO i Realizacje Stron"
  description="Realne wyniki z projektów SEO i tworzenia stron. Case studies z e-commerce, B2B, Local SEO i personal brand. Sprawdź jak wygląda współpraca z KrPage."
  schemaType="webpage"
>

  <section class="max-w-7xl mx-auto px-6 md:px-12 pt-16 pb-lg relative">
    <div class="absolute -top-20 right-0 w-96 h-96 bg-neon/5 blur-[100px] rounded-full pointer-events-none"></div>
    <div class="relative z-10 mb-xl">
      <div class="section-label mb-sm">Realizacje i wyniki</div>
      <h1 class="text-headline-xl text-on-surface mb-md">
        Jak <span class="text-neon">działam</span>
      </h1>
      <p class="text-body-lg text-on-surface-variant max-w-2xl">
        Konkretne projekty, konkretne liczby. Poniżej znajdziesz case studies z pozycjonowania SEO oraz realizacji stron internetowych — bez upiększeń, z prawdziwymi wynikami.
      </p>
    </div>

    <!-- Type filters -->
    <div class="flex flex-wrap gap-2 mb-xl">
      {typeFilters.map((t, i) => (
        <button
          data-filter={t}
          class:list={[
            'type-filter px-4 py-1.5 text-label-sm uppercase tracking-widest border transition-all',
            i === 0
              ? 'bg-neon text-on-primary border-neon'
              : 'border-outline-variant text-on-surface-variant hover:border-neon/40 hover:text-neon',
          ]}
        >
          {t === 'Wszystkie' ? 'Wszystkie realizacje' : t === 'SEO' ? 'Pozycjonowanie SEO' : 'Realizacje stron'}
        </button>
      ))}
    </div>

    <!-- Cases list -->
    <div class="space-y-6" id="cases-list">
      {cases.map(c => (
        <article
          data-type={c.data.type}
          class="case-card bento-card overflow-hidden group hover:border-neon/40 transition-all duration-300"
        >
          <div class="flex flex-col sm:flex-row">
            <div class="sm:w-72 lg:w-80 shrink-0 overflow-hidden relative">
              <img
                src={c.data.image}
                alt={c.data.title}
                class="w-full h-52 sm:h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute top-3 left-3 bg-[#06070f]/90 border border-neon/30 px-3 py-1.5 backdrop-blur-sm">
                <p class="text-neon font-black text-headline-md leading-none">{c.data.result}</p>
                <p class="text-label-sm text-on-surface-variant uppercase leading-tight">{c.data.resultLabel}</p>
              </div>
            </div>
            <div class="flex flex-col justify-between p-lg flex-1">
              <div>
                <div class="flex items-center flex-wrap gap-2 mb-sm">
                  <span class:list={[
                    'text-label-sm uppercase tracking-widest border px-2 py-0.5 font-bold',
                    c.data.type === 'SEO'
                      ? 'text-neon border-neon/30 bg-neon/5'
                      : 'text-[#5DADE2] border-[#5DADE2]/30 bg-[#5DADE2]/5',
                  ]}>
                    {c.data.type === 'SEO' ? 'Pozycjonowanie' : 'Strona www'}
                  </span>
                  <span class="text-label-sm text-on-surface-variant border border-outline-variant px-2 py-0.5 uppercase">
                    {c.data.industry}
                  </span>
                  <span class="text-label-sm text-on-surface-variant ml-auto">Czas: {c.data.period}</span>
                </div>
                <h2 class="text-headline-md text-on-surface mb-sm group-hover:text-neon transition-colors">
                  {c.data.title}
                </h2>
              </div>
              <div class="mt-md pt-md border-t border-outline-variant/30 flex flex-wrap items-center gap-2">
                {c.data.tags.map((tag: string) => (
                  <span class="px-2 py-0.5 bg-surface-container-highest border border-outline-variant text-label-sm text-on-surface-variant uppercase">
                    {tag}
                  </span>
                ))}
                <a href="/kontakt"
                   class="ml-auto inline-flex items-center gap-2 text-neon text-label-sm uppercase tracking-widest border-b border-neon/30 pb-0.5 hover:border-neon hover:gap-4 transition-all shrink-0">
                  Podobny projekt
                  <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div id="empty-state" class="hidden text-center py-xl">
      <span class="material-symbols-outlined text-neon/30 text-5xl mb-md block">search_off</span>
      <p class="text-body-lg text-on-surface-variant">Brak realizacji w tej kategorii.</p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl">
    <div class="bento-card p-xl text-center relative overflow-hidden">
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="w-[600px] h-[300px] bg-neon/5 blur-[100px] rounded-full"></div>
      </div>
      <div class="relative z-10">
        <div class="section-label mx-auto mb-md">Twoja kolej</div>
        <h2 class="text-headline-lg text-on-surface mb-md">
          Chcesz podobnych wyników?<br />
          <span class="text-neon">Zacznij od bezpłatnej analizy.</span>
        </h2>
        <div class="flex flex-col sm:flex-row justify-center gap-md">
          <a href="/kontakt"
             class="inline-flex items-center justify-center gap-2 bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest px-xl py-md hover:brightness-125 hover:shadow-neon active:scale-95 transition-all shadow-neon-sm">
            <span class="material-symbols-outlined text-sm">calendar_month</span>
            Umów konsultację
          </a>
          <a href="/uslugi"
             class="inline-flex items-center justify-center gap-2 border border-neon/30 text-neon font-bold text-label-md uppercase tracking-widest px-xl py-md hover:bg-neon/10 hover:border-neon/60 transition-all">
            Zobacz usługi
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.type-filter')
  const cards      = document.querySelectorAll<HTMLElement>('.case-card')
  const emptyState = document.getElementById('empty-state')

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.filter ?? 'Wszystkie'
      filterBtns.forEach(b => {
        const active = b === btn
        b.classList.toggle('bg-neon',                 active)
        b.classList.toggle('text-on-primary',         active)
        b.classList.toggle('border-neon',             active)
        b.classList.toggle('border-outline-variant',  !active)
        b.classList.toggle('text-on-surface-variant', !active)
      })
      let visible = 0
      cards.forEach(card => {
        const match = selected === 'Wszystkie' || card.dataset.type === selected
        card.style.display = match ? '' : 'none'
        if (match) visible++
      })
      emptyState?.classList.toggle('hidden', visible > 0)
    })
  })
</script>
