---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactForm from '../components/ContactForm.astro'
import InlineEditor from '../components/InlineEditor.astro'
import content from '../data/pages/kontakt.json'
import { SITE } from '../data/site'

const KontaktContent = null
---

<BaseLayout
  title="Kontakt — Zamów Bezpłatny Audyt SEO"
  description="Skontaktuj się z KrPage — specjalistą SEO. Bezpłatna analiza domeny, konsultacja strategiczna i wycena usług SEO. Odpowiadam w ciągu 24 godzin."
  schemaType="webpage"
>

  <section class="max-w-7xl mx-auto px-6 md:px-12 pt-16 pb-xl relative overflow-hidden">
    <div class="absolute -top-20 -right-20 w-[400px] h-[400px] bg-neon/5 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="grid lg:grid-cols-2 gap-xl items-start">

      <!-- Left: info -->
      <div class="relative z-10">
        <div class="section-label mb-md" data-cms="heroEyebrow">{content.heroEyebrow}</div>
        <h1 class="text-headline-xl text-on-surface mb-md">
          <span data-cms="heroTitleL1">{content.heroTitleL1}</span><br /><span class="text-neon" data-cms="heroTitleAccent">{content.heroTitleAccent}</span>
        </h1>
        <p class="text-body-lg text-on-surface-variant mb-xl max-w-lg" data-cms="heroLead">
          {content.heroLead}
        </p>

        <!-- Contact details -->
        <div class="space-y-md mb-xl">
          <a href={`mailto:${SITE.email}`}
             class="flex items-center gap-md group">
            <div class="w-12 h-12 bento-card flex items-center justify-center group-hover:border-neon/40 transition-all">
              <span aria-hidden="true" class="material-symbols-outlined text-neon">mail</span>
            </div>
            <div>
              <p class="text-label-sm text-on-surface-variant uppercase" data-cms="emailLabel">{content.emailLabel}</p>
              <p class="text-body-md text-on-surface group-hover:text-neon transition-colors">{SITE.email}</p>
            </div>
          </a>
          <a href={`tel:${SITE.phone.replace(/\s/g,'')}`}
             class="flex items-center gap-md group">
            <div class="w-12 h-12 bento-card flex items-center justify-center group-hover:border-neon/40 transition-all">
              <span aria-hidden="true" class="material-symbols-outlined text-neon">phone</span>
            </div>
            <div>
              <p class="text-label-sm text-on-surface-variant uppercase" data-cms="phoneLabel">{content.phoneLabel}</p>
              <p class="text-body-md text-on-surface group-hover:text-neon transition-colors">{SITE.phone}</p>
            </div>
          </a>
          <div class="flex items-center gap-md">
            <div class="w-12 h-12 bento-card flex items-center justify-center">
              <span aria-hidden="true" class="material-symbols-outlined text-neon">location_on</span>
            </div>
            <div>
              <p class="text-label-sm text-on-surface-variant uppercase" data-cms="locationLabel">{content.locationLabel}</p>
              <p class="text-body-md text-on-surface">{SITE.address.city}, {SITE.address.country}</p>
            </div>
          </div>
        </div>

        <!-- Social -->
        <div class="flex gap-md">
          <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer"
             class="flex items-center gap-2 border border-outline-variant px-md py-sm text-label-sm text-on-surface-variant hover:border-neon/40 hover:text-neon transition-all uppercase tracking-widest">
            <span aria-hidden="true" class="material-symbols-outlined text-base">link</span>
            LinkedIn
          </a>
          <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer"
             class="flex items-center gap-2 border border-outline-variant px-md py-sm text-label-sm text-on-surface-variant hover:border-neon/40 hover:text-neon transition-all uppercase tracking-widest">
            <span aria-hidden="true" class="material-symbols-outlined text-base">group</span>
            Facebook
          </a>
        </div>

        <!-- Response time badge -->
        <div class="mt-xl flex items-center gap-2 text-label-sm text-on-surface-variant">
          <span class="w-2 h-2 rounded-full bg-neon animate-pulse"></span>
          <span data-cms="responseText">{content.responseText}</span> <span class="text-neon font-bold" data-cms="responseValue">{content.responseValue}</span>
        </div>

        {KontaktContent && (
          <div class="mt-xl prose prose-invert max-w-none
                      prose-headings:text-on-surface prose-headings:font-black
                      prose-h2:text-xl prose-h2:mt-6 prose-h2:mb-3 prose-h2:pb-2 prose-h2:border-b prose-h2:border-outline-variant/40
                      prose-h3:text-lg prose-h3:mt-4 prose-h3:mb-2 prose-h3:text-neon/80
                      prose-p:text-on-surface-variant prose-p:leading-relaxed prose-p:mb-4 prose-p:text-base
                      prose-li:text-on-surface-variant prose-li:leading-relaxed
                      prose-ul:my-3 prose-ol:my-3
                      prose-strong:text-on-surface prose-strong:font-semibold
                      prose-a:text-neon prose-a:no-underline hover:prose-a:underline">
            <KontaktContent />
          </div>
        )}
      </div>

      <!-- Right: form -->
      <ContactForm />

    </div>
  </section>

  <InlineEditor contentPath="src/data/pages/kontakt.json" />

</BaseLayout>
