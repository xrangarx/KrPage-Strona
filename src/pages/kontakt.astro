---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../data/site'
---

<BaseLayout
  title="Kontakt — Zamów Bezpłatny Audyt SEO"
  description="Skontaktuj się z KrPage — specjalistą SEO. Bezpłatna analiza domeny, konsultacja strategiczna i wycena usług SEO. Odpowiadam w ciągu 24 godzin."
  schemaType="webpage"
>

  <section class="max-w-7xl mx-auto px-6 md:px-12 pt-16 pb-xl relative overflow-hidden">
    <div class="absolute -top-20 -right-20 w-[400px] h-[400px] bg-neon/5 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="grid lg:grid-cols-2 gap-xl items-start">

      <!-- Left: info -->
      <div class="relative z-10">
        <div class="section-label mb-md">Inicjuj kontakt</div>
        <h1 class="text-headline-xl text-on-surface mb-md">
          Zacznijmy<br /><span class="text-neon">Twój projekt</span>
        </h1>
        <p class="text-body-lg text-on-surface-variant mb-xl max-w-lg">
          Pierwsza analiza domeny jest bezpłatna. Powiedz mi o swojej stronie, a pokażę Ci konkretnie, gdzie tracisz ruch i jak to naprawić.
        </p>

        <!-- Contact details -->
        <div class="space-y-md mb-xl">
          <a href={`mailto:${SITE.email}`}
             class="flex items-center gap-md group">
            <div class="w-12 h-12 bento-card flex items-center justify-center group-hover:border-neon/40 transition-all">
              <span class="material-symbols-outlined text-neon">mail</span>
            </div>
            <div>
              <p class="text-label-sm text-on-surface-variant uppercase">Email</p>
              <p class="text-body-md text-on-surface group-hover:text-neon transition-colors">{SITE.email}</p>
            </div>
          </a>
          <a href={`tel:${SITE.phone.replace(/\s/g,'')}`}
             class="flex items-center gap-md group">
            <div class="w-12 h-12 bento-card flex items-center justify-center group-hover:border-neon/40 transition-all">
              <span class="material-symbols-outlined text-neon">phone</span>
            </div>
            <div>
              <p class="text-label-sm text-on-surface-variant uppercase">Telefon</p>
              <p class="text-body-md text-on-surface group-hover:text-neon transition-colors">{SITE.phone}</p>
            </div>
          </a>
          <div class="flex items-center gap-md">
            <div class="w-12 h-12 bento-card flex items-center justify-center">
              <span class="material-symbols-outlined text-neon">location_on</span>
            </div>
            <div>
              <p class="text-label-sm text-on-surface-variant uppercase">Lokalizacja</p>
              <p class="text-body-md text-on-surface">{SITE.address.city}, {SITE.address.country}</p>
            </div>
          </div>
        </div>

        <!-- Social -->
        <div class="flex gap-md">
          <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer"
             class="flex items-center gap-2 border border-outline-variant px-md py-sm text-label-sm text-on-surface-variant hover:border-neon/40 hover:text-neon transition-all uppercase tracking-widest">
            <span class="material-symbols-outlined text-base">link</span>
            LinkedIn
          </a>
          <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer"
             class="flex items-center gap-2 border border-outline-variant px-md py-sm text-label-sm text-on-surface-variant hover:border-neon/40 hover:text-neon transition-all uppercase tracking-widest">
            <span class="material-symbols-outlined text-base">group</span>
            Facebook
          </a>
        </div>

        <!-- Response time badge -->
        <div class="mt-xl flex items-center gap-2 text-label-sm text-on-surface-variant">
          <span class="w-2 h-2 rounded-full bg-neon animate-pulse"></span>
          Średni czas odpowiedzi: <span class="text-neon font-bold">&lt; 24h</span>
        </div>
      </div>

      <!-- Right: form -->
      <div class="bento-card p-lg relative">
        <div class="absolute -top-3 -left-3 bg-neon text-on-primary px-3 py-1 text-label-sm font-bold uppercase tracking-widest">
          Bezpłatna konsultacja
        </div>

        <form
          name="kontakt"
          method="POST"
          data-netlify="true"
          class="space-y-md mt-md"
        >
          <input type="hidden" name="form-name" value="kontakt" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
            <div>
              <label class="block text-label-sm text-on-surface-variant uppercase mb-2" for="name">Imię i Nazwisko</label>
              <input
                id="name" name="name" type="text" required
                placeholder="Jan Kowalski"
                class="w-full bg-surface-container border border-outline-variant focus:border-neon text-on-surface p-md text-body-md transition-colors outline-none"
              />
            </div>
            <div>
              <label class="block text-label-sm text-on-surface-variant uppercase mb-2" for="email">Email</label>
              <input
                id="email" name="email" type="email" required
                placeholder="jan@firma.pl"
                class="w-full bg-surface-container border border-outline-variant focus:border-neon text-on-surface p-md text-body-md transition-colors outline-none"
              />
            </div>
          </div>

          <div>
            <label class="block text-label-sm text-on-surface-variant uppercase mb-2" for="url">URL Strony</label>
            <input
              id="url" name="url" type="url"
              placeholder="https://twojadomena.pl"
              class="w-full bg-surface-container border border-outline-variant focus:border-neon text-on-surface p-md text-body-md transition-colors outline-none"
            />
          </div>

          <div>
            <label class="block text-label-sm text-on-surface-variant uppercase mb-2" for="service">Interesuje mnie</label>
            <select
              id="service" name="service"
              class="w-full bg-surface-container border border-outline-variant focus:border-neon text-on-surface p-md text-body-md transition-colors outline-none"
            >
              <option value="">Wybierz usługę</option>
              <option>Audyt SEO</option>
              <option>Pozycjonowanie stron</option>
              <option>Content Marketing</option>
              <option>Konsultacja strategiczna</option>
              <option>Inny temat</option>
            </select>
          </div>

          <div>
            <label class="block text-label-sm text-on-surface-variant uppercase mb-2" for="message">Wiadomość</label>
            <textarea
              id="message" name="message" rows="5"
              placeholder="Opisz swoją sytuację — co Cię boli i czego oczekujesz..."
              class="w-full bg-surface-container border border-outline-variant focus:border-neon text-on-surface p-md text-body-md transition-colors outline-none resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full flex items-center justify-center gap-2 bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest py-md hover:brightness-110 active:scale-95 transition-all shadow-neon-sm"
          >
            <span class="material-symbols-outlined text-sm">send</span>
            Wyślij wiadomość
          </button>

          <p class="text-label-sm text-center text-on-surface-variant/50 uppercase">
            Odpowiadam na każdą wiadomość w ciągu 24h roboczych
          </p>
        </form>
      </div>

    </div>
  </section>

</BaseLayout>
