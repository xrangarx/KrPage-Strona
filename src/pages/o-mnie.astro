<script>
  /* ── Stat Counters (IntersectionObserver) ── */
  const counters = document.querySelectorAll<HTMLElement>('.stat-counter')
  const bars     = document.querySelectorAll<HTMLElement>('[data-bar]')
  let triggered  = false

  function runStats() {
    if (triggered) return
    triggered = true

    counters.forEach(el => {
      const target   = parseInt(el.dataset.target ?? '0', 10)
      const duration = 1600
      const start    = performance.now()

      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1)
        const eased    = 1 - Math.pow(1 - progress, 3)
        el.textContent = String(Math.floor(eased * target))
        if (progress < 1) requestAnimationFrame(tick)
        else el.textContent = String(target)
      }
      requestAnimationFrame(tick)
    })

    bars.forEach(bar => {
      const w = bar.dataset.bar ?? '0'
      requestAnimationFrame(() => {
        bar.style.width = w + '%'
      })
    })
  }

  const statsGrid = document.getElementById('stats-grid')
  if (statsGrid) {
    new IntersectionObserver(
      entries => { if (entries[0].isIntersecting) runStats() },
      { threshold: 0.3 }
    ).observe(statsGrid)
  }

  /* ── Tools Auto-Cycle ── */
  const toolCards = document.querySelectorAll<HTMLElement>('.tool-card')
  let toolIdx = 0

  function activateTool(idx: number) {
    toolCards.forEach((card, i) => {
      const iconBox = card.querySelector<HTMLElement>('.w-12')
      if (i === idx) {
        card.classList.remove('opacity-70')
        card.classList.add('border-neon/40', 'shadow-[0_0_20px_rgba(45,255,95,0.08)]')
        if (iconBox) {
          iconBox.classList.replace('bg-surface-container-highest', 'bg-neon/10')
          iconBox.classList.replace('border-white/5', 'border-neon/40')
        }
      } else {
        card.classList.add('opacity-70')
        card.classList.remove('border-neon/40', 'shadow-[0_0_20px_rgba(45,255,95,0.08)]')
        if (iconBox) {
          iconBox.classList.replace('bg-neon/10', 'bg-surface-container-highest')
          iconBox.classList.replace('border-neon/40', 'border-white/5')
        }
      }
    })
  }

  setInterval(() => {
    toolIdx = (toolIdx + 1) % toolCards.length
    activateTool(toolIdx)
  }, 2000)

  /* ── Career Modal ── */
  const modal     = document.getElementById('career-modal')!
  const openBtn   = document.getElementById('open-career-modal')!
  const closeBtn  = document.getElementById('close-career-modal')!
  const backdrop  = document.getElementById('modal-backdrop')!

  function openModal() {
    modal.classList.remove('hidden')
    modal.classList.add('flex')
    document.body.style.overflow = 'hidden'
  }

  function closeModal() {
    modal.classList.add('hidden')
    modal.classList.remove('flex')
    document.body.style.overflow = ''
  }

  openBtn.addEventListener('click', openModal)
  closeBtn.addEventListener('click', closeModal)
  backdrop.addEventListener('click', closeModal)
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal()
  })
</script>
