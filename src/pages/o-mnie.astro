---
import BaseLayout from '../layouts/BaseLayout.astro'

const timeline = [
  {
    period: '09.2019 – 10.2020',
    year: '2019',
    company: 'WENET',
    role: 'Web Developer Joomla',
    desc: 'Tworzenie stron na podstawie szablonów graficznych, implementacja treści i funkcjonalności, walidacja kodu źródłowego.',
    tags: ['Joomla', 'HTML/CSS', 'RWD'],
  },
  {
    period: '11.2020 – 05.2022',
    year: '2020',
    company: 'WENET',
    role: 'Specjalista ds. Kontroli Jakości WEB',
    desc: 'Testy manualne stron i sklepów, audyty On-Site, dbanie o UX/UI i RWD, tworzenie dokumentacji technicznej dla deweloperów.',
    tags: ['QA', 'UX/UI', 'On-Site SEO'],
  },
  {
    period: '06.2022 – 03.2024',
    year: '2022',
    company: 'WENET',
    role: 'Specjalista ds. SEO',
    desc: 'Strategia SEO, audyty, link building, analiza słów kluczowych, monitoring efektów dla portfela klientów, współpraca z programistami i copywriterami.',
    tags: ['SEO', 'Link Building', 'Keyword Research'],
  },
  {
    period: '04.2024 – 06.2024',
    year: '2024',
    company: 'Dynamic Solutions',
    role: 'Digital Marketing Specialist',
    desc: 'Strategia i audyt SEO dla StreamX.dev, optymalizacja on-page, analiza UX/UI, tworzenie dokumentacji technicznej i guide-ów contentowych.',
    tags: ['SEO Strategy', 'UX Audit', 'Tech Docs'],
  },
  {
    period: '07.2024 – obecnie',
    year: '2024+',
    company: 'Ćwierkają.pl',
    role: 'Senior SEO & MarTech Specialist',
    desc: 'Freelancer B2B: audyty, strategia, content, link building, automatyzacje n8n, vibecoding narzędzi SEO (Claude Code + Antigravity), budowa zapleczy blogowych.',
    tags: ['SEO', 'n8n', 'MarTech', 'Vibe Coding'],
    current: true,
  },
]

const tools = [
  { icon: 'query_stats',  name: 'Google Analytics 4',  desc: 'Głęboka analiza behawioralna i atrybucja konwersji w czasie rzeczywistym.' },
  { icon: 'search_check', name: 'Search Console',       desc: 'Monitoring zdrowia domeny i precyzyjna diagnostyka widoczności organicznej.' },
  { icon: 'monitoring',   name: 'Ahrefs',               desc: 'Agresywna analiza konkurencji i inżynieria profilu linkowego.' },
  { icon: 'bug_report',   name: 'Screaming Frog',       desc: 'Techniczne audyty crawlerem w celu eliminacji błędów strukturalnych.' },
  { icon: 'bar_chart',    name: 'Senuto / Semstorm',    desc: 'Analiza widoczności, fraz kluczowych i pozycji w polskim ekosystemie.' },
  { icon: 'code',         name: 'LibreCrawl',           desc: 'Autorski crawler do zaawansowanej analizy struktury i linkowania wewnętrznego.' },
  { icon: 'table_chart',  name: 'Google Data Studio',   desc: 'Przejrzyste dashboardy i raporty dopasowane do potrzeb klienta.' },
  { icon: 'psychology',   name: 'SurferSEO / Neuron',   desc: 'NLP-driven optymalizacja treści pod topical authority i semantykę.' },
]
---

<BaseLayout
  title="O mnie — Specjalista SEO Krzysztof Parfieniuk"
  description="Poznaj KrPage — specjalistę SEO z wieloletnim doświadczeniem w audytach technicznych, strategii pozycjonowania i content marketingu dla firm i e-commerce."
  schemaType="webpage"
>

  <!-- ═══════ HERO ═══════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl grid md:grid-cols-12 gap-lg items-center relative overflow-hidden">
    <div class="absolute -top-20 -left-20 w-[500px] h-[500px] bg-neon/5 blur-[120px] rounded-full pointer-events-none"></div>

    <!-- Left: copy + stats -->
    <div class="md:col-span-7 z-10">
      <div class="section-label mb-md">Senior SEO & MarTech Specialist</div>
      <h1 class="text-headline-xl text-on-surface mb-md">
        Krzysztof<br />
        <span class="text-neon">Parfieniuk</span>
      </h1>
      <p class="text-body-lg text-on-surface-variant mb-lg max-w-2xl">
        Specjalista SEO i MarTech z ponad 6-letnim doświadczeniem w agencjach i freelance B2B. Łączę precyzję danych z automatyzacją procesów — audyty, strategie, link building i własne narzędzia SEO budowane w n8n i Claude Code.
      </p>

      <!-- Animated stats -->
      <div id="stats-grid" class="grid grid-cols-2 gap-sm">
        {[
          { icon: 'show_chart',   target: 6,   suffix: '+',  label: 'Lat doświadczenia',       bar: 85 },
          { icon: 'groups',       target: 50,  suffix: '+',  label: 'Obsłużonych klientów',    bar: 72 },
          { icon: 'trending_up',  target: 120, suffix: '+',  label: 'Projektów SEO',           bar: 78 },
          { icon: 'rocket_launch',target: 99,  suffix: '%',  label: 'PageSpeed po optymalizacji', bar: 99 },
        ].map((s, i) => (
          <div class="bento-card p-md relative overflow-hidden hover:border-neon/40 transition-all">
            <div class="absolute top-2 right-2 text-neon/15">
              <span class="material-symbols-outlined text-3xl">{s.icon}</span>
            </div>
            <p class="text-headline-lg text-neon mb-0">
              <span class="stat-counter" data-target={s.target} data-suffix={s.suffix}>0</span>{s.suffix}
            </p>
            <p class="text-label-sm text-on-surface-variant uppercase mb-sm">{s.label}</p>
            <div class="h-px w-full bg-surface-container-high mt-sm">
              <div class="h-full bg-neon transition-all duration-1000" style={`width:0%`} data-bar={s.bar}></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Right: photo -->
    <div class="md:col-span-5 relative flex justify-center md:justify-end">
      <div class="relative">
        <div class="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 border-neon z-20 pointer-events-none"></div>
        <div class="absolute top-0 right-0 w-8 h-8 border-t-2 border-r-2 border-neon z-20 pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-8 h-8 border-b-2 border-l-2 border-neon z-20 pointer-events-none"></div>
        <div class="absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 border-neon z-20 pointer-events-none"></div>
        <div class="absolute -inset-px border border-neon/20 z-10 pointer-events-none"></div>
        <div class="absolute -inset-4 bg-neon/5 blur-2xl rounded-full pointer-events-none"></div>
        <img
          src="/images/krzysztof-9925.jpg"
          alt="Krzysztof Parfieniuk — Senior SEO & MarTech Specialist"
          class="relative z-10 w-full max-w-xs lg:max-w-sm object-cover object-top"
          style="filter: brightness(0.95) contrast(1.05);"
        />
        <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 z-20
                    bg-[#050A07] border border-neon/30 px-4 py-1.5
                    flex items-center gap-2 whitespace-nowrap shadow-neon-sm">
          <span class="w-2 h-2 rounded-full bg-neon animate-pulse"></span>
          <span class="text-label-sm text-neon uppercase tracking-widest">Dostępny dla nowych projektów</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ NARZĘDZIA z auto-cycle ═══════ -->
  <section class="bg-surface-container-low py-xl border-y border-white/5 relative overflow-hidden">
    <div class="absolute right-0 top-0 w-1/3 h-full bg-neon/3 blur-[100px] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
      <div class="flex flex-col md:flex-row justify-between items-end mb-lg gap-md">
        <div>
          <div class="section-label mb-sm">Digital Command Center</div>
          <h2 class="text-headline-lg text-on-surface">Narzędzia które<br /><span class="text-neon">dają przewagę</span></h2>
          <p class="text-body-md text-on-surface-variant max-w-xl mt-sm">
            Wykorzystuję najnowocześniejszy stack technologiczny do mapowania drogi na szczyt wyników Google.
          </p>
        </div>
        <span class="text-label-sm border border-neon/20 px-3 py-1 text-neon uppercase tracking-widest whitespace-nowrap">v2.4 Enterprise</span>
      </div>

      <div id="tools-grid" class="grid grid-cols-1 md:grid-cols-4 gap-sm">
        {tools.map((tool, i) => (
          <div
            data-tool={i}
            class:list={[
              'tool-card bento-card p-lg transition-all duration-500',
              i === 0 ? 'border-neon/40 shadow-[0_0_20px_rgba(45,255,95,0.08)]' : 'opacity-70',
            ]}
          >
            <div class:list={[
              'w-12 h-12 mb-md flex items-center justify-center border transition-all',
              i === 0 ? 'bg-neon/10 border-neon/40' : 'bg-surface-container-highest border-white/5',
            ]}>
              <span class="material-symbols-outlined text-neon">{tool.icon}</span>
            </div>
            <h3 class="text-headline-md text-on-surface mb-sm">{tool.name}</h3>
            <p class="text-label-sm text-on-surface-variant leading-relaxed">{tool.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ TIMELINE ═══════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl">
    <div class="section-label mb-sm">Ścieżka kariery</div>
    <h2 class="text-headline-lg text-on-surface mb-xl">
      Doświadczenie <span class="text-neon">zawodowe</span>
    </h2>

    <!-- ─── WERSJA POZIOMA (desktop lg+) ─── -->
    <div class="hidden lg:block mb-xl">
      <div class="relative">
        <!-- Linia -->
        <div class="absolute top-5 left-0 right-0 h-px bg-neon/20"></div>
        <!-- Gradient najeżdżający z prawej -->
        <div class="absolute top-5 left-0 h-px bg-gradient-to-r from-neon/60 via-neon/20 to-transparent" style="width:100%"></div>

        <div class="grid grid-cols-5 gap-4 relative">
          {timeline.map((item, i) => (
            <div class="flex flex-col items-center text-center group">
              <!-- Dot -->
              <div class:list={[
                'w-10 h-10 rounded-full border-2 flex items-center justify-center mb-4 z-10 transition-all duration-300',
                item.current
                  ? 'bg-neon border-neon shadow-neon-sm'
                  : 'bg-[#050A07] border-neon/40 group-hover:border-neon',
              ]}>
                <span class:list={[
                  'material-symbols-outlined text-sm',
                  item.current ? 'text-on-primary' : 'text-neon/60 group-hover:text-neon',
                ]}>
                  {item.current ? 'star' : 'circle'}
                </span>
              </div>
              <!-- Period -->
              <span class="text-label-sm text-neon uppercase tracking-wider mb-2 leading-tight">{item.period}</span>
              <!-- Company -->
              <p class="text-label-md font-bold text-on-surface mb-1">{item.company}</p>
              <!-- Role -->
              <p class="text-label-sm text-on-surface-variant leading-snug">{item.role}</p>
              <!-- Tags -->
              <div class="flex flex-wrap justify-center gap-1 mt-2">
                {item.tags.map(tag => (
                  <span class="px-1.5 py-0.5 bg-surface-container border border-outline-variant text-[10px] text-on-surface-variant uppercase">{tag}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ─── WERSJA PIONOWA (wszystkie ekrany, ukryta na lg gdzie jest pozioma) ─── -->
    <div class="lg:hidden space-y-0">
      {timeline.map((item, i) => (
        <div class="flex gap-4 relative">
          <!-- Linia pionowa -->
          <div class="flex flex-col items-center">
            <div class:list={[
              'w-10 h-10 rounded-full border-2 flex items-center justify-center shrink-0 z-10',
              item.current ? 'bg-neon border-neon shadow-neon-sm' : 'bg-[#050A07] border-neon/40',
            ]}>
              <span class:list={['material-symbols-outlined text-sm', item.current ? 'text-on-primary' : 'text-neon/60']}>
                {item.current ? 'star' : 'circle'}
              </span>
            </div>
            {i < timeline.length - 1 && (
              <div class="w-px flex-1 bg-neon/20 my-1"></div>
            )}
          </div>
          <!-- Content -->
          <div class:list={['pb-8 flex-1', i === timeline.length - 1 ? 'pb-0' : '']}>
            <span class="text-label-sm text-neon uppercase tracking-widest">{item.period}</span>
            <h3 class="text-headline-md text-on-surface mt-1">{item.company}</h3>
            <p class:list={['text-label-md uppercase tracking-wider mb-2', item.current ? 'text-neon' : 'text-on-surface-variant']}>{item.role}</p>
            <p class="text-body-md text-on-surface-variant mb-2">{item.desc}</p>
            <div class="flex flex-wrap gap-1">
              {item.tags.map(tag => (
                <span class="px-2 py-0.5 bg-surface-container border border-outline-variant text-label-sm text-on-surface-variant uppercase">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA do modala -->
    <div class="mt-xl pt-lg border-t border-outline-variant/30 flex flex-col sm:flex-row items-center justify-between gap-md">
      <p class="text-body-md text-on-surface-variant max-w-md">
        6 lat, 3 firmy, jedna ścieżka — od kodu przez jakość po pełną strategię SEO i własne narzędzia.
      </p>
      <button
        id="open-career-modal"
        class="shrink-0 inline-flex items-center gap-2
               border border-neon/40 text-neon font-bold text-label-md uppercase tracking-widest
               px-lg py-md hover:bg-neon/10 hover:border-neon hover:shadow-neon-sm
               active:scale-95 transition-all duration-200 group"
      >
        <span class="material-symbols-outlined text-sm group-hover:rotate-90 transition-transform duration-300">add_circle</span>
        Sprawdź pełne doświadczenie
      </button>
    </div>
  </section>

  <!-- ═══════ MODAL KARIERY ═══════ -->
  <div
    id="career-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <!-- Backdrop -->
    <div id="modal-backdrop" class="absolute inset-0 bg-[#050A07]/95 backdrop-blur-md"></div>

    <!-- Panel -->
    <div class="relative z-10 w-full max-w-3xl max-h-[90vh] overflow-y-auto
                bg-[#080F09] border border-neon/20
                shadow-[0_0_60px_rgba(45,255,95,0.1)]">

      <!-- Header -->
      <div class="sticky top-0 z-20 flex items-center justify-between px-lg py-md
                  bg-[#080F09]/95 backdrop-blur-sm border-b border-neon/10">
        <div>
          <p class="text-label-sm text-neon uppercase tracking-widest mb-0.5">Krzysztof Parfieniuk</p>
          <h2 id="modal-title" class="text-headline-md text-on-surface">Pełna ścieżka kariery</h2>
        </div>
        <button
          id="close-career-modal"
          class="w-10 h-10 flex items-center justify-center border border-outline-variant
                 text-on-surface-variant hover:border-neon/40 hover:text-neon transition-all"
          aria-label="Zamknij"
        >
          <span class="material-symbols-outlined text-base">close</span>
        </button>
      </div>

      <!-- Neon accent line -->
      <div class="h-px bg-gradient-to-r from-neon via-neon/40 to-transparent"></div>

      <!-- Content -->
      <div class="px-lg py-xl space-y-0">

        <!-- Pozycja 5 — obecnie -->
        <div class="flex gap-6 relative">
          <div class="flex flex-col items-center shrink-0">
            <div class="w-10 h-10 rounded-full bg-neon border-2 border-neon shadow-neon-sm flex items-center justify-center z-10">
              <span class="material-symbols-outlined text-sm text-on-primary">star</span>
            </div>
            <div class="w-px flex-1 bg-neon/20 my-2"></div>
          </div>
          <div class="pb-10">
            <div class="flex flex-wrap items-center gap-2 mb-sm">
              <span class="text-label-sm text-neon uppercase tracking-widest font-bold">07.2024 – obecnie</span>
              <span class="px-2 py-0.5 bg-neon/10 border border-neon/30 text-label-sm text-neon uppercase">Aktualnie</span>
            </div>
            <h3 class="text-headline-md text-on-surface mb-xs">Ćwierkają.pl</h3>
            <p class="text-label-md text-neon uppercase tracking-wider mb-md">Senior SEO & MarTech Specialist — Freelancer B2B</p>
            <p class="text-body-md text-on-surface-variant mb-md leading-relaxed">
              Tu zaczęła się prawdziwa wolność — i największa odpowiedzialność. Jako B2B freelancer prowadzę kompleksowe projekty SEO: od audytu technicznego, przez strategię contentową, aż po link building i monitoring wyników. Ale to nie wszystko co mnie tutaj wyróżnia.
            </p>
            <p class="text-body-md text-on-surface-variant mb-md leading-relaxed">
              Zacząłem budować <strong class="text-on-surface">własne narzędzia SEO</strong> z pomocą Claude Code i platformy Antigravity — vibecoding skryptów, które automatyzują żmudne procesy analizy i crawlowania. Stworzyłem też <strong class="text-on-surface">zaawansowane automatyzacje w n8n</strong>, które dziś oszczędzają mi i moim klientom dziesiątki godzin miesięcznie.
            </p>
            <p class="text-body-md text-on-surface-variant mb-md leading-relaxed">
              Buduję zapleczy blogowe, piszę content z głową (NLP, silosy, encje), optymalizuję technicznie on-site i prowadzę kampanie link buildingowe. Nie jestem klasycznym freelancerem — jestem jednosobowym działem SEO + MarTech.
            </p>
            <div class="flex flex-wrap gap-1.5">
              {['SEO Strategy', 'Tech Audit', 'Link Building', 'n8n Automation', 'Vibe Coding', 'Claude Code', 'Content NLP', 'Zapleczy'].map(t => (
                <span class="px-2 py-0.5 bg-surface-container border border-neon/20 text-label-sm text-neon/80 uppercase">{t}</span>
              ))}
            </div>
          </div>
        </div>

        <!-- Pozycja 4 -->
        <div class="flex gap-6 relative">
          <div class="flex flex-col items-center shrink-0">
            <div class="w-10 h-10 rounded-full bg-[#050A07] border-2 border-neon/40 flex items-center justify-center z-10">
              <span class="material-symbols-outlined text-sm text-neon/60">circle</span>
            </div>
            <div class="w-px flex-1 bg-neon/20 my-2"></div>
          </div>
          <div class="pb-10">
            <span class="text-label-sm text-neon/70 uppercase tracking-widest font-bold">04.2024 – 06.2024</span>
            <h3 class="text-headline-md text-on-surface mt-1 mb-xs">Dynamic Solutions</h3>
            <p class="text-label-md text-on-surface-variant uppercase tracking-wider mb-md">Digital Marketing Specialist</p>
            <p class="text-body-md text-on-surface-variant mb-md leading-relaxed">
              Krótki, intensywny projekt przy starcie-upie StreamX.dev. Rola pełna przekrojowych zadań: SEO strategy od zera, audyt, analiza konkurencji i widoczności, optymalizacja on-page — ale też praca ramię w ramię z deweloperami przy testowaniu nowych komponentów i tworzeniu dokumentacji technicznej.
            </p>
            <p class="text-body-md text-on-surface-variant mb-md leading-relaxed">
              To doświadczenie pokazało mi jak ważna jest <strong class="text-on-surface">komunikacja między SEO a deveolpmentem</strong> — i jak pisać specyfikacje techniczne, które programiści faktycznie chcą czytać. Pisałem też przewodniki dla content kreatorów, które łączyły zasady NLP z praktyką pisarską.
            </p>
            <div class="flex flex-wrap gap-1.5">
              {['SEO Strategy', 'UX/UI Audit', 'Tech Docs', 'Content Guides', 'QA Testing'].map(t => (
                <span class="px-2 py-0.5 bg-surface-container border border-outline-variant text-label-sm text-on-surface-variant uppercase">{t}</span>
              ))}
            </div>
          </div>
        </div>

        <!-- Pozycja 3 -->
        <div class="flex gap-6 relative">
          <div class="flex flex-col items-center shrink-0">
            <div class="w-10 h-10 rounded-full bg-[#050A07] border-2 border-neon/40 flex items-center justify-center z-10">
              <span class="material-symbols-outlined text-sm text-neon/60">circle</span>
            </div>
            <div class="w-px flex-1 bg-neon/20 my-2"></div>
          </div>
          <div class="pb-10">
            <span class="text-label-sm text-neon/70 uppercase tracking-widest font-bold">06.2022 – 03.2024</span>
            <h3 class="text-headline-md text-on-surface mt-1 mb-xs">WENET</h3>
            <p class="text-label-md text-on-surface-variant uppercase tracking-wider mb-md">Specjalista ds. SEO</p>
            <p class="text-body-md text-on-surface-variant mb-md leading-relaxed">
              Tutaj nauczyłem się SEO w realiach agencyjnych — szybko, pod presją, z różnorodnymi klientami jednocześnie. Prowadziłem strategie pozycjonowania dla stron i sklepów internetowych, przeprowadzałem audyty, tworzyłem rekomendacje optymalizacyjne i link buildingowe.
            </p>
            <p class="text-body-md text-on-surface-variant mb-md leading-relaxed">
              Kluczowe było <strong class="text-on-surface">monitorowanie efektów i błyskawiczne reagowanie na spadki</strong> — czasem aktualizacja algorytmu potrafiła zrujnować miesiące pracy i trzeba było działać w godzinach, nie dniach. Nauczyłem się też jak skutecznie przekazywać rekomendacje SEO do innych działów: programistów, copywriterów, webdesignerów i opiekunów klienta.
            </p>
            <p class="text-body-md text-on-surface-variant mb-md leading-relaxed">
              To tutaj po raz pierwszy zarządzałem własnym portfelem klientów i rozumiałem co to znaczy być odpowiedzialnym za wyniki od A do Z.
            </p>
            <div class="flex flex-wrap gap-1.5">
              {['SEO Strategy', 'Audyt', 'Link Building', 'Keyword Research', 'Analiza Widoczności', 'Portfolio Klientów'].map(t => (
                <span class="px-2 py-0.5 bg-surface-container border border-outline-variant text-label-sm text-on-surface-variant uppercase">{t}</span>
              ))}
            </div>
          </div>
        </div>

        <!-- Pozycja 2 -->
        <div class="flex gap-6 relative">
          <div class="flex flex-col items-center shrink-0">
            <div class="w-10 h-10 rounded-full bg-[#050A07] border-2 border-neon/40 flex items-center justify-center z-10">
              <span class="material-symbols-outlined text-sm text-neon/60">circle</span>
            </div>
            <div class="w-px flex-1 bg-neon/20 my-2"></div>
          </div>
          <div class="pb-10">
