---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="O mnie — Specjalista SEO Krzysztof"
  description="Poznaj KrPage — specjalistę SEO z wieloletnim doświadczeniem w audytach technicznych, strategii pozycjonowania i content marketingu dla firm i e-commerce."
  schemaType="webpage"
>

  <!-- HERO -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl grid md:grid-cols-12 gap-lg items-center relative overflow-hidden">
    <div class="absolute -top-20 -left-20 w-[500px] h-[500px] bg-neon/5 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="md:col-span-7 z-10">
      <div class="section-label mb-md">System Identification: Specialist SEO</div>
      <h1 class="text-headline-xl text-on-surface mb-md">
        Architekt Cyfrowego<br />
        <span class="text-neon">Wzrostu.</span>
      </h1>
      <p class="text-body-lg text-on-surface-variant mb-lg max-w-2xl">
        Nazywam się Krzysztof, w świecie danych znany jako KrPage. Moja praca to fuzja analitycznej precyzji z wizjonerskim podejściem do SEO. Nie zgaduję — analizuję. Nie czekam na wyniki — optymalizuję pod konkretne KPI.
      </p>

      <!-- Stats mini bento -->
      <div class="grid grid-cols-2 gap-sm">
        {[
          { icon: 'show_chart', value: '8+',   label: 'Lat doświadczenia',       bar: 85 },
          { icon: 'groups',     value: '150+',  label: 'Zadowolonych klientów',   bar: 92 },
          { icon: 'trending_up',value: '320+',  label: 'Projektów SEO',           bar: 78 },
          { icon: 'emoji_events',value: 'TOP 3', label: 'Średnia pozycja klientów',bar: 95 },
        ].map(s => (
          <div class="bento-card p-md relative overflow-hidden group">
            <div class="absolute top-2 right-2 text-neon/20">
              <span class="material-symbols-outlined">{s.icon}</span>
            </div>
            <p class="text-headline-lg text-neon mb-0">{s.value}</p>
            <p class="text-label-sm text-on-surface-variant uppercase mb-sm">{s.label}</p>
            <div class="h-px w-full bg-surface-container-high mt-sm">
              <div class="h-full bg-neon" style={`width:${s.bar}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="md:col-span-5 relative">
      <div class="bento-card aspect-[3/4] overflow-hidden relative">
        <div class="absolute inset-0 bg-gradient-to-t from-[#050A07] via-transparent to-transparent z-10"></div>
        <div class="w-full h-full bg-surface-container-high flex items-center justify-center">
          <span class="material-symbols-outlined text-neon/20" style="font-size:120px">person</span>
        </div>
        <div class="absolute bottom-4 left-4 right-4 p-md bg-[#050A07]/80 backdrop-blur-md border border-neon/10 z-20">
          <p class="text-label-sm text-neon mb-1 uppercase tracking-widest">Current Status</p>
          <p class="text-body-md font-bold">Optimizing Global Reach</p>
        </div>
      </div>
    </div>
  </section>

  <!-- NARZĘDZIA -->
  <section class="bg-surface-container-low py-xl border-y border-white/5 relative overflow-hidden">
    <div class="absolute right-0 top-0 w-1/3 h-full bg-neon/3 blur-[100px] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
      <div class="flex flex-col md:flex-row justify-between items-end mb-lg gap-md">
        <div>
          <div class="section-label mb-sm">Digital Command Center</div>
          <h2 class="text-headline-lg text-on-surface">Narzędzia które<br /><span class="text-neon">dają przewagę</span></h2>
          <p class="text-body-md text-on-surface-variant max-w-xl mt-sm">
            Wykorzystuję najnowocześniejszy stack technologiczny do mapowania drogi na szczyt wyników Google.
          </p>
        </div>
        <span class="text-label-sm border border-neon/20 px-3 py-1 text-neon uppercase tracking-widest whitespace-nowrap">v2.4 Enterprise</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-sm">
        {[
          { icon: 'query_stats',  name: 'Google Analytics 4',  desc: 'Głęboka analiza behawioralna i atrybucja konwersji w czasie rzeczywistym.' },
          { icon: 'search_check', name: 'Search Console',       desc: 'Monitoring zdrowia domeny i precyzyjna diagnostyka widoczności organicznej.' },
          { icon: 'monitoring',   name: 'Ahrefs',               desc: 'Agresywna analiza konkurencji i inżynieria profilu linkowego.' },
          { icon: 'bug_report',   name: 'Screaming Frog',       desc: 'Techniczne audyty crawlerem w celu eliminacji błędów strukturalnych.' },
          { icon: 'bar_chart',    name: 'Senuto / Semstorm',    desc: 'Analiza widoczności, fraz kluczowych i pozycji w polskim ekosystemie.' },
          { icon: 'code',         name: 'LibreCrawl',           desc: 'Autorski crawler do zaawansowanej analizy struktury i linkowania wewnętrznego.' },
          { icon: 'table_chart',  name: 'Google Data Studio',   desc: 'Przejrzyste dashboardy i raporty dopasowane do potrzeb klienta.' },
          { icon: 'psychology',   name: 'SurferSEO',            desc: 'NLP-driven optymalizacja treści pod topical authority i semantykę.' },
        ].map(tool => (
          <div class="bento-card p-lg group hover:border-neon/40 transition-all">
            <div class="w-12 h-12 mb-md flex items-center justify-center bg-surface-container-highest border border-white/5 group-hover:border-neon/30 transition-all">
              <span class="material-symbols-outlined text-neon">{tool.icon}</span>
            </div>
            <h3 class="text-headline-md text-on-surface mb-sm">{tool.name}</h3>
            <p class="text-label-sm text-on-surface-variant leading-relaxed">{tool.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MISJA -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl">
    <div class="grid md:grid-cols-2 gap-lg items-center">
      <div class="order-2 md:order-1">
        <div class="bento-card p-xl border-l-4 border-neon">
          <span class="material-symbols-outlined text-neon text-4xl mb-md">radar</span>
          <h2 class="text-headline-xl text-on-surface mb-md">
            Misja:<br /><span class="text-neon">Precyzja Danych.</span>
          </h2>
          <p class="text-body-lg text-on-surface-variant italic mb-lg">
            „W erze informacyjnego szumu, tylko czyste dane i ich właściwa interpretacja stanowią realną przewagę rynkową. Moim celem jest przekuwanie chaosu w konkretne wyniki finansowe."
          </p>
          <div class="space-y-sm">
            {[
              'Zero tolerancji dla vanity metrics',
              'Skupienie na ROI i konwersji',
              'Transparentność każdego działania',
            ].map(item => (
              <div class="flex items-center gap-md">
                <span class="material-symbols-outlined text-neon text-sm">check_circle</span>
                <span class="text-label-md uppercase tracking-wider">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="order-1 md:order-2 grid grid-cols-2 gap-sm">
        {[
          { value: '100%', label: 'Accuracy',  big: false },
          { icon: 'rocket_launch', label: 'Scale Fast', big: true },
          { icon: 'database', label: 'Big Data', big: true },
          { value: '24/7', label: 'Monitoring', big: false },
        ].map(item => (
          <div class:list={['bento-card flex flex-col items-center justify-center', item.big ? 'h-48' : 'h-32']}>
            {item.value
              ? <p class="text-headline-lg text-neon">{item.value}</p>
              : <span class="material-symbols-outlined text-neon text-4xl mb-2">{item.icon}</span>
            }
            <p class="text-label-sm uppercase tracking-widest text-on-surface-variant">{item.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 pb-xl">
    <div class="bento-card p-xl flex flex-col items-center text-center relative overflow-hidden">
      <div class="absolute inset-0 opacity-5 pointer-events-none"
           style="background-image: linear-gradient(rgba(45,255,95,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(45,255,95,0.3) 1px, transparent 1px); background-size: 20px 20px;"></div>
      <div class="relative z-10">
        <h2 class="text-headline-xl text-on-surface mb-md">
          Gotowy na <span class="text-neon">nowy wymiar</span> wzrostu?
        </h2>
        <p class="text-body-lg text-on-surface-variant mb-lg max-w-2xl">
          Skontaktuj się, aby omówić audyt Twojej obecności w sieci i zaplanować strategię dominacji rynkowej.
        </p>
        <div class="flex flex-col sm:flex-row gap-md justify-center">
          <a href="/kontakt"
             class="inline-flex items-center justify-center gap-2 bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest px-xl py-md hover:brightness-110 active:scale-95 transition-all shadow-neon">
            <span class="material-symbols-outlined text-sm">calendar_month</span>
            Zacznij projekt
          </a>
          <a href="/uslugi"
             class="inline-flex items-center justify-center gap-2 border border-neon/30 text-neon font-bold text-label-md uppercase tracking-widest px-xl py-md hover:bg-neon/5 transition-all">
            Zobacz usługi
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
