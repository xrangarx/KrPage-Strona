---
import BaseLayout from '../../layouts/BaseLayout.astro'
import InlineEditor from '../../components/InlineEditor.astro'
import content from '../../data/pages/uslugi-audyt-seo.json'

const { scanMetrics, techItems, intelTags, problems } = content
---

<BaseLayout
  title="Audyt SEO — Kompleksowa Analiza Techniczna Strony"
  description="Profesjonalny audyt SEO: analiza techniczna, Core Web Vitals, indeksowanie, profil linkowy i keyword research."
  schemaType="service"
  schemaProps={{ serviceName: 'Audyt Techniczny SEO' }}
>

  <!-- HERO -->
  <section class="relative min-h-[70vh] flex items-center overflow-hidden border-b border-white/5">
    <div class="absolute inset-0 bg-gradient-to-b from-surface/80 via-transparent to-surface/80 z-0"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 py-24 grid lg:grid-cols-2 gap-12 items-center w-full">
      <div class="space-y-6">
        <div class="section-label" data-cms="heroEyebrow">{content.heroEyebrow}</div>
        <h1 class="text-headline-xl text-on-surface">
          <span data-cms="heroTitleL1">{content.heroTitleL1}</span><br />
          <span class="text-neon" data-cms="heroTitleAccent">{content.heroTitleAccent}</span>
        </h1>
        <p class="text-body-lg text-on-surface-variant max-w-xl" data-cms="heroDesc">
          {content.heroDesc}
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/kontakt"
             class="inline-flex items-center gap-2 bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest px-lg py-md hover:brightness-110 active:scale-95 transition-all shadow-neon-sm">
            <span data-cms="heroBtnPrimary">{content.heroBtnPrimary}</span>
          </a>
          <a href="#zakres"
             class="inline-flex items-center gap-2 border border-neon/30 text-neon font-bold text-label-md uppercase tracking-widest px-lg py-md hover:bg-neon/5 transition-all">
            <span data-cms="heroBtnSecondary">{content.heroBtnSecondary}</span>
            <span aria-hidden="true" class="material-symbols-outlined text-sm">arrow_downward</span>
          </a>
        </div>
      </div>

      <!-- Live scan widget -->
      <div class="hidden lg:block">
        <div class="bento-card p-lg relative">
          <div class="flex justify-between items-center mb-lg">
            <span class="text-label-md text-neon uppercase tracking-widest" data-cms="scanLabel">{content.scanLabel}</span>
            <span aria-hidden="true" class="material-symbols-outlined text-neon animate-spin text-sm">refresh</span>
          </div>
          <div class="h-1.5 bg-surface-container-highest overflow-hidden mb-lg">
            <div class="h-full bg-neon w-3/4 shadow-neon-sm"></div>
          </div>
          <div class="grid grid-cols-3 gap-4 mb-lg">
            {scanMetrics.map((m, i) => (
              <div class="bg-surface-container p-4 text-center border border-outline-variant">
                <p class="text-headline-md text-neon" data-cms={`scanMetrics.${i}.val`}>{m.val}</p>
                <p class="text-label-sm text-on-surface-variant uppercase" data-cms={`scanMetrics.${i}.label`}>{m.label}</p>
              </div>
            ))}
          </div>
          <div class="font-mono text-xs text-on-surface-variant/50 space-y-1">
            <div>[SYSTEM] FETCHING /API/CORE_VITALS</div>
            <div class="text-neon">[SUCCESS] LCP 0.4s — EXCELLENT</div>
            <div>[SYSTEM] SCANNING DOM STRUCTURE...</div>
            <div class="text-neon">[STATUS] SEO-FRIENDLY <span class="animate-pulse">█</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ZAKRES AUDYTU -->
  <section id="zakres" class="max-w-7xl mx-auto px-6 md:px-12 py-xl">
    <div class="mb-lg">
      <div class="section-label mb-sm" data-cms="zakresEyebrow">{content.zakresEyebrow}</div>
      <h2 class="text-headline-lg text-on-surface">
        <span data-cms="zakresTitleL1">{content.zakresTitleL1}</span><br /><span class="text-neon" data-cms="zakresTitleAccent">{content.zakresTitleAccent}</span>
      </h2>
      <p class="text-body-md text-on-surface-variant max-w-2xl mt-sm" data-cms="zakresDesc">
        {content.zakresDesc}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <!-- Big card -->
      <div class="md:col-span-8 bento-card p-lg relative overflow-hidden">
        <div class="relative z-10 flex flex-col md:flex-row gap-lg">
          <div class="md:w-1/2">
            <span aria-hidden="true" class="material-symbols-outlined text-neon text-4xl mb-md">settings_ethernet</span>
            <h3 class="text-headline-md text-on-surface mb-sm" data-cms="blockTechTitle">{content.blockTechTitle}</h3>
            <p class="text-body-md text-on-surface-variant mb-md" data-cms="blockTechDesc">
              {content.blockTechDesc}
            </p>
            <ul class="space-y-2 text-label-sm text-on-surface uppercase tracking-wider">
              {techItems.map((item, i) => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-neon flex-shrink-0"></span><span data-cms={`techItems.${i}`}>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="md:w-1/2 bg-surface-container-highest/50 p-md border border-outline-variant font-mono text-xs text-on-surface-variant/50 space-y-2">
            <div class="text-neon text-label-sm mb-2">Crawling Logs</div>
            <div>[SYSTEM] FETCHING /API/CORE_VITALS</div>
            <div class="text-neon">[SUCCESS] LCP 0.4s — EXCELLENT</div>
            <div>[SYSTEM] SCANNING DOM STRUCTURE...</div>
            <div>[INFO] 4,203 NODES ANALYZED</div>
            <div class="text-neon">[STATUS] SEO-FRIENDLY</div>
            <div>[LINK] 847 INTERNAL LINKS MAPPED</div>
          </div>
        </div>
      </div>

      <div class="md:col-span-4 bento-card p-lg flex flex-col justify-between group hover:border-neon/40 transition-all">
        <div>
          <span aria-hidden="true" class="material-symbols-outlined text-neon text-4xl mb-md">key</span>
          <h3 class="text-headline-md text-on-surface mb-sm" data-cms="blockKeywordTitle">{content.blockKeywordTitle}</h3>
        </div>
        <p class="text-body-md text-on-surface-variant" data-cms="blockKeywordDesc">
          {content.blockKeywordDesc}
        </p>
      </div>

      <div class="md:col-span-5 bento-card p-lg flex flex-col justify-between group hover:border-neon/40 transition-all">
        <div>
          <span aria-hidden="true" class="material-symbols-outlined text-neon text-4xl mb-md">psychology_alt</span>
          <h3 class="text-headline-md text-on-surface mb-sm" data-cms="blockUxTitle">{content.blockUxTitle}</h3>
        </div>
        <p class="text-body-md text-on-surface-variant" data-cms="blockUxDesc">
          {content.blockUxDesc}
        </p>
      </div>

      <div class="md:col-span-7 bento-card p-lg relative overflow-hidden">
        <div class="absolute right-0 bottom-0 text-neon/5">
          <span aria-hidden="true" class="material-symbols-outlined" style="font-size:180px">monitoring</span>
        </div>
        <div class="relative z-10">
          <h3 class="text-headline-md text-on-surface mb-sm" data-cms="blockIntelTitle">{content.blockIntelTitle}</h3>
          <p class="text-body-md text-on-surface-variant mb-md max-w-md" data-cms="blockIntelDesc">
            {content.blockIntelDesc}
          </p>
          <div class="flex flex-wrap gap-2">
            {intelTags.map((tag, i) => (
              <span class="px-3 py-1 bg-surface-container text-label-sm text-on-surface-variant uppercase border border-outline-variant" data-cms={`intelTags.${i}`}>{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEMY KRYTYCZNE -->
  <section class="bg-surface-container-low border-y border-white/5 py-xl">
    <div class="max-w-7xl mx-auto px-6 md:px-12 grid lg:grid-cols-2 gap-lg items-center">
      <div>
        <div class="section-label mb-sm" data-cms="problemsEyebrow">{content.problemsEyebrow}</div>
        <h2 class="text-headline-lg text-on-surface mb-md">
          <span data-cms="problemsTitleL1">{content.problemsTitleL1}</span> <span class="text-neon" data-cms="problemsTitleAccent">{content.problemsTitleAccent}</span>
        </h2>
        <p class="text-body-lg text-on-surface-variant mb-lg" data-cms="problemsIntro">
          {content.problemsIntro}
        </p>
        <div class="space-y-md">
          {problems.map((p, i) => (
            <div class="flex gap-md p-md bg-surface border-l-4 border-neon">
              <span aria-hidden="true" class="material-symbols-outlined text-neon">{p.icon}</span>
              <div>
                <h4 class="text-on-surface text-headline-md mb-1" data-cms={`problems.${i}.title`}>{p.title}</h4>
                <p class="text-on-surface-variant text-body-md" data-cms={`problems.${i}.desc`}>{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Contact form teaser -->
      <div class="bento-card p-lg relative">
        <div class="absolute -top-3 -right-3 bg-neon text-on-primary px-3 py-1 text-label-sm font-bold">BEZPŁATNY</div>
        <h3 class="text-headline-md text-on-surface mb-lg" data-cms="formTitle">{content.formTitle}</h3>
        <div class="space-y-md">
          <div>
            <label class="block text-label-sm text-on-surface-variant uppercase mb-2" data-cms="formUrlLabel">{content.formUrlLabel}</label>
            <div class="w-full bg-surface-container border border-outline-variant p-md text-on-surface-variant text-body-md" data-cms="formUrlPlaceholder">
              {content.formUrlPlaceholder}
            </div>
          </div>
          <p class="text-body-md text-on-surface-variant" data-cms="formDesc">
            {content.formDesc}
          </p>
          <a href="/kontakt"
             class="flex items-center justify-center gap-2 w-full bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest py-md hover:brightness-110 transition-all active:scale-95 shadow-neon-sm">
            <span aria-hidden="true" class="material-symbols-outlined text-sm">troubleshoot</span>
            <span data-cms="formBtn">{content.formBtn}</span>
          </a>
          <p class="text-label-sm text-center text-on-surface-variant/50 uppercase" data-cms="formNote">{content.formNote}</p>
        </div>
      </div>
    </div>
  </section>

  <InlineEditor contentPath="src/data/pages/uslugi-audyt-seo.json" />

</BaseLayout>
