---
import BaseLayout from '../../layouts/BaseLayout.astro'
import InlineEditor from '../../components/InlineEditor.astro'
import content from '../../data/pages/uslugi-content-marketing.json'

const { types, steps, stats } = content
---

<BaseLayout
  title="Content Marketing SEO — Treści które Pozycjonują"
  description="SEO content marketing: strategia treści oparta o topical authority, silosy tematyczne i optymalizację NLP. Tworzymy treści, które rankują i konwertują."
  schemaType="service"
  schemaProps={{ serviceName: 'Content Marketing SEO' }}
>

  <!-- HERO -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 pt-16 pb-xl relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-64 bg-neon/4 blur-[120px] pointer-events-none"></div>
    <div class="text-center relative z-10 mb-xl">
      <div class="section-label mx-auto mb-md" data-cms="heroEyebrow">{content.heroEyebrow}</div>
      <h1 class="text-headline-xl text-on-surface mb-md">
        <span data-cms="heroTitleL1">{content.heroTitleL1}</span><br /><span class="text-neon" data-cms="heroTitleAccent">{content.heroTitleAccent}</span>
      </h1>
      <p class="text-body-lg text-on-surface-variant max-w-2xl mx-auto" data-cms="heroDesc">
        {content.heroDesc}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
      {types.map((type, i) => (
        <div class="bento-card p-lg group hover:border-neon/40 transition-all">
          <span aria-hidden="true" class="material-symbols-outlined text-neon text-3xl mb-md">{type.icon}</span>
          <h3 class="text-headline-md text-on-surface mb-sm" data-cms={`types.${i}.title`}>{type.title}</h3>
          <p class="text-body-md text-on-surface-variant" data-cms={`types.${i}.desc`}>{type.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- METODOLOGIA -->
  <section class="bg-surface-container-low border-y border-white/5 py-xl">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="grid lg:grid-cols-2 gap-xl items-center">
        <div>
          <div class="section-label mb-sm" data-cms="processEyebrow">{content.processEyebrow}</div>
          <h2 class="text-headline-lg text-on-surface mb-lg">
            <span data-cms="processTitleL1">{content.processTitleL1}</span><br /><span class="text-neon" data-cms="processTitleAccent">{content.processTitleAccent}</span>
          </h2>
          <div class="space-y-md">
            {steps.map((step, i) => (
              <div class:list={['flex gap-md p-md border-l-2', i === 0 ? 'border-neon bg-neon/5' : 'border-outline-variant']}>
                <span class:list={['text-headline-md font-black opacity-40 shrink-0', i === 0 ? 'text-neon' : 'text-on-surface-variant']}>{step.n}</span>
                <div>
                  <p class="text-label-md uppercase tracking-wider text-on-surface font-bold mb-1" data-cms={`steps.${i}.title`}>{step.title}</p>
                  <p class="text-body-md text-on-surface-variant" data-cms={`steps.${i}.desc`}>{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-2 gap-sm">
          {stats.map((s, i) => (
            <div class="bento-card p-lg flex flex-col justify-between">
              <p class="text-headline-lg text-neon font-black" data-cms={`stats.${i}.value`}>{s.value}</p>
              <p class="text-label-sm text-on-surface-variant uppercase leading-relaxed mt-sm" data-cms={`stats.${i}.label`}>{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl">
    <div class="bento-card p-xl text-center relative overflow-hidden">
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="w-[500px] h-48 bg-neon/5 blur-[100px] rounded-full"></div>
      </div>
      <div class="relative z-10">
        <div class="section-label mx-auto mb-md" data-cms="ctaEyebrow">{content.ctaEyebrow}</div>
        <h2 class="text-headline-lg text-on-surface mb-md">
          <span data-cms="ctaTitleL1">{content.ctaTitleL1}</span><br /><span class="text-neon" data-cms="ctaTitleAccent">{content.ctaTitleAccent}</span>
        </h2>
        <p class="text-body-lg text-on-surface-variant max-w-xl mx-auto mb-lg" data-cms="ctaDesc">
          {content.ctaDesc}
        </p>
        <div class="flex flex-col sm:flex-row gap-md justify-center">
          <a href="/kontakt"
             class="inline-flex items-center justify-center gap-2 bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest px-xl py-md hover:brightness-110 active:scale-95 transition-all shadow-neon">
            <span aria-hidden="true" class="material-symbols-outlined text-sm">calendar_month</span>
            <span data-cms="ctaBtnPrimary">{content.ctaBtnPrimary}</span>
          </a>
          <a href="/uslugi/audyt-seo"
             class="inline-flex items-center justify-center gap-2 border border-neon/30 text-neon font-bold text-label-md uppercase tracking-widest px-xl py-md hover:bg-neon/5 transition-all">
            <span data-cms="ctaBtnSecondary">{content.ctaBtnSecondary}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <InlineEditor contentPath="src/data/pages/uslugi-content-marketing.json" />

</BaseLayout>
