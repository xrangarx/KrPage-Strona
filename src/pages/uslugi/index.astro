---
import BaseLayout from '../../layouts/BaseLayout.astro'
import InlineEditor from '../../components/InlineEditor.astro'
import content from '../../data/pages/uslugi-index.json'

const { serviceGroups, steps } = content
---

<BaseLayout
  title="Usługi SEO — Pozycjonowanie, Audyt, Konsultacje | KrPage"
  description="Kompleksowe usługi SEO: pozycjonowanie stron, sklepów i lokalnych firm, audyty techniczne, konsultacje SEO i tworzenie stron. Zamów bezpłatną konsultację."
  schemaType="webpage"
>

  <!-- HERO -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 pt-16 pb-xl relative overflow-hidden">
    <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[600px] h-64 bg-neon/5 blur-[100px] rounded-full pointer-events-none"></div>
    <div class="text-center relative z-10 mb-xl">
      <div class="section-label mx-auto mb-md" data-cms="heroEyebrow">{content.heroEyebrow}</div>
      <h1 class="text-headline-xl text-on-surface mb-md">
        <span data-cms="heroTitleL1">{content.heroTitleL1}</span> <span class="text-neon" data-cms="heroTitleAccent">{content.heroTitleAccent}</span>
      </h1>
      <p class="text-body-lg text-on-surface-variant max-w-2xl mx-auto" data-cms="heroDesc">
        {content.heroDesc}
      </p>
    </div>

    <!-- Services grouped grid -->
    {serviceGroups.map((group, gi) => (
      <div class="mb-xl last:mb-0">
        <div class="flex items-center gap-4 mb-lg">
          <div class="section-label" data-cms={`serviceGroups.${gi}.heading`}>{group.heading}</div>
          <div class="flex-1 h-px bg-neon/10"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
          {group.services.map((s, si) => (
            <div class:list={['bento-card p-lg flex flex-col relative overflow-hidden group', s.highlight && 'border-neon/30']}>
              {s.highlight && (
                <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-neon to-transparent"></div>
              )}
              <div class="absolute top-0 right-0 p-4 text-neon/10 group-hover:text-neon/20 transition-colors">
                <span aria-hidden="true" class="material-symbols-outlined text-6xl">{s.icon}</span>
              </div>
              <div class="relative z-10 flex flex-col flex-1">
                <h2 class="text-headline-md text-on-surface mb-sm" data-cms={`serviceGroups.${gi}.services.${si}.title`}>{s.title}</h2>
                <p class="text-body-md text-on-surface-variant mb-md flex-1" data-cms={`serviceGroups.${gi}.services.${si}.desc`}>{s.desc}</p>
                <div class="flex flex-wrap gap-2 mb-md">
                  {s.tags.map(tag => (
                    <span class="px-2 py-0.5 bg-surface-container-highest border border-outline-variant text-label-sm text-on-surface-variant uppercase">{tag}</span>
                  ))}
                </div>
                <a href={s.href}
                   class="inline-flex items-center gap-2 text-neon text-label-md uppercase tracking-widest group-hover:gap-4 transition-all self-start">
                  Szczegóły
                  <span aria-hidden="true" class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- PROCES -->
  <section class="bg-surface-container-low border-y border-white/5 py-xl">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="section-label mb-sm" data-cms="procesEyebrow">{content.procesEyebrow}</div>
      <h2 class="text-headline-lg text-on-surface mb-lg" data-cms="procesTitle">{content.procesTitle}</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter">
        {steps.map((step, i) => (
          <div class="relative">
            <div class:list={['bento-card p-lg border-t-2', i === 0 ? 'border-neon' : 'border-outline-variant']}>
              <div class="flex items-start justify-between mb-md">
                <span class="text-headline-lg font-black text-neon/30">{step.n}</span>
                <span aria-hidden="true" class="material-symbols-outlined text-neon">{step.icon}</span>
              </div>
              <h3 class="text-headline-md text-on-surface mb-sm" data-cms={`steps.${i}.title`}>{step.title}</h3>
              <p class="text-body-md text-on-surface-variant" data-cms={`steps.${i}.desc`}>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl">
    <div class="bento-card p-xl text-center relative overflow-hidden">
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="w-96 h-48 bg-neon/5 blur-[80px] rounded-full"></div>
      </div>
      <div class="relative z-10">
        <h2 class="text-headline-lg text-on-surface mb-md">
          <span data-cms="ctaTitleL1">{content.ctaTitleL1}</span><br />
          <span class="text-neon" data-cms="ctaTitleAccent">{content.ctaTitleAccent}</span>
        </h2>
        <p class="text-body-lg text-on-surface-variant max-w-xl mx-auto mb-lg" data-cms="ctaDesc">
          {content.ctaDesc}
        </p>
        <a href="/kontakt"
           class="inline-flex items-center gap-2 bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest px-xl py-md hover:brightness-110 active:scale-95 transition-all shadow-neon">
          <span aria-hidden="true" class="material-symbols-outlined text-sm">troubleshoot</span>
          <span data-cms="ctaBtn">{content.ctaBtn}</span>
        </a>
      </div>
    </div>
  </section>

  <InlineEditor contentPath="src/data/pages/uslugi-index.json" />

</BaseLayout>
