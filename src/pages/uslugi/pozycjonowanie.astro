---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Pozycjonowanie Stron Internetowych — SEO dla Firm"
  description="Profesjonalne pozycjonowanie stron w Google. Strategia oparta o analizę konkurencji, topical authority i link building. Sprawdź jak zwiększamy widoczność organiczną."
  schemaType="service"
  schemaProps={{ serviceName: 'Pozycjonowanie Stron Internetowych' }}
>

  <!-- HERO -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 pt-16 pb-xl relative overflow-hidden">
    <div class="absolute -top-32 -right-32 w-[500px] h-[500px] bg-neon/5 blur-[120px] rounded-full pointer-events-none"></div>
    <div class="grid lg:grid-cols-2 gap-lg items-center">
      <div class="space-y-6 z-10">
        <div class="section-label">Strategia organiczna</div>
        <h1 class="text-headline-xl text-on-surface">
          Pozycjonowanie<br />
          <span class="text-neon">które zostaje</span>
        </h1>
        <p class="text-body-lg text-on-surface-variant max-w-xl">
          Budujemy długofalową widoczność opartą o autorytet tematyczny, a nie chwilowe sztuczki. Wyniki, które rosną miesiąc po miesiącu.
        </p>
        <div class="flex flex-wrap gap-md">
          <a href="/kontakt"
             class="inline-flex items-center gap-2 bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest px-lg py-md hover:brightness-110 active:scale-95 transition-all shadow-neon-sm">
            Umów konsultację
          </a>
          <a href="/uslugi/audyt-seo"
             class="inline-flex items-center gap-2 border border-neon/30 text-neon font-bold text-label-md uppercase tracking-widest px-lg py-md hover:bg-neon/5 transition-all">
            Najpierw audyt
          </a>
        </div>
      </div>

      <!-- Ranking widget -->
      <div class="bento-card p-lg">
        <div class="text-label-sm text-neon uppercase tracking-widest mb-md">Ranking Progress — Live</div>
        <div class="space-y-3">
          {[
            { phrase: 'audyt seo białystok',     pos: 1,  change: '+12' },
            { phrase: 'pozycjonowanie sklep',    pos: 2,  change: '+8'  },
            { phrase: 'seo techniczne firma',    pos: 3,  change: '+15' },
            { phrase: 'content marketing seo',  pos: 5,  change: '+6'  },
            { phrase: 'agencja seo podlaskie',   pos: 7,  change: '+21' },
          ].map(r => (
            <div class="flex items-center justify-between py-2 border-b border-outline-variant/30">
              <span class="text-body-md text-on-surface-variant font-mono text-xs">{r.phrase}</span>
              <div class="flex items-center gap-3">
                <span class="text-neon font-bold text-label-md">#{r.pos}</span>
                <span class="text-neon/60 text-label-sm">{r.change}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CO OBEJMUJE -->
  <section class="bg-surface-container-low border-y border-white/5 py-xl">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="section-label mb-sm">Zakres działań</div>
      <h2 class="text-headline-lg text-on-surface mb-lg">Co wchodzi w skład<br /><span class="text-neon">pozycjonowania</span></h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
        {[
          { icon: 'map',           title: 'Keyword Mapping',       desc: 'Mapowanie fraz kluczowych na strony docelowe. Każda podstrona atakuje konkretne zapytania z określoną intencją.' },
          { icon: 'hub',           title: 'Linkowanie Wewnętrzne', desc: 'Architektura silosów tematycznych — przepływ autorytetu tam, gdzie ma generować wyniki.' },
          { icon: 'link',          title: 'Link Building',         desc: 'Pozyskiwanie wartościowych backlinków z domenami o wysokim autorytecie. Zero farm i PBN.' },
          { icon: 'psychology',    title: 'Topical Authority',     desc: 'Budowa pozycji eksperta w niszy przez systematyczne pokrywanie tematów i pytań użytkowników.' },
          { icon: 'manage_search', title: 'Monitoring Pozycji',    desc: 'Codzienny tracking fraz z alertami dla istotnych zmian. Reagujemy zanim Google Cię wyprzedzi.' },
          { icon: 'bar_chart_4_bars', title: 'Miesięczne Raporty', desc: 'Przejrzyste raporty z danymi, które mają znaczenie dla Twojego biznesu — nie dla naszego ego.' },
        ].map(item => (
          <div class="bento-card p-lg group hover:border-neon/40 transition-all">
            <span class="material-symbols-outlined text-neon text-3xl mb-md">{item.icon}</span>
            <h3 class="text-headline-md text-on-surface mb-sm">{item.title}</h3>
            <p class="text-body-md text-on-surface-variant">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WYNIKI -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl">
    <div class="section-label mb-sm">Rezultaty</div>
    <h2 class="text-headline-lg text-on-surface mb-lg">Przykładowe <span class="text-neon">wyniki</span></h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter mb-xl">
      {[
        { cat: 'E-commerce',  result: '+318% ruchu', period: '6 miesięcy',  desc: 'Sklep z elektroniką. Przebudowa architektury kategorii + content + link building.' },
        { cat: 'Usługi B2B',  result: 'Top 3 / 47 fraz', period: '4 miesiące', desc: 'Firma consultingowa. Topical authority w wąskiej niszy B2B.' },
        { cat: 'Local SEO',   result: '+520% w Maps', period: '3 miesiące',  desc: 'Sieć gabinetów medycznych. GMB + lokalne silosy treści.' },
      ].map(cs => (
        <div class="bento-card p-lg flex flex-col gap-sm">
          <span class="text-label-sm font-mono text-neon/50 uppercase">{cs.cat}</span>
          <p class="text-headline-md text-neon font-black">{cs.result}</p>
          <p class="text-label-sm text-on-surface-variant uppercase">{cs.period}</p>
          <div class="w-full h-px bg-neon/10"></div>
          <p class="text-body-md text-on-surface-variant">{cs.desc}</p>
        </div>
      ))}
    </div>

    <div class="bento-card p-xl text-center relative overflow-hidden">
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="w-96 h-48 bg-neon/5 blur-[80px] rounded-full"></div>
      </div>
      <div class="relative z-10">
        <h2 class="text-headline-lg text-on-surface mb-md">
          Twoja strona może być następna.<br />
          <span class="text-neon">Zacznij od bezpłatnej analizy.</span>
        </h2>
        <a href="/kontakt"
           class="inline-flex items-center gap-2 bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest px-xl py-md hover:brightness-110 active:scale-95 transition-all shadow-neon mt-md">
          <span class="material-symbols-outlined text-sm">calendar_month</span>
          Umów bezpłatną konsultację
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
