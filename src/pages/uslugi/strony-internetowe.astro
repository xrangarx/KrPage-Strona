---
import BaseLayout from '../../layouts/BaseLayout.astro'
import InlineEditor from '../../components/InlineEditor.astro'
import content from '../../data/pages/uslugi-strony-internetowe.json'

const { cwv, items, stack } = content
---

<BaseLayout
  title="Strony Internetowe — Projektowanie i Tworzenie z SEO | KrPage"
  description="Tworzenie stron internetowych zoptymalizowanych pod SEO od podstaw. Nowoczesny stos technologiczny, błyskawiczne ładowanie, Core Web Vitals w normie."
  schemaType="service"
  schemaProps={{ serviceName: 'Strony Internetowe' }}
>

  <!-- HERO -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 pt-16 pb-xl relative overflow-hidden">
    <div class="absolute -top-32 -right-32 w-[500px] h-[500px] bg-neon/5 blur-[120px] rounded-full pointer-events-none"></div>
    <div class="grid lg:grid-cols-2 gap-lg items-center">
      <div class="space-y-6 z-10">
        <div class="section-label" data-cms="heroEyebrow">{content.heroEyebrow}</div>
        <h1 class="text-headline-xl text-on-surface">
          <span data-cms="heroTitleL1">{content.heroTitleL1}</span><br />
          <span class="text-neon" data-cms="heroTitleAccent">{content.heroTitleAccent}</span>
        </h1>
        <p class="text-body-lg text-on-surface-variant max-w-xl" data-cms="heroDesc">
          {content.heroDesc}
        </p>
        <div class="flex flex-wrap gap-md">
          <a href="/kontakt"
             class="inline-flex items-center gap-2 bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest px-lg py-md hover:brightness-110 active:scale-95 transition-all shadow-neon-sm">
            <span aria-hidden="true" class="material-symbols-outlined text-sm">calendar_month</span>
            <span data-cms="heroBtn">{content.heroBtn}</span>
          </a>
        </div>
      </div>

      <div class="bento-card p-lg">
        <div class="text-label-sm text-neon uppercase tracking-widest mb-md" data-cms="cwvLabel">{content.cwvLabel}</div>
        <div class="space-y-4">
          {cwv.map((m, i) => (
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-label-sm text-on-surface-variant" data-cms={`cwv.${i}.metric`}>{m.metric}</span>
                <span class="text-label-sm text-neon font-bold" data-cms={`cwv.${i}.value`}>{m.value}</span>
              </div>
              <div class="h-1.5 bg-outline-variant/20 rounded-full overflow-hidden">
                <div class="h-full bg-neon rounded-full shadow-neon-sm" style={`width: ${m.pct}%`}></div>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-md pt-md border-t border-outline-variant/30 flex items-center gap-2">
          <span aria-hidden="true" class="material-symbols-outlined text-neon text-sm">verified</span>
          <span class="text-label-sm text-on-surface-variant"><span data-cms="lighthouseLabel">{content.lighthouseLabel}</span> <strong class="text-neon" data-cms="lighthouseValue">{content.lighthouseValue}</strong></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ZAKRES -->
  <section class="bg-surface-container-low border-y border-white/5 py-xl">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="section-label mb-sm" data-cms="zakresEyebrow">{content.zakresEyebrow}</div>
      <h2 class="text-headline-lg text-on-surface mb-lg"><span data-cms="zakresTitleL1">{content.zakresTitleL1}</span><br /><span class="text-neon" data-cms="zakresTitleAccent">{content.zakresTitleAccent}</span></h2>
      <p class="text-body-md text-on-surface-variant max-w-2xl mb-lg" data-cms="zakresDesc">
        {content.zakresDesc}
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
        {items.map((item, i) => (
          <div class="bento-card p-lg group hover:border-neon/40 transition-all">
            <span aria-hidden="true" class="material-symbols-outlined text-neon text-3xl mb-md">{item.icon}</span>
            <h3 class="text-headline-md text-on-surface mb-sm" data-cms={`items.${i}.title`}>{item.title}</h3>
            <p class="text-body-md text-on-surface-variant" data-cms={`items.${i}.desc`}>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STACK + CTA -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-xl">
    <div class="section-label mb-sm" data-cms="techEyebrow">{content.techEyebrow}</div>
    <h2 class="text-headline-lg text-on-surface mb-lg"><span data-cms="techTitleL1">{content.techTitleL1}</span> <span class="text-neon" data-cms="techTitleAccent">{content.techTitleAccent}</span></h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-gutter mb-xl">
      {stack.map((t, i) => (
        <div class="bento-card p-lg flex flex-col items-center text-center hover:border-neon/40 transition-all">
          <span aria-hidden="true" class="material-symbols-outlined text-neon text-3xl mb-sm">{t.icon}</span>
          <p class="text-label-md text-on-surface uppercase tracking-widest" data-cms={`stack.${i}.label`}>{t.label}</p>
        </div>
      ))}
    </div>

    <div class="bento-card p-xl text-center relative overflow-hidden">
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="w-96 h-48 bg-neon/5 blur-[80px] rounded-full"></div>
      </div>
      <div class="relative z-10">
        <h2 class="text-headline-lg text-on-surface mb-md">
          <span data-cms="ctaTitleL1">{content.ctaTitleL1}</span><br />
          <span class="text-neon" data-cms="ctaTitleAccent">{content.ctaTitleAccent}</span>
        </h2>
        <a href="/kontakt"
           class="inline-flex items-center gap-2 bg-neon text-on-primary font-bold text-label-md uppercase tracking-widest px-xl py-md hover:brightness-110 active:scale-95 transition-all shadow-neon mt-md">
          <span aria-hidden="true" class="material-symbols-outlined text-sm">calendar_month</span>
          <span data-cms="ctaBtn">{content.ctaBtn}</span>
        </a>
      </div>
    </div>
  </section>

  <InlineEditor contentPath="src/data/pages/uslugi-strony-internetowe.json" />

</BaseLayout>
